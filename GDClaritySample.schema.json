{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rsadi/gd/v1/GDClaritySample.schema.json",
  "title": "GDClaritySample",
  "type": "object",
  "required": ["sample_id", "timestamp", "position", "clarity_score"],
  "properties": {
    "sample_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "clarity_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stress_hint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
