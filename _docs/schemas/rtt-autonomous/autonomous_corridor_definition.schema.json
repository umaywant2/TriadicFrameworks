{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_corridor_definition.schema.json",
  "title": "autonomous_corridor_definition",
  "type": "object",
  "required": ["corridor_id", "volume_m", "time_window"],
  "properties": {
    "corridor_id": { "type": "string" },

    "volume_m": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "array",
          "items": { "type": "number" }
        },
        "max": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },

    "time_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },

    "rtt_overlay": {
      "type": "object",
      "properties": {
        "clarity_profile": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "clarity_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

