{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "AI Drift Vector",
  "type": "object",
  "properties": {
    "vector_id": { "type": "string" },
    "model_id": { "type": "string" },
    "semantic_shift": { "type": "number" },
    "behavioral_shift": { "type": "number" },
    "triadic_shift": {
      "type": "object",
      "properties": {
        "spin_delta": { "type": "number" },
        "charge_delta": { "type": "number" },
        "temperature_delta": { "type": "number" }
      }
    }
  }
}
