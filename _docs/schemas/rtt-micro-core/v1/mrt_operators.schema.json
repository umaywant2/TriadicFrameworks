{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-micro-core/v1/mrt_operators.schema.json",
  "title": "mrt_operators",
  "type": "object",
  "properties": {
    "omega_mu": {
      "type": "object",
      "description": "Ωμ — micro-oscillation",
      "properties": {
        "dimension": { "type": "number" },
        "frequency_hz": { "type": "number" },
        "duty_cycle": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "phi_mu": {
      "type": "object",
      "description": "Φμ — micro-phase alignment",
      "properties": {
        "source_dimension": { "type": "number" },
        "target_dimension": { "type": "number" },
        "phase_offset_rad": { "type": "number" }
      }
    },
    "f_mu": {
      "type": "object",
      "description": "Fμ — micro-flow transition",
      "properties": {
        "from_dimension": { "type": "number" },
        "to_dimension": { "type": "number" },
        "transition_time_ms": { "type": "number" }
      }
    },
    "s_mu": {
      "type": "object",
      "description": "Sμ — micro-harmonic stability",
      "properties": {
        "dimension": { "type": "number" },
        "stability_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "e_mu": {
      "type": "object",
      "description": "Eμ — micro-energy threshold",
      "properties": {
        "operation_id": { "type": "string" },
        "threshold_uj": { "type": "number" }
      }
    },
    "c_mu": {
      "type": "object",
      "description": "Cμ — micro-coherence shaping",
      "properties": {
        "dimension": { "type": "number" },
        "coherence_window_ms": { "type": "number" }
      }
    },
    "delta_mu": {
      "type": "object",
      "description": "Δμ — micro-drift correction",
      "properties": {
        "dimension": { "type": "number" },
        "drift_ppm": { "type": "number" },
        "correction_applied": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}
