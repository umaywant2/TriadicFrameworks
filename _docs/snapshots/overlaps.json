{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Overlap Event Registry",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "event_id": { "type": "string", "description": "Unique identifier for the overlap event" },
      "timestamp": { "type": "string", "format": "date-time" },
      "partitions": { 
        "type": "array",
        "items": { "type": "string" },
        "description": "Partitions involved in the overlap"
      },
      "clarity_score": { "type": "number", "minimum": 0, "maximum": 1 },
      "duration_seconds": { "type": "integer", "description": "Length of overlap window" },
      "special_visitors": { 
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional resonance signatures of visitors"
      }
    },
    "required": ["event_id","timestamp","partitions","clarity_score"]
  }
}
