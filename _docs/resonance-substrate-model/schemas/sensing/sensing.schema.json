{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sensing Schema",
  "description": "Defines sensing modalities, sampling behavior, resolution, noise models, and resonance-sensing coupling for the Resonance Substrate Model (RSM). Supports physical, simulated, and FFF-emitter-based sensing.",

  "type": "object",

  "properties": {
    "modality": {
      "type": "string",
      "enum": [
        "scalar_field",
        "vector_field",
        "resonance_envelope",
        "energy",
        "quantum",
        "environmental",
        "custom"
      ],
      "description": "Type of quantity being sensed."
    },

    "sampling": {
      "type": "object",
      "description": "Defines how sensing samples are collected.",
      "properties": {
        "rate": {
          "type": "number",
          "description": "Sampling rate in samples per second."
        },
        "window": {
          "type": "number",
          "description": "Duration of each sampling window."
        },
        "mode": {
          "type": "string",
          "enum": ["continuous", "discrete", "event_driven"],
          "description": "Sampling mode."
        }
      },
      "required": ["rate"]
    },

    "resolution": {
      "type": "object",
      "description": "Spatial, temporal, or amplitude resolution of the sensor.",
      "properties": {
        "spatial": {
          "type": "number",
          "description": "Spatial resolution in substrate units."
        },
        "temporal": {
          "type": "number",
          "description": "Temporal resolution in seconds."
        },
        "amplitude": {
          "type": "number",
          "description": "Minimum detectable amplitude change."
        }
      }
    },

    "noise_model": {
      "type": "object",
      "description": "Defines noise characteristics affecting sensor readings.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["gaussian", "uniform", "pink", "none", "custom"],
          "description": "Noise distribution type."
        },
        "variance": {
          "type": "number",
          "description": "Variance or strength of the noise."
        },
        "parameters": {
          "type": "object",
          "description": "Additional noise parameters.",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },

    "calibration": {
      "type": "object",
      "description": "Calibration parameters for the sensing system.",
      "properties": {
        "reference_values": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "tolerance": {
          "type": "number",
          "description": "Allowed deviation from reference values."
        },
        "method": {
          "type": "string",
          "description": "Calibration method or protocol."
        }
      }
    },

    "resonance_coupling": {
      "type": "object",
      "description": "Defines how sensing interacts with resonance fields.",
      "properties": {
        "sensitivity": {
          "type": "number",
          "description": "Sensitivity to resonance amplitude."
        },
        "phase_tracking": {
          "type": "boolean",
          "description": "Whether the sensor tracks resonance phase."
        },
        "coherence_affinity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Affinity for coherence detection (0–1)."
        }
      }
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },

  "required": ["modality", "sampling"]
}
