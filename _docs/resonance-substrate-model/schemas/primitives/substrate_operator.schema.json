{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/primitives/substrate_operator.schema.json",
  "title": "SubstrateOperator",
  "description": "A single operator used in the SET substrate dynamics, such as diffusion, decay, alignment, or coupling.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable operator name (e.g., 'diffusion', 'alignment', 'temperature_relaxation')."
    },
    "type": {
      "type": "string",
      "enum": [
        "diffusion",
        "decay",
        "alignment",
        "destabilization",
        "coupling",
        "noise",
        "custom"
      ],
      "description": "Categorical operator type."
    },
    "parameters": {
      "type": "object",
      "description": "Operator-specific parameters (e.g., diffusion coefficient, decay rate).",
      "additionalProperties": {
        "type": ["number", "string", "boolean"]
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this operator is active in the simulation."
    }
  },
  "required": ["name", "type"]
}

