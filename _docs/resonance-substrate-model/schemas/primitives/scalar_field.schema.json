{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/primitives/scalar_field.schema.json",
  "title": "ScalarField",
  "description": "A 2D scalar field defined on a uniform grid.",
  "type": "object",
  "properties": {
    "nx": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of grid points in the x‑direction."
    },
    "ny": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of grid points in the y‑direction."
    },
    "values": {
      "type": "array",
      "description": "Row‑major 2D array of scalar values.",
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    }
  },
  "required": ["nx", "ny", "values"]
}

