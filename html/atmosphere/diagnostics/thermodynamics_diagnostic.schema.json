{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thermodynamics Diagnostic Schema",
  "type": "object",
  "required": ["module", "diagnostic", "version", "fields", "thresholds", "operators", "regimes", "output"],
  "properties": {
    "module": { "type": "string", "const": "atmosphere" },
    "diagnostic": { "type": "string", "const": "thermodynamics" },
    "version": { "type": "string" },

    "fields": {
      "type": "object",
      "properties": {
        "temperature": { "type": "array", "items": { "type": "string" } },
        "energy_flux": { "type": "array", "items": { "type": "string" } },
        "phase_change": { "type": "array", "items": { "type": "string" } },
        "radiative_balance": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["temperature", "energy_flux", "phase_change", "radiative_balance"]
    },

    "thresholds": {
      "type": "object",
      "properties": {
        "gradient_clarity_min": { "type": "number" },
        "flux_stability_min": { "type": "number" },
        "radiative_balance_tolerance": { "type": "number" }
      },
      "required": [
        "gradient_clarity_min",
        "flux_stability_min",
        "radiative_balance_tolerance"
      ]
    },

    "operators": {
      "type": "object",
      "properties": {
        "thermodynamics": { "type": "array", "items": { "type": "string" } },
        "continuity": { "type": "array", "items": { "type": "string" } },
        "coherence": { "type": "array", "items": { "type": "string" } },
        "clarity": { "type": "array", "items": { "type": "string" } },
        "dimensional": { "type": "array", "items": { "type": "string" } },
        "drift": { "type": "array", "items": { "type": "string" } },
        "paradox": { "type": "array", "items": { "type": "string" } },
        "resonance": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "thermodynamics",
        "continuity",
        "coherence",
        "clarity",
        "dimensional",
        "drift",
        "paradox",
        "resonance"
      ]
    },

    "regimes": {
      "type": "object",
      "properties": {
        "stable": { "type": "array", "items": { "type": "string" } },
        "transition": { "type": "array", "items": { "type": "string" } },
        "unstable": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["stable", "transition", "unstable"]
    },

    "output": {
      "type": "object",
      "properties": {
        "clarity": { "type": "array", "items": { "type": "string" } },
        "stability": { "type": "array", "items": { "type": "string" } },
        "signature": { "type": "array", "items": { "type": "string" } },
        "operators_triggered": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "clarity",
        "stability",
        "signature",
        "operators_triggered"
      ]
    }
  }
}
