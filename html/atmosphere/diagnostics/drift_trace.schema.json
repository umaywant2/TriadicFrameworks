{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drift Trace Schema (Atmosphere Module)",
  "description": "Schema for validating drift_trace.json — drift events, boundary weakening, coherence decay, oscillation drift, and transition sequences.",
  "type": "object",

  "properties": {
    "trace": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "sequence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "description", "sequence"]
      }
    },

    "signatures": {
      "type": "array",
      "items": { "type": "string" }
    },

    "agents": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["primary", "secondary"]
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "fields": {
      "type": "object",
      "properties": {
        "boundary_drift_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coherence_decay_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "oscillation_drift_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cross_domain_drift_field": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "boundary_drift_field",
        "coherence_decay_field",
        "oscillation_drift_field",
        "cross_domain_drift_field"
      ]
    },

    "cascades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "trace",
    "events",
    "signatures",
    "agents",
    "scales",
    "fields",
    "cascades",
    "summary"
  ]
}
