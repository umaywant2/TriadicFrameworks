{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_energy_profile.schema.json",
  "title": "autonomous_energy_profile",
  "type": "object",
  "required": ["form_id"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "battery_wh": {
      "type": "number",
      "description": "Total battery capacity in watt-hours."
    },

    "fuel_j": {
      "type": "number",
      "description": "Fuel energy capacity in joules."
    },

    "thermal_envelope_c": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

