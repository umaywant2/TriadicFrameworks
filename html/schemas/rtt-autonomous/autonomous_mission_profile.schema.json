{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_mission_profile.schema.json",
  "title": "autonomous_mission_profile",
  "type": "object",
  "required": ["mission_id", "form_id", "phases"],
  "properties": {
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },

    "form_id": {
      "type": "string",
      "format": "uuid"
    },

    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase_id", "tasks"],
        "properties": {
          "phase_id": { "type": "string" },
          "tasks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

