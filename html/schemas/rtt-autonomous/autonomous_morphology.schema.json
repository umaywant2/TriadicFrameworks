{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_morphology.schema.json",
  "title": "autonomous_morphology",
  "type": "object",
  "required": ["form_id", "body_plan"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "body_plan": {
      "type": "string",
      "description": "General morphology (fish, quadcopter, rover, walker)."
    },

    "actuators": {
      "type": "array",
      "items": { "type": "string" }
    },

    "control_surfaces": {
      "type": "array",
      "items": { "type": "string" }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

