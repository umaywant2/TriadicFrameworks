{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_environmental_interaction.schema.json",
  "title": "autonomous_environmental_interaction",
  "type": "object",
  "required": ["form_id"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "interaction_modes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "How the form interacts with its environment (e.g., sonar, lidar, fins, wheels)."
    },

    "environmental_constraints": {
      "type": "object",
      "properties": {
        "max_depth_m": { "type": "number" },
        "max_altitude_m": { "type": "number" },
        "max_temperature_c": { "type": "number" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

