{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous/v1/autonomous_swarm_state.schema.json",
  "title": "autonomous_swarm_state",
  "type": "object",
  "required": ["swarm_id", "timestamp", "members"],
  "properties": {
    "swarm_id": { "type": "string" },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["form_id", "position_m"],
        "properties": {
          "form_id": { "type": "string", "format": "uuid" },
          "position_m": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          },
          "coherence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

