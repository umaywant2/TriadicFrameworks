{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triadic Atlas Substrate Schema",
  "type": "object",

  "properties": {
    "substrate": {
      "type": "string",
      "const": "triadic-atlas"
    },

    "version": {
      "type": "string"
    },

    "generated": {
      "type": "string",
      "description": "ISO date of generation"
    },

    "modules": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "schema": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["path", "schema"]
        }
      }
    },

    "schemas": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["path"]
        }
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "notes": { "type": "string" }
      }
    }
  },

  "required": [
    "substrate",
    "version",
    "modules",
    "schemas"
  ]
}
