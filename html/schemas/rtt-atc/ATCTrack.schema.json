{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-atc/v1/ATCTrack.schema.json",
  "title": "ATCTrack",
  "type": "object",
  "required": ["track_id", "timestamp", "position_m", "velocity_m_s"],
  "properties": {
    "track_id": { "type": "string" }, // ICAO hex → RTT objectId
    "timestamp": { "type": "string", "format": "date-time" },

    "position_m": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, // ENU or local tangent plane
        "y": { "type": "number" },
        "z": { "type": "number" }  // altitude → RTT z-axis
      }
    },

    "velocity_m_s": {
      "type": "object",
      "properties": {
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "vz": { "type": "number" }
      }
    },

    "source_modes": {
      "type": "array",
      "items": { "type": "string" }
      // e.g., ["PSR", "SSR", "ADS-B", "MLAT"]
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
