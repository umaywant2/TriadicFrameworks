{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Quantum Energy Bank",
  "type": "object",
  "properties": {
    "bank_id": { "type": "string" },
    "capacity_quanta": { "type": "number" },
    "corridors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "triadic_balance": {
      "type": "object",
      "properties": {
        "spin_balance": { "type": "number" },
        "charge_balance": { "type": "number" },
        "temperature_balance": { "type": "number" }
      }
    },
    "loss_profile": { "type": "object" }
  },
  "required": ["bank_id", "capacity_quanta"]
}
