{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/universe-core/v1/UniverseObject.schema.json",
  "title": "UniverseObject",
  "type": "object",
  "required": ["id", "domain", "position", "velocity"],
  "properties": {
    "id": { "type": "string" },
    "domain": { "type": "string" }, // "atc", "space", "coal", "deepsea", etc.

    "position": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },

    "velocity": {
      "type": "object",
      "properties": {
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "vz": { "type": "number" }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

