{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-space/v1/SpaceAugmentedTrack.schema.json",
  "title": "SpaceAugmentedTrack",
  "type": "object",
  "required": ["object_id", "rtt"],
  "properties": {
    "object_id": { "type": "string" },

    "rtt": {
      "type": "object",
      "properties": {
        "orbital_stability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
          // RTT clarity → orbital stability
        },
        "conjunction_resonance": {
          "type": "number"
          // RTT resonance → conjunction coupling
        },
        "drift_potential": {
          "type": "number"
          // RTT drift → long-term orbital drift
        }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

