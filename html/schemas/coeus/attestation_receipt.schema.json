{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Attestation Receipt",
  "type": "object",
  "properties": {
    "artifact_id": { "type": "string" },
    "hash": { "type": "string" },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "proofs": {
      "type": "object",
      "properties": {
        "causal": { "type": "boolean" },
        "functional": { "type": "boolean" },
        "cognitive": { "type": "boolean" }
      }
    },
    "seed": { "type": "string" },
    "lineage_ref": { "type": "string" },
    "attestor": { "type": "string" },
    "signature": { "type": "string" }
  },
  "required": ["artifact_id", "hash", "proofs", "attestor", "signature"]
}
