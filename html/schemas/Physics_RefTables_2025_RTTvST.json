  "substrates": {
    "material": {
      "description": "Mass–motion substrate governing classical state-change under applied force.",
      "regimes": {
        "classical_low_velocity": {
          "constants": [
            { "symbol": "g", "value": "9.8 m/s^2", "meaning": "acceleration due to gravity" }
          ],
          "equations": [
            "v_f = v_i + a t",
            "d = v_i t + (1/2) a t^2",
            "v_f^2 = v_i^2 + 2 a d",
            "F_net = m a",
            "F_g = m g",
            "p = m v"
          ],
          "resonance_behavior": ["linear", "quadratic"]
        },
        "gravitational_inverse_square": {
          "constants": [
            { "symbol": "G", "value": "6.67 × 10^-11 N·m^2/kg^2", "meaning": "universal gravitational constant" }
          ],
          "equations": [
            "F_g = G (m1 m2) / r^2"
          ],
          "resonance_behavior": ["inverse_square"]
        }
      }
    },

    "geometric": {
      "description": "Spatial curvature, circular motion, and geometric constraints.",
      "regimes": {
        "circular_motion": {
          "equations": [
            "a_c = v^2 / r",
            "C = 2πr"
          ],
          "resonance_behavior": ["quadratic_velocity", "inverse_radius"]
        }
      }
    },

    "energy": {
      "description": "Potential, kinetic, thermal, and mechanical energy substrates.",
      "regimes": {
        "mechanical_energy": {
          "equations": [
            "KE = (1/2) m v^2",
            "ΔPE_g = m g Δh",
            "PE_s = (1/2) k x^2",
            "W = F d",
            "W_net = ΔE_T",
            "E_T = PE + KE + E_other"
          ],
          "resonance_behavior": ["quadratic", "linear"]
        },
        "thermal_energy": {
          "equations": [
            "Q = m c ΔT",
            "P = W / t"
          ],
          "resonance_behavior": ["linear"]
        }
      }
    },

    "field": {
      "description": "Electromagnetic field substrate: forces, potentials, and circuit behavior.",
      "regimes": {
