          "constants": [
            { "symbol": "k", "value": "9.0 × 10^9 N·m^2/C^2", "meaning": "electrostatic constant" }
          ],
          "equations": [
            "F_e = k (q1 q2) / r^2",
            "E = F_e / q"
          ],
          "resonance_behavior": ["inverse_square"]
