{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous-drone/v1/drone_flight_envelope.schema.json",
  "title": "drone_flight_envelope",
  "type": "object",
  "required": ["form_id"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "max_speed_m_s": {
      "type": "number",
      "description": "Maximum forward flight speed."
    },

    "max_climb_rate_m_s": {
      "type": "number",
      "description": "Maximum vertical climb rate."
    },

    "max_descent_rate_m_s": {
      "type": "number",
      "description": "Maximum safe descent rate."
    },

    "max_wind_resistance_m_s": {
      "type": "number",
      "description": "Maximum wind speed the drone can safely operate in."
    },

    "stall_speed_m_s": {
      "type": "number",
      "description": "Minimum airspeed for fixed-wing drones."
    },

    "tilt_limits_deg": {
      "type": "object",
      "properties": {
        "roll": { "type": "number" },
        "pitch": { "type": "number" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

