{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "RTT Packet",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string" },
    "protocol": { "type": "string" },
    "payload": { "type": "object" },
    "triadic_signature": {
      "type": "object",
      "properties": {
        "spin": { "type": "number" },
        "charge": { "type": "number" },
        "temperature": { "type": "number" }
      }
    }
  }
}
