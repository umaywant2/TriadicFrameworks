{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "RTT Network Link",
  "type": "object",
  "properties": {
    "link_id": { "type": "string" },
    "source": { "type": "string" },
    "target": { "type": "string" },
    "bandwidth_gbps": { "type": "number" },
    "latency_ms": { "type": "number" },
    "triadic_resonance": {
      "type": "object",
      "properties": {
        "spin_flux": { "type": "number" },
        "charge_flux": { "type": "number" },
        "temperature_flux": { "type": "number" }
      }
    }
  },
  "required": ["link_id", "source", "target"]
}
