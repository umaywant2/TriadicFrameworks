{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "RTT Network Node",
  "type": "object",
  "properties": {
    "node_id": { "type": "string" },
    "vendor": { "type": "string" },
    "model": { "type": "string" },
    "interfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "triadic_profile": {
      "type": "object",
      "properties": {
        "spin_field": { "type": "number" },
        "charge_field": { "type": "number" },
        "temperature_field": { "type": "number" }
      }
    },
    "routing_capabilities": { "type": "object" }
  },
  "required": ["node_id"]
}
