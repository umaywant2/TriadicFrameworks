{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rsadi-gd-advanced/v1/RealmState.schema.json",
  "title": "RealmState",
  "type": "object",
  "required": ["realm"],
  "properties": {
    "realm": {
      "type": "string",
      "enum": ["substrate", "resonance", "time", "synthesis"],
      "description": "Current metaphysical layer of the world."
    },
    "stability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "Realm stability (RTT clarity analogue)."
    },
    "drift_bias": {
      "type": "number",
      "description": "Realm-level drift influence on player and NPC behavior."
    },
    "temporal_phase": {
      "type": "number",
      "description": "Phase offset for Time realm mechanics."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

