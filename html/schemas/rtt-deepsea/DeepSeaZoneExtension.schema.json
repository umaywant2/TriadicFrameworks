{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-deepsea/v1/DeepSeaZoneExtension.schema.json",
  "title": "DeepSeaZoneExtension",
  "type": "object",
  "properties": {
    "pressure_gradient_kpa_m": {
      "type": "number",
      "description": "Vertical pressure gradient (RTT stress gradient)."
    },
    "thermal_vent_presence": {
      "type": "boolean",
      "description": "Indicates if hydrothermal vents influence the zone."
    },
    "hazard_pockets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Localized danger areas (RTT low-clarity pockets)."
    },
    "acoustic_shadow_zones": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Regions where acoustic clarity is degraded."
    }
  }
}

