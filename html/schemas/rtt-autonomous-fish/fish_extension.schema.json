{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous-fish/v1/fish_extension.schema.json",
  "title": "fish_extension",
  "type": "object",
  "properties": {
    "species_profile": {
      "type": "string",
      "description": "Biomimetic species template (e.g., trout, salmon, carp)."
    },
    "buoyancy_mode": {
      "type": "string",
      "enum": ["neutral", "positive", "negative"],
      "description": "Default buoyancy configuration."
    },
    "fin_configuration": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of fins or fin-like actuators."
    },
    "swim_gait": {
      "type": "string",
      "description": "Primary locomotion pattern (e.g., carangiform, anguilliform)."
    }
  }
}

