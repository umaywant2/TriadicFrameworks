{
  "query_id": "vst_sql_minimal_detection_v1",
  "description": "Minimal structural query envelope for detecting repeating motifs.",
  "query": {
    "select": ["pattern", "periodicity", "local_symmetry"],
    "from": "signal",
    "where": {
      "min_repetition": 2,
      "min_similarity": 0.85
    }
  },
  "input_binding": {
    "signal_source": "example_signal_input.json",
    "stream_key": "stream"
  }
}
