{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/vST_micro_agent.schema.json",
  "title": "vST Micro-Agent Schema (v2.0.0)",
  "description": "Schema for the vST Micro-Agent: a substrate-agnostic interpreter that extracts structural invariants from unknown or heterogeneous input streams using vST-SQL structural query envelopes.",
  "type": "object",

  "required": [
    "signal_input",
    "query_envelope",
    "interpreter_config"
  ],

  "properties": {

    "signal_input": {
      "type": "object",
      "description": "Arbitrary numeric or symbolic input stream. No semantics assumed.",
      "required": ["stream"],
      "properties": {
        "signal_id": { "type": "string" },
        "description": { "type": "string" },
        "stream": {
          "type": "array",
          "items": { "type": "number" }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "sampling_rate_hz": { "type": "number" },
            "units": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },

    "query_envelope": {
      "type": "object",
      "description": "vST-SQL structural query envelope defining what structural features to extract.",
      "required": ["query", "input_binding"],
      "properties": {

        "query_id": { "type": "string" },
        "description": { "type": "string" },

        "query": {
          "type": "object",
          "required": ["select"],
          "properties": {
            "select": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pattern",
                  "periodicity",
                  "local_symmetry",
                  "transition_topology"
                ]
              }
            },
            "where": {
              "type": "object",
              "properties": {
                "min_repetition": { "type": "number" },
                "min_similarity": { "type": "number" },
                "max_drift": { "type": "number" }
              }
            }
          }
        },

        "input_binding": {
          "type": "object",
          "required": ["signal_source", "stream_key"],
          "properties": {
            "signal_source": { "type": "string" },
            "stream_key": { "type": "string" }
          }
        }
      }
    },

    "interpreter_config": {
      "type": "object",
      "description": "Configuration for the vST Micro-Agent interpreter.",
      "properties": {
        "normalization": {
          "type": "string",
          "enum": ["none", "zscore", "minmax"]
        },
        "windowing": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "window_sizes": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        },
        "similarity_metric": {
          "type": "string",
          "enum": ["cosine", "euclidean", "correlation"]
        }
      }
    },

    "interpreter_output": {
      "type": "object",
      "description": "Structural interpretation output. Generated by the micro-agent.",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": { "type": "array", "items": { "type": "number" } },
              "positions": { "type": "array", "items": { "type": "number" } },
              "similarity_range": {
                "type": "array",
                "items": { "type": "number" }
              }
            }
          }
        },
        "periodicity": {
          "type": "object",
          "properties": {
            "period": { "type": "number" },
            "confidence": { "type": "number" }
          }
        },
        "local_symmetry": {
          "type": "object",
          "properties": {
            "symmetry_score": { "type": "number" },
            "regions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
