{
  "$id": "https://triadicframeworks.org/schema/module.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriadicFrameworks Module Schema",
  "description": "Minimal schema for RTT/TF modules. Student-safe, canon-aligned.",

  "type": "object",
  "required": ["module", "identity", "purpose", "files", "operators"],

  "properties": {
    "module": {
      "type": "string",
      "description": "Short module name (folder name)."
    },

    "identity": {
      "type": "string",
      "description": "Global identity for the module (namespace.module)."
    },

    "purpose": {
      "type": "string",
      "description": "One-sentence description of what the module teaches."
    },

    "files": {
      "type": "array",
      "description": "List of files included in the module.",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Filename relative to the module folder."
          },
          "role": {
            "type": "string",
            "description": "Purpose of the file.",
            "enum": [
              "profile",
              "example",
              "reference",
              "map",
              "template",
              "index"
            ]
          }
        }
      }
    },

    "operators": {
      "type": "array",
      "description": "List of operators defined by the module.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Operator name."
          },
          "description": {
            "type": "string",
            "description": "What the operator does."
          },
          "example": {
            "type": "string",
            "description": "Optional example usage."
          }
        }
      }
    },

    "regimes": {
      "type": "array",
      "description": "Optional RTT/2 regimes.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },

    "layers": {
      "type": "array",
      "description": "Optional RTT/3 coherence layers.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}

