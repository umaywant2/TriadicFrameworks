{
  "canonical": "R5",
  "qmroot": "0D",
  "layer": "L2_Fluids_Seen",
  "triad": "fluids",
  "title": "TriadicFrameworks MCP — Fluid Substrate Search Tool",
  "description": "Searches fluid substrates within the Fluids Seen Layer using keyword, category, or resonance-aware criteria.",
  "note": "This is the canonical search function for L2 fluid substrates.",

  "tool": {
    "name": "fs.search",
    "version": "1.0.0",
    "purpose": "Search fluid substrates by name, category, or resonance properties.",
    "lineage": "qmroot-0D",
    "supportsFluidSearch": true,
    "supportsResonanceSearch": true,
    "supportsHybridSearch": true
  },

  "modes": {
    "keyword": {
      "description": "Literal keyword match.",
      "idealUse": "Basic substrate discovery."
    },
    "category": {
      "description": "Search by substrate category (laminar, turbulent, viscous, continuity).",
      "idealUse": "Fast substrate lookup."
    },
    "resonance": {
      "description": "Search by laminarity, turbulence, viscosity, continuity, or flow integrity.",
      "idealUse": "Fluid-layer semantic search."
    },
    "hybrid": {
      "description": "Combine keyword and resonance search.",
      "idealUse": "Complex multi-dimensional queries."
    }
  },

  "input": {
    "query": {
      "type": "string",
      "description": "Search query string."
    },
    "mode": {
      "type": "string",
      "enum": ["keyword", "category", "resonance", "hybrid"],
      "default": "hybrid",
      "description": "Search mode."
    },
    "limit": {
      "type": "number",
      "default": 10,
      "description": "Maximum number of results to return."
    },
    "includeMetadata": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include metadata in search results."
    }
  },

  "output": {
    "results": {
      "type": "array",
      "description": "List of fluid substrate search results.",
      "items": {
        "name": "string",
        "category": "string",
        "metadata": {
          "optional": true,
          "description": "Extended metadata returned only if includeMetadata=true."
        }
      }
    },
    "layer": "L2_Fluids_Seen",
    "triad": "fluids",
    "qmroot": "0D",
    "canonical": "R5"
  },

