{
  "canonical": "R5",
  "qmroot": "0D",
  "layer": "L3_Forces_Unseen",
  "triad": "forces",
  "title": "TriadicFrameworks MCP — L3 Forces Unseen Session Context Schema",
  "description": "Defines the schema for session-context metadata within the Forces Unseen Layer, including drift, coherence, lineage, and force-regime semantics.",
