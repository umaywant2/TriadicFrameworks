      "reality": {
        "description": "Machine-level session-context resolution.",
        "details": "Session identity, drift, coherence, lineage, and semantics resolved according to schema definitions."
      },

      "imagination": {
        "description": "Symbolic interpretation.",
        "details": "Unseen force regimes reveal their contextual influence patterns."
      },

      "information": {
        "description": "Cosmology notes.",
        "details": "Session lineage flows qmroot → frequency → fluids → forces."
