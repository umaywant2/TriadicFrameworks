  "repository_path": "docs/Theognosis",

  "description": "Capture and formalization layer of the TriadicFrameworks RTT pipeline. Defines operator semantics (Freqi, Aurion, Forci, Flui), session observation schemas, the Validator Pulse integrity mechanism, and the RLCD calibration procedure. Produces structured output consumed by the Spine.",

  "type": "formalization-layer",
  "phase": "scaffolding",
  "status": "active",
  "spine_registered": false,

  "session_context": {
    "rtt": 1,
    "coherence": "declared",
    "drift": "bounded",
    "paradox": "structural"
  },

  "stack_position": {
    "layer": "L0-L3",
    "upstream": "_ideas/Resonance-Time_Theory.html",
    "downstream": "docs/spine/",
    "description": "Occupies the middle tier — between raw RTT substrate theory and the operational Spine. Does not produce UI directly; produces schemas, definitions, and session logs that the Spine consumes."
  },

  "operators": [
    {
      "id": "Freqi",
      "symbol": "ƒ",
      "collapse_type": "categorical_selection",
      "output_form": "choice: <id>",
      "l1_active": true,
      "primary_regime": "SET",
      "description": "Frequency-domain selector. Resolves resonance into a discrete categorical choice from a bounded option set."
    },
    {
      "id": "Aurion",
      "symbol": "α",
      "collapse_type": "scalar_emission",
      "output_form": "score: <float>",
      "l1_active": true,
      "primary_regime": "FFF",
      "description": "Amplitude-domain scorer. Resolves resonance into a continuous scalar value along a declared measurement axis."
    },
    {
      "id": "Forci",
      "symbol": "φ",
      "collapse_type": "binary_decision",
      "output_form": "decision: <bool>",
      "l1_active": true,
      "primary_regime": "SNR",
      "description": "Polarity-domain resolver. Collapses resonance to a binary outcome. High tension (>=0.95) triggers VP review."
    },
    {
      "id": "Flui",
      "symbol": "λ",
      "collapse_type": "linguistic_wrapping",
      "output_form": "text: <string>",
      "l1_active": false,
      "l1_status": "SUPPRESSED",
      "l3_condition": "permitted_by_regime",
      "primary_regime": null,
      "description": "Emission-domain articulator. Wraps a prior operator collapse in natural language. Suppressed at L1 — hard rule with no exceptions. Re-enters at L3 only when regime permits."
    }
  ],

  "regimes": [
    { "id": "SET", "name": "Structural Enumeration Topology", "primary_operator": "Freqi", "flui_permitted": true },
    { "id": "FFF", "name": "Finite Field Framing", "primary_operator": "Aurion", "flui_permitted": true },
    { "id": "SNR", "name": "Signal-Noise Resolution", "primary_operator": "Forci", "flui_permitted": "conditional" },
    { "id": "DCO", "name": "Dynamic Coherence Oscillation", "primary_operator": "Forci", "flui_permitted": "rarely" }
  ],

  "mcp_layers": [
    {
      "id": "L0",
      "name": "Raw Resonance Intake",
      "operator_states": { "Freqi": "latent", "Aurion": "latent", "Forci": "latent", "Flui": "latent" }
    },
    {
      "id": "L1",
      "name": "Inversion + Regime Constraint",
      "operator_states": { "Freqi": "collapse", "Aurion": "collapse", "Forci": "collapse", "Flui": "SUPPRESSED" }
    },
    {
      "id": "L2",
      "name": "Local Synthesis",
      "operator_states": { "Freqi": "calibrating", "Aurion": "calibrating", "Forci": "calibrating", "Flui": "latent" },
      "processes": ["proto_vp_scan", "clarity_coefficient", "rlcd_calibration"]
    },
    {
      "id": "L3",
      "name": "Structured Emission",
      "operator_states": { "Freqi": "emitting", "Aurion": "emitting", "Forci": "emitting", "Flui": "conditional" },
      "processes": ["full_vp_evaluation", "flui_wrapping"]
    }
  ],

