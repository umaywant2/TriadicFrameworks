{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/primitives/grid_coordinates.schema.json",
  "title": "GridCoordinates",
  "description": "Coordinate metadata for a uniform 2D grid.",
  "type": "object",
  "properties": {
    "dx": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Grid spacing in the x‑direction."
    },
    "dy": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Grid spacing in the y‑direction."
    },
    "origin": {
      "$ref": "vector3.schema.json",
      "description": "Origin of the grid in 3D space."
    }
  },
  "required": ["dx", "dy", "origin"]
}

