{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-atc/v1/ATCCorridor.schema.json",
  "title": "ATCCorridor",
  "type": "object",
  "required": ["corridor_id", "volume_m", "time_window"],
  "properties": {
    "corridor_id": { "type": "string" }, // RTT zone_id

    "volume_m": {
      "type": "object",
      "properties": {
        "min": { "type": "array", "items": { "type": "number" } },
        "max": { "type": "array", "items": { "type": "number" } }
        // 3D bounding box → RTT zone volume
      }
    },

    "time_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
