{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Coeus Operator",
  "type": "object",
  "properties": {
    "operator_id": { "type": "string" },
    "type": { "type": "string" },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "produced_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preconditions": { "type": "object" },
    "postconditions": { "type": "object" },
    "resonance_requirements": { "type": "object" },
    "authorization": { "type": "string" }
  },
  "required": ["operator_id", "type"]
}
