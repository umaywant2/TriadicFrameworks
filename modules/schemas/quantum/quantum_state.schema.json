{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Quantum State",
  "type": "object",
  "properties": {
    "state_id": { "type": "string" },
    "basis": { "type": "string" },
    "amplitudes": { "type": "object" },
    "triadic_signature": {
      "type": "object",
      "properties": {
        "spin": { "type": "number" },
        "charge": { "type": "number" },
        "temperature": { "type": "number" }
      }
    },
    "coherence": { "type": "number" }
  }
}
