{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "RTT Instrument Profile",
  "type": "object",
  "properties": {
    "instrument_id": { "type": "string" },
    "name": { "type": "string" },
    "resolution": { "type": "string" },
    "triadic_sensitivity": {
      "type": "object",
      "properties": {
        "spin_sensitivity": { "type": "number" },
        "charge_sensitivity": { "type": "number" },
        "temperature_sensitivity": { "type": "number" }
      }
    }
  }
}
