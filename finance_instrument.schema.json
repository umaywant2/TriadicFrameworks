{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Financial Instrument",
  "type": "object",
  "properties": {
    "instrument_id": { "type": "string" },
    "type": { "type": "string" },
    "issuer": { "type": "string" },
    "metadata": { "type": "object" },
    "triadic_profile": {
      "type": "object",
      "properties": {
        "spin": { "type": "number" },
        "charge": { "type": "number" },
        "temperature": { "type": "number" }
      }
    }
  },
  "required": ["instrument_id", "type"]
}
