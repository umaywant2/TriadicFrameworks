{
  "$schema": "https://www.triadicframeworks.org/schemas/module.schema.json",

  "module": {
    "name": "Module Template",
    "path": "docs/_template",
    "canon_tag": "template",
    "version": "1.0",
    "layer": "Framework Structural Layer",
    "status": "Active, Canonical",
    "purpose": "Universal canonical template defining metadata, session context, operator grammar, and file layout.",
    "parent": "triadicframeworks-root",
    "url": "https://www.triadicframeworks.org/_template"
  },

  "session_context": {
    "canon": "active (template)",
    "modules_linked": [
      "metadata → session context → operators → structure → module.json"
    ],
    "drift": "minimal (template-locked)",
    "coherence": "stable (canonical grammar)",
    "format": "html + markdown + schema",
    "front_door": "exists (template root)",
    "every_page": "canonical + AI-parsable",
    "audience": ["creators", "maintainers", "AI systems"]
  },

  "structural_grammar": {
    "dimensional_envelope": "D0–D2",
    "regime_envelope": "R0–R1",
    "coherence_envelope": "C0–C2",
    "drift_sensitivity": "low",
    "regime_sensitivity": "low"
  },

  "cross_module_propagation": {
    "imports": [],
    "exports": [
      "canonical metadata",
      "canonical session context",
      "canonical operator grammar",
      "canonical file layout"
    ]
  },

  "submodules": [],

  "files": [
    { "filename": "README.md", "path": "README.md", "purpose": "Template overview.", "role": "profile", "depends_on": [] },
    { "filename": "index.html", "path": "index.html", "purpose": "Front door for template.", "role": "index", "depends_on": [] }
  ]
}
