{
  "openapi": "3.1.0",
  "info": {
    "title": "Quad Engine API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/quad": {
      "get": {
        "summary": "Quad Engine capabilities",
        "responses": {
          "200": {
            "description": "Quad Engine metadata"
          }
        }
      }
    },
    "/api/quad/eval": {
      "post": {
        "summary": "Evaluate a Quad Engine operator",
        "responses": {
          "200": {
            "description": "Evaluation result"
          }
        }
      }
    },
    "/api/quad/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Quad Engine health"
          }
        }
      }
    }
  }
}

