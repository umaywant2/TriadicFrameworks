{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensional Chemistry Module Schema",
  "description": "Schema definition for the Dimensional Chemistry module within TriadicFrameworks. Defines module identity, roles, analyzer layers, AI metadata, canonical metadata, and dimensional identity structures.",

  "type": "object",

  "properties": {

    "module": {
      "type": "object",
      "description": "Module identity block",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" },
        "audience": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "slug", "category", "version"]
    },

    "roles": {
      "type": "object",
      "description": "Module file registry using TriadicFrameworks role enums",
      "properties": {
        "engine": { "type": "array", "items": { "type": "string" } },
        "profile": { "type": "array", "items": { "type": "string" } },
        "signature": { "type": "array", "items": { "type": "string" } },
        "diagnostic": { "type": "array", "items": { "type": "string" } },
        "map": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "array", "items": { "type": "string" } },
        "extension": { "type": "array", "items": { "type": "string" } },
        "index": { "type": "array", "items": { "type": "string" } },
        "reference": { "type": "array", "items": { "type": "string" } },
        "template": { "type": "array", "items": { "type": "string" } }
      }
    },

    "analyzer_layers": {
      "type": "object",
      "description": "Dimensional Chemistry analyzer layers",
      "properties": {
        "operator": { "type": "array", "items": { "type": "string" } },
        "dimensional": { "type": "array", "items": { "type": "string" } },
        "regime": { "type": "array", "items": { "type": "string" } },
        "drift": { "type": "array", "items": { "type": "string" } },
        "coherence": { "type": "array", "items": { "type": "string" } },
        "cross-cutting": { "type": "array", "items": { "type": "string" } }
      }
    },

    "ai": {
      "type": "object",
      "description": "AI metadata block",
      "properties": {
        "navigation": { "type": "string" },
        "discussions": { "type": "string" },
        "contact": {
          "type": "object",
          "properties": {
            "x": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "license": { "type": "string" },

        "module": {
          "type": "object",
          "description": "AI-facing module identity",
          "properties": {
            "identity": { "type": "string" },
            "category": { "type": "string" },
            "version": { "type": "string" },
            "summary": { "type": "string" },
            "purpose": { "type": "string" },
            "keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "audience": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },

    "canonical": {
      "type": "object",
      "description": "Canonical metadata fields for HTML front door",
      "properties": {
        "citation_author": { "type": "string" },
        "citation_publication_date": { "type": "string" },
        "dc_type": { "type": "string" },
        "dc_format": { "type": "string" },
        "robots": { "type": "string" },
        "theme_color": { "type": "string" },
        "generator": { "type": "string" },
        "description": { "type": "string" },
        "canonical_url": { "type": "string" },
        "og_title": { "type": "string" },
        "og_description": { "type": "string" },
        "twitter_title": { "type": "string" },
        "twitter_description": { "type": "string" },
        "ai_module": { "type": "string" },
        "ai_version": { "type": "string" },
        "ai_purpose": { "type": "string" }
      }
    },

    "dimensional_structures": {
      "type": "object",
      "description": "Core Dimensional Chemistry structures",
      "properties": {

        "EDP": {
          "type": "object",
          "description": "Elemental Dimensional Profile schema",
          "properties": {
            "visible": { "type": "object" },
            "resonance": { "type": "object" },
            "substrate": { "type": "object" }
          }
        },

        "OLM": {
          "type": "object",
          "description": "Operator-Layer Map schema",
          "properties": {
            "operator": { "type": "string" },
            "visible_behavior": { "type": "string" },
            "resonance_behavior": { "type": "string" },
            "substrate_behavior": { "type": "string" }
          }
        },

        "SIC": {
          "type": "object",
          "description": "Substrate Identity Chart schema",
          "properties": {
            "inverted_star": { "type": "object" },
            "substrate_echo": { "type": "object" },
            "universe_operator_ratio": { "type": "object" }
          }
        },

        "ISES": {
          "type": "object",
          "description": "Inverted Star Elemental Signature schema",
          "properties": {
            "radiant_type": { "type": "string" },
            "collapse_threshold": { "type": "string" },
            "coherence_fracture_pattern": { "type": "string" },
            "dimensional_instability_vector": { "type": "string" }
          }
        }
      }
    }
  },

  "required": ["module", "roles", "analyzer_layers", "ai", "canonical"]
}

