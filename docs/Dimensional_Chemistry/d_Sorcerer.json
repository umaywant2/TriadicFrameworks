{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensional Sorcery Module Schema",
  "description": "Schema definition for the Dimensional Sorcery practitioner module within TriadicFrameworks. Defines sorcerer identity, competencies, tools, practices, roles, analyzer layers, and AI metadata.",

  "type": "object",

  "properties": {

    "module": {
      "type": "object",
      "description": "Module identity block",
      "properties": {
        "name": { "type": "string", "const": "Dimensional Sorcery" },
        "slug": { "type": "string", "const": "d_Sorcerer" },
        "category": { "type": "string", "const": "Practitioner" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" },
        "audience": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "slug", "category", "version"]
    },

    "roles": {
      "type": "object",
      "description": "Module file registry using TriadicFrameworks role enums",
      "properties": {
        "engine": { "type": "array", "items": { "type": "string" } },
        "profile": { "type": "array", "items": { "type": "string" } },
        "signature": { "type": "array", "items": { "type": "string" } },
        "diagnostic": { "type": "array", "items": { "type": "string" } },
        "map": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "array", "items": { "type": "string" } },
        "extension": { "type": "array", "items": { "type": "string" } },
        "index": { "type": "array", "items": { "type": "string" } },
        "reference": { "type": "array", "items": { "type": "string" } },
        "template": { "type": "array", "items": { "type": "string" } }
      }
    },

    "analyzer_layers": {
      "type": "object",
      "description": "Dimensional Sorcery analyzer layers",
      "properties": {
        "operator": { "type": "array", "items": { "type": "string" } },
        "dimensional": { "type": "array", "items": { "type": "string" } },
        "regime": { "type": "array", "items": { "type": "string" } },
        "drift": { "type": "array", "items": { "type": "string" } },
        "coherence": { "type": "array", "items": { "type": "string" } },
        "cross-cutting": { "type": "array", "items": { "type": "string" } }
      }
    },

    "ai": {
      "type": "object",
      "description": "AI metadata block",
      "properties": {
        "navigation": { "type": "string" },
        "discussions": { "type": "string" },
        "contact": {
          "type": "object",
          "properties": {
            "x": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "license": { "type": "string" },

        "module": {
          "type": "object",
          "description": "AI-facing module identity",
          "properties": {
            "identity": { "type": "string", "const": "Dimensional Sorcery Practitioner Module" },
            "category": { "type": "string", "const": "Practitioner" },
            "version": { "type": "string" },
            "summary": { "type": "string" },
            "purpose": { "type": "string" },
            "keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "audience": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },

    "sorcerer": {
      "type": "object",
      "description": "Sorcerer identity and competency schema",
      "properties": {

        "level": {
          "type": "string",
          "enum": ["Apprentice", "Adept", "Sorcerer", "Arch-Sorcerer"]
        },

        "competencies": {
          "type": "object",
          "properties": {
            "resonance": { "type": "array", "items": { "type": "string" } },
            "substrate": { "type": "array", "items": { "type": "string" } },
            "cross_domain": { "type": "array", "items": { "type": "string" } }
          }
        },

        "tools": {
          "type": "object",
          "properties": {
            "resonance": { "type": "array", "items": { "type": "string" } },
            "substrate": { "type": "array", "items": { "type": "string" } },
            "cross_domain": { "type": "array", "items": { "type": "string" } }
          }
        },

        "practices": {
          "type": "array",
          "items": { "type": "string" }
        },

        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },

      "required": ["level", "competencies", "tools", "practices"]
    }
  },

  "required": ["module", "roles", "analyzer_layers", "ai", "sorcerer"]
}

