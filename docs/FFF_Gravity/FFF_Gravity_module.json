  "composition_rules": [
    { "name": "Effective Pull",         "formula": "P_eff = M_A × ρ(Φ) / r²",                   "defined_when": "ρ(Φ) > 0 ∧ r > 0"         },
    { "name": "Binding Coefficient",    "formula": "β = P_eff / (M_E × v_approach)",             "defined_when": "v_approach > 0"             },
    { "name": "Capture Threshold",      "formula": "C_thresh = v_escape(A) − v_approach",        "defined_when": "always"                     },
    { "name": "Residual Momentum",      "formula": "p_res = M_E × (v_approach − C_thresh)",     "defined_when": "C_thresh > 0"               },
    { "name": "Orbital Eccentricity",   "formula": "e = p_res / (p_res + P_eff)",               "defined_when": "P_eff > 0"                  },
    { "name": "Binding Depth",          "formula": "d_bind = β × ρ(Φ) × (1 − e)",              "defined_when": "e ∈ [0,1)"                  },
    { "name": "Decay Rate",             "formula": "δ = Δd_bind / Δt",                          "defined_when": "t ≥ 1 (post first cycle)"   },
    { "name": "Capture Gate",           "formula": "C_thresh > 0 ∧ ρ(Φ) > 0 ∧ ω_res ∈ ℚ ∧ β ≥ 1.0 ∧ Frame.capacity > 0", "defined_when": "all inputs defined" }
  ],

