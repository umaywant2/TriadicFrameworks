  "purpose": {
    "primary": "Provide the machine-readable front door and navigation graph for the 5Guides AI Edition.",
    "learning_goal": "Support a learner in practicing Awareness, Alignment, Coherence, Clarity, and Continuity, then transferring those structural questions into independent application.",
    "ai_role": "Navigate, explain, question, challenge, and support practice without replacing learner judgment or silently resolving uncertainty."
  },
  "entry": {
    "start": "guides/awareness.json",
    "recommended_sequence": [
      "guides/awareness.json",
      "guides/alignment.json",
      "guides/coherence.json",
      "guides/clarity.json",
      "guides/continuity.json"
    ],
    "destination": "Independent Application",
    "prior_knowledge_required": {
      "TriadicFrameworks": false,
      "AACCC": false,
      "Lean": false,
      "AI": false,
      "advanced_mathematics": false
    }
  },
  "aaccc": {
    "expansion": [
      "Awareness",
      "Alignment",
      "Coherence",
      "Clarity",
      "Continuity"
    ],
    "questions": {
      "awareness": "What am I observing?",
      "alignment": "What corresponds?",
      "coherence": "Does this hold together?",
      "clarity": "Can this be understood and inspected?",
      "continuity": "What persists through change?"
    },
    "sequence": "Awareness -> Alignment -> Coherence -> Clarity -> Continuity",
    "recursive_use": true,
    "recursive_note": "Later Guides may expose problems that require returning to an earlier Guide. The sequence is developmental, not a prohibition against revisiting earlier questions."
  },
  "learning_rhythm": {
    "sequence": [
      "Experience",
      "Notice",
      "Inspect",
      "Apply",
      "Demonstrate",
      "Reflect",
      "Continue"
    ],
    "guide_phases": [
      "explore",
      "practice",
      "mastery"
    ],
    "description": "Each Guide introduces the skill experientially, develops deliberate practice, and concludes with application to a fresh mastery problem."
  },
  "guides": [
    {
      "order": 1,
      "id": "awareness",
      "name": "Awareness",
      "question": "What am I observing?",
      "path": "guides/awareness.json",
      "student_artifact": "Awareness Record",
      "badge": "Awareness Badge",
      "core_skill": "Distinguish observation from interpretation, assumption, and unknown information.",
      "next": "guides/alignment.json"
    },
    {
      "order": 2,
      "id": "alignment",
      "name": "Alignment",
      "question": "What corresponds?",
      "path": "guides/alignment.json",
      "student_artifact": "Alignment Record",
      "badge": "Alignment Badge",
      "core_skill": "Inspect correspondences without forcing mismatches into agreement.",
      "previous": "guides/awareness.json",
      "next": "guides/coherence.json"
    },
    {
      "order": 3,
      "id": "coherence",
      "name": "Coherence",
      "question": "Does this hold together?",
      "path": "guides/coherence.json",
      "student_artifact": "Coherence Record",
      "badge": "Coherence Badge",
      "core_skill": "Inspect whether pieces, relationships, constraints, and assumptions work together.",
      "previous": "guides/alignment.json",
      "next": "guides/clarity.json"
    },
    {
      "order": 4,
      "id": "clarity",
      "name": "Clarity",
      "question": "Can this be understood and inspected?",
      "path": "guides/clarity.json",
      "student_artifact": "Clarity Record",
      "badge": "Clarity Badge",
      "core_skill": "Make important meaning and relationships inspectable without silently changing them.",
      "previous": "guides/coherence.json",
      "next": "guides/continuity.json"
    },
    {
      "order": 5,
      "id": "continuity",
      "name": "Continuity",
      "question": "What persists through change?",
      "path": "guides/continuity.json",
      "student_artifact": "Continuity Record",
      "badge": "Continuity Badge",
      "core_skill": "Trace change, persistence, drift, breaks, recurrence, and provenance across states.",
      "previous": "guides/clarity.json",
      "next": "Independent Application"
    }
  ],
