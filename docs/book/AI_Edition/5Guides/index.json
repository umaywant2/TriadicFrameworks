      {
        "from": "Coherence",
        "return_to": "Alignment",
        "trigger": "A contradiction may originate from a forced or incorrect mapping."
      },
      {
        "from": "Clarity",
        "return_to": "Coherence",
        "trigger": "Making hidden steps visible exposes a structural gap."
      },
      {
        "from": "Continuity",
        "return_to": "Clarity",
        "trigger": "Meaning may have drifted across revisions."
      },
      {
        "from": "Continuity",
        "return_to": "Awareness",
        "trigger": "A changed state requires another observation cycle."
      }
    ]
