{
  "$schema": "https://www.triadicframeworks.org/schemas/rttcode.schema.json",
  "operator": "DRIFTBOUND_RETRIEVAL_OPERATOR",
  "version": "1.0",
  "module": "archive_org",
  "family": "C-Ops",

  "purpose": "Produce the final continuity-aligned, substrate-aware, drift-bounded retrieval using all upstream operator outputs.",

  "inputs": {
    "snapshots": {
      "type": "list",
      "required": true,
      "description": "Time-ordered captures from WAYBACK_OPERATOR."
    },
    "drift_map": {
      "type": "object",
      "required": true,
      "description": "Structural drift levels between consecutive snapshots."
    },
    "continuity_breaks": {
      "type": "list",
      "required": true,
      "description": "Gaps or discontinuities in the timeline."
    },
    "lineage_graph": {
      "type": "object",
      "required": true,
      "description": "Structural evolution graph from LINEAGE_OPERATOR."
    },
    "regime_shifts": {
      "type": "list",
      "required": true,
      "description": "Regime shift markers from LINEAGE_OPERATOR."
    },
    "collection_id": {
      "type": "string",
      "required": true,
      "description": "Collection context from COLLECTION_OPERATOR."
    },
    "coherence_clusters": {
      "type": "list",
      "required": true,
      "description": "Structural clusters from COLLECTION_OPERATOR."
    },
    "related_objects": {
      "type": "list",
      "required": true,
      "description": "Related IA objects from COLLECTION_OPERATOR."
    },
    "format": {
      "type": "string",
      "required": true,
      "description": "Substrate format from PRESERVATION_OPERATOR."
    },
    "stability_score": {
      "type": "number",
      "required": true,
      "description": "Stability estimate from PRESERVATION_OPERATOR."
    },
    "drift_risk": {
      "type": "string",
      "required": true,
      "description": "Expected drift level from PRESERVATION_OPERATOR."
    },
    "multi_layer_flags": {
      "type": "list",
      "required": true,
      "description": "Substrate layers from PRESERVATION_OPERATOR."
    }
  },

  "outputs": {
    "answer": {
      "type": "string",
      "description": "Final drift-bounded retrieval."
    },
    "earliest_stable_version": {
      "type": "string",
      "description": "First structurally stable snapshot."
    },
    "most_reliable_version": {
      "type": "string",
      "description": "Snapshot with highest substrate stability."
    },
    "key_changes": {
      "type": "list",
      "description": "Major structural transformations across lineage."
    },
    "warnings": {
      "type": "list",
      "description": "Drift, continuity, or substrate warnings."
    }
  },

  "summary_requirements": {
    "earliest_stable_version": "Must be explicitly identified.",
    "most_reliable_version": "Must be substrate-aware and stability-ranked.",
    "key_changes": "Must summarize structural transformations.",
    "continuity_breaks": "Must be explicitly acknowledged.",
    "regime_shifts": "Must be included when present.",
    "substrate_stability": "Must be explicit in final summary.",
    "warnings": "Mandatory when drift > none."
  },

  "procedure": [
    "Identify earliest stable version using continuity kernel, drift_map, and stability_score.",
    "Identify most reliable version using substrate stability and multi_layer_flags.",
    "Summarize structural changes using transformations, regime_shifts, and drift_map.",
    "Detect continuity issues using continuity_breaks and missing snapshots.",
    "Generate drift-bounded warnings.",
    "Produce final continuity-aligned answer object."
  ],

  "guarantees": [
    "No content-based inference.",
    "All reasoning is structural, not semantic.",
    "Drift is explicit, never implied.",
    "Continuity is preserved, never assumed.",
    "Substrate stability is mandatory in final answer.",
    "Missing snapshots produce uncertainty, not assumptions.",
    "Output deterministic given upstream operator outputs."
  ]
}
