{
  "$schema": "https://www.triadicframeworks.org/schemas/rttcode.example.schema.json",
  "example": "ARCHIVE_ORG_journals",
  "version": "1.0",
  "module": "archive_org",

  "target": "https://archive.org/details/journals",
  "collection": "journals",

  "operators": [
    "METADATA_OPERATOR",
    "WAYBACK_OPERATOR",
    "LINEAGE_OPERATOR",
    "COLLECTION_OPERATOR",
    "PRESERVATION_OPERATOR",
    "DRIFTBOUND_RETRIEVAL_OPERATOR"
  ],

  "METADATA_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/journals"
    },
    "output": {
      "substrate_type": "mixed",
      "regime": "scholarly",
      "drift_sensitivity": "medium",
      "coherence": "medium",
      "lineage_ids": ["journals-root", "periodical-index"]
    }
  },

  "WAYBACK_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/journals",
      "constraints": null
    },
    "output": {
      "snapshots": ["2012", "2015", "2018", "2021", "2024"],
      "drift_map": {
        "2012→2015": "minor",
        "2015→2018": "moderate",
        "2018→2021": "high",
        "2021→2024": "minor"
      },
      "continuity_breaks": [],
      "time_crystal": 0.63
    }
  },

  "LINEAGE_OPERATOR": {
    "input": {
      "snapshots": ["2012", "2015", "2018", "2021", "2024"],
      "metadata": {
        "regime": "scholarly",
        "substrate_type": "mixed"
      }
    },
    "output": {
      "lineage_graph": {
        "2012→2015": "template refresh",
        "2015→2018": "navigation restructure",
        "2018→2021": "CMS migration",
        "2021→2024": "minor CSS update"
      },
      "transformations": [
        "template refresh",
        "navigation restructure",
        "CMS migration",
        "CSS update"
      ],
      "regime_shifts": [
        "2018: static → CMS"
      ],
      "continuity_kernel": [
        "header",
        "footer",
        "journal-index",
        "issue-listing"
      ]
    }
  },

  "COLLECTION_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/journals",
      "lineage_graph": {
        "2012→2015": "template refresh",
        "2015→2018": "navigation restructure",
        "2018→2021": "CMS migration",
        "2021→2024": "minor CSS update"
      },
      "regime_shifts": [
        "2018: static → CMS"
      ]
    },
    "output": {
      "collection_id": "journals",
      "coherence_clusters": ["periodical-index", "issue-listing"],
      "related_objects": [
        "journals/science-archive",
        "journals/historical-reviews",
        "journals/academic-bulletins"
      ],
      "regime_profile": "scholarly (CMS-era)"
    }
  },

  "PRESERVATION_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/journals",
      "collection_id": "journals",
      "regime_profile": "scholarly (CMS-era)",
      "continuity_kernel": [
        "header",
        "footer",
        "journal-index",
        "issue-listing"
      ],
      "transformations": [
        "template refresh",
        "navigation restructure",
        "CMS migration",
        "CSS update"
      ]
    },
    "output": {
      "format": "html + pdf",
      "stability_score": 0.71,
      "drift_risk": "medium",
      "multi_layer_flags": ["html", "pdf"]
    }
  },

  "DRIFTBOUND_RETRIEVAL_OPERATOR": {
    "input": {
      "snapshots": ["2012", "2015", "2018", "2021", "2024"],
      "drift_map": {
        "2012→2015": "minor",
        "2015→2018": "moderate",
        "2018→2021": "high",
        "2021→2024": "minor"
      },
      "continuity_breaks": [],
      "lineage_graph": {
        "2012→2015": "template refresh",
        "2015→2018": "navigation restructure",
        "2018→2021": "CMS migration",
        "2021→2024": "minor CSS update"
      },
      "regime_shifts": [
        "2018: static → CMS"
      ],
      "collection_id": "journals",
      "coherence_clusters": ["periodical-index", "issue-listing"],
      "related_objects": [
        "journals/science-archive",
        "journals/historical-reviews",
        "journals/academic-bulletins"
      ],
      "format": "html + pdf",
      "stability_score": 0.71,
      "drift_risk": "medium",
      "multi_layer_flags": ["html", "pdf"]
    },
    "output": {
      "earliest_stable_version": "2012",
      "most_reliable_version": "2024",
      "key_changes": [
        "template refresh (2012→2015)",
        "navigation restructure (2015→2018)",
        "CMS migration (2018→2021)",
        "CSS update (2021→2024)"
      ],
      "warnings": [
        "High drift detected during 2018→2021 CMS migration.",
        "Mixed substrates require layer-aware interpretation."
      ],
      "answer": "The most reliable version is the 2024 snapshot, with stable mixed substrates and no continuity breaks, though the 2018→2021 CMS migration introduces high drift."
    }
  }
}
