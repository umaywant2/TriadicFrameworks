{
  "$schema": "https://www.triadicframeworks.org/schemas/rttcode.example.schema.json",
  "example": "ARCHIVE_ORG_government_documents",
  "version": "1.0",
  "module": "archive_org",

  "target": "https://archive.org/details/government-documents",
  "collection": "govdocs",

  "operators": [
    "METADATA_OPERATOR",
    "WAYBACK_OPERATOR",
    "LINEAGE_OPERATOR",
    "COLLECTION_OPERATOR",
    "PRESERVATION_OPERATOR",
    "DRIFTBOUND_RETRIEVAL_OPERATOR"
  ],

  "METADATA_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/government-documents"
    },
    "output": {
      "substrate_type": "html",
      "regime": "institutional",
      "drift_sensitivity": "low",
      "coherence": "high",
      "lineage_ids": ["govdocs-root", "agency-index"]
    }
  },

  "WAYBACK_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/government-documents",
      "constraints": null
    },
    "output": {
      "snapshots": ["2013", "2016", "2019", "2023"],
      "drift_map": {
        "2013→2016": "minor",
        "2016→2019": "moderate",
        "2019→2023": "minor"
      },
      "continuity_breaks": [],
      "time_crystal": 0.74
    }
  },

  "LINEAGE_OPERATOR": {
    "input": {
      "snapshots": ["2013", "2016", "2019", "2023"],
      "metadata": {
        "regime": "institutional",
        "substrate_type": "html"
      }
    },
    "output": {
      "lineage_graph": {
        "2013→2016": "template update",
        "2016→2019": "navigation restructure",
        "2019→2023": "minor CSS shift"
      },
      "transformations": [
        "template update",
        "navigation restructure",
        "CSS shift"
      ],
      "regime_shifts": [],
      "continuity_kernel": [
        "header",
        "footer",
        "agency-records-index"
      ]
    }
  },

  "COLLECTION_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/government-documents",
      "lineage_graph": {
        "2013→2016": "template update",
        "2016→2019": "navigation restructure",
        "2019→2023": "minor CSS shift"
      },
      "regime_shifts": []
    },
    "output": {
      "collection_id": "govdocs",
      "coherence_clusters": ["public-records", "agency-index"],
      "related_objects": [
        "govdocs/records-archive",
        "govdocs/agency-bulletins"
      ],
      "regime_profile": "institutional"
    }
  },

  "PRESERVATION_OPERATOR": {
    "input": {
      "target": "https://archive.org/details/government-documents",
      "collection_id": "govdocs",
      "regime_profile": "institutional",
      "continuity_kernel": [
        "header",
        "footer",
        "agency-records-index"
      ],
      "transformations": [
        "template update",
        "navigation restructure",
        "CSS shift"
      ]
    },
    "output": {
      "format": "html",
      "stability_score": 0.81,
      "drift_risk": "low",
      "multi_layer_flags": ["html"]
    }
  },

  "DRIFTBOUND_RETRIEVAL_OPERATOR": {
    "input": {
      "snapshots": ["2013", "2016", "2019", "2023"],
      "drift_map": {
        "2013→2016": "minor",
        "2016→2019": "moderate",
        "2019→2023": "minor"
      },
      "continuity_breaks": [],
      "lineage_graph": {
        "2013→2016": "template update",
        "2016→2019": "navigation restructure",
        "2019→2023": "minor CSS shift"
      },
      "regime_shifts": [],
      "collection_id": "govdocs",
      "coherence_clusters": ["public-records", "agency-index"],
      "related_objects": [
        "govdocs/records-archive",
        "govdocs/agency-bulletins"
      ],
      "format": "html",
      "stability_score": 0.81,
      "drift_risk": "low",
      "multi_layer_flags": ["html"]
    },
    "output": {
      "earliest_stable_version": "2013",
      "most_reliable_version": "2023",
      "key_changes": [
        "template update (2013→2016)",
        "navigation restructure (2016→2019)",
        "CSS shift (2019→2023)"
      ],
      "warnings": [],
      "answer": "The most reliable version is the 2023 snapshot, with high stability and no continuity breaks."
    }
  }
}
