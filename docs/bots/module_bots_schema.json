{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/module_bots_registry.json",
  "title": "RTT Bots Registry Schema",
  "description": "Schema for the RTT bots registry manifest.",
  "type": "object",

  "properties": {
    "registry": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name", "id", "summary", "version"]
    },

    "bots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["id", "name", "path", "category", "summary"]
      }
    }
  },

  "required": ["registry", "bots"]
}
