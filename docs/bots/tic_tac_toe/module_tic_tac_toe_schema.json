{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/module_tic_tac_toe_state.json",
  "title": "RTT Tic-Tac-Toe StateEmitter",
  "description": "Shared-envelope triadic state output for a single Tic-Tac-Toe position.",
  "type": "object",

  "properties": {

    "metadata": {
      "type": "object",
      "properties": {
        "module_id": { "type": "string" },
        "position_id": { "type": "string" },
        "next_player": { "type": "string", "enum": ["X", "O"] },
        "ply": { "type": "integer", "minimum": 0 }
      },
      "required": ["module_id", "position_id", "next_player", "ply"],
      "additionalProperties": false
    },

    "timeline": {
      "type": "array",
      "description": "Replayable move history leading to this position.",
      "items": {
        "type": "object",
        "properties": {
          "ply": { "type": "integer", "minimum": 0 },
          "coord": { "type": "string", "pattern": "^[ABC][123]$" },
          "player": { "type": "string", "enum": ["X", "O"] }
        },
        "required": ["ply", "coord", "player"],
        "additionalProperties": false
      }
    },

    "board": {
      "type": "array",
      "description": "3x3 board, row-major.",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["X", "O", " "]
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },

    "legal_moves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coord": { "type": "string", "pattern": "^[ABC][123]$" },
          "index": { "type": "integer", "minimum": 0, "maximum": 8 }
        },
        "required": ["coord", "index"],
        "additionalProperties": false
      }
    },

    "lumen": {
      "type": "object",
      "properties": {
        "winning_lines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[ABC][123]$" },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "threat_lines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[ABC][123]$" },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "fork_opportunities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[ABC][123]$" }
        }
      },
      "required": ["winning_lines", "threat_lines", "fork_opportunities"],
      "additionalProperties": false
    },

    "regime": {
      "type": "object",
      "properties": {
        "proportions": {
          "type": "object",
          "properties": {
            "local": { "type": "number", "minimum": 0, "maximum": 1 },
            "structural": { "type": "number", "minimum": 0, "maximum": 1 },
            "continuity": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["local", "structural", "continuity"],
          "additionalProperties": false
        },
        "move_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coord": { "type": "string", "pattern": "^[ABC][123]$" },
              "regime": { "type": "string", "enum": ["local", "structural", "continuity"] }
            },
            "required": ["coord", "regime"],
            "additionalProperties": false
          }
        }
      },
      "required": ["proportions", "move_tags"],
      "additionalProperties": false
    },

    "ancestry": {
      "type": "object",
      "properties": {
        "win_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[ABC][123]$" }
          }
        },
        "draw_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[ABC][123]$" }
          }
        },
        "loss_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[ABC][123]$" }
          }
        }
      },
      "required": ["win_paths", "draw_paths", "loss_paths"],
      "additionalProperties": false
    },

    "risk": {
      "type": "object",
      "properties": {
        "move_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coord": { "type": "string", "pattern": "^[ABC][123]$" },
              "projection_loss": { "type": "boolean" },
              "collapse_risk": { "type": "string", "enum": ["none", "low", "medium", "high"] }
            },
            "required": ["coord", "projection_loss", "collapse_risk"],
            "additionalProperties": false
          }
        }
      },
      "required": ["move_risks"],
      "additionalProperties": false
    },

    "drift": {
      "type": "object",
      "properties": {
        "direction": { "type": "string" },
        "strength": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["direction", "strength"],
      "additionalProperties": false
    },

    "triadic_score": {
      "type": "object",
      "properties": {
        "local": { "type": "number", "minimum": 0, "maximum": 1 },
        "structural": { "type": "number", "minimum": 0, "maximum": 1 },
        "continuity": { "type": "number", "minimum": 0, "maximum": 1 },
        "final": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["local", "structural", "continuity", "final"],
      "additionalProperties": false
    },

    "winner": {
      "type": ["string", "null"],
      "enum": ["X", "O", "draw", null]
    }
  },

  "required": [
    "metadata",
    "timeline",
    "board",
    "legal_moves",
    "lumen",
    "regime",
    "ancestry",
    "risk",
    "drift",
    "triadic_score",
    "winner"
  ],

  "additionalProperties": false
}
