{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/module_chess_state.json",
  "title": "RTT Chess StateEmitter",
  "description": "Triadic state output for a chess position.",
  "type": "object",

  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "module_id": { "type": "string" },
        "position_id": { "type": "string" },
        "side_to_move": { "type": "string", "enum": ["w", "b"] },
        "fullmove_number": { "type": "integer", "minimum": 1 }
      },
      "required": ["module_id", "position_id", "side_to_move", "fullmove_number"]
    },

    "board": {
      "type": "array",
      "description": "8x8 board, row-major.",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "P","N","B","R","Q","K",
            "p","n","b","r","q","k",
            "."
          ]
        },
        "minItems": 8,
        "maxItems": 8
      },
      "minItems": 8,
      "maxItems": 8
    },

    "legal_moves": {
      "type": "array",
      "items": { "type": "string" }
    },

    "lumen": {
      "type": "object",
      "properties": {
        "center_control": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "tension": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "king_safety": {
          "type": "string",
          "enum": ["safe", "exposed", "critical"]
        },
        "pawn_structure": {
          "type": "string",
          "enum": ["healthy", "damaged", "collapsed"]
        }
      },
      "required": ["center_control", "tension", "king_safety", "pawn_structure"]
    },

    "regime": {
      "type": "array",
      "description": "Hephaestus regime classification per move.",
      "items": {
        "type": "object",
        "properties": {
          "move": { "type": "string" },
          "regime": {
            "type": "string",
            "enum": ["local", "structural", "continuity"]
          }
        },
        "required": ["move", "regime"]
      }
    },

    "ancestry": {
      "type": "array",
      "description": "Aurion ancestry signals across the position.",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "collapse_signature": { "type": "boolean" },
          "projection_loss": { "type": "boolean" }
        },
        "required": ["sequence", "collapse_signature", "projection_loss"]
      }
    },

    "drift": {
      "type": "object",
      "description": "Continuity drift across the positional plan.",
      "properties": {
        "direction": { "type": "string" },
        "strength": {
          "type": "string",
          "enum": ["none", "weak", "medium", "strong"]
        }
      },
      "required": ["direction", "strength"]
    },

    "risk": {
      "type": "object",
      "properties": {
        "paradox": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "collapse": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "projection_loss": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        }
      },
      "required": ["paradox", "collapse", "projection_loss"]
    },

    "triadic_score": {
      "type": "object",
      "properties": {
        "local": { "type": "number", "minimum": 0, "maximum": 1 },
        "structural": { "type": "number", "minimum": 0, "maximum": 1 },
        "continuity": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk": { "type": "number", "minimum": 0, "maximum": 1 },
        "final": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["local", "structural", "continuity", "risk", "final"]
    },

    "timeline": {
      "type": "array",
      "description": "Move history.",
      "items": {
        "type": "object",
        "properties": {
          "ply": { "type": "integer" },
          "move": { "type": "string" },
          "player": { "type": "string" }
        },
        "required": ["ply", "move", "player"]
      }
    }
  },

  "required": [
    "metadata",
    "board",
    "legal_moves",
    "lumen",
    "regime",
    "ancestry",
    "drift",
    "risk",
    "triadic_score"
  ]
}
