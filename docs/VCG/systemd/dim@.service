### `/systemd/dim@.service`

```markdown
# dim@.service

```ini
[Unit]
Description=VCG Dimension %i
After=vcg.service
Requires=vcg.service

[Service]
Type=simple
WorkingDirectory=/vcg/%i
RootDirectory=/vcg/%i
ExecStart=/bin/sh /entrypoint.sh
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
CPUAffinity=%I_CPUSET%
IOSchedulingClass=2
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
