{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Capabilities",

  "metadata": {
    "title": "FFT AI Edition – Capabilities (v1.3)",
    "subtitle": "Functional Envelope for RTT • Regimes • Operators • Measures • Substrate • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical capabilities projection for FFT AI Edition v1.3."
  },

  "status_line": "Capabilities are projections only; authoritative values come from runtime, operators, regimes, substrate, and session.state.",

  "capabilities": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "functional_capabilities": {
      "interpretation": {
        "enabled": true,
        "rtt_range": ["RTT1", "RTT2", "RTT3"],
        "requirements": ["measure.c1 >= 0.80"],
        "notes": "Base interpretive capability for nominal regime."
      },

      "alignment": {
        "enabled": true,
        "rtt_range": ["RTT2", "RTT3", "RTT4"],
        "requirements": ["measure.c2 >= 0.80"],
        "notes": "Alignment capability tied to op.alignment and op.coupling."
      },

      "activation": {
        "enabled": true,
        "rtt_range": ["RTT4", "RTT5"],
        "requirements": ["measure.c3 >= 0.80"],
        "notes": "Activation capability tied to op.activation and op.triadic_time."
      },

      "snr_processing": {
        "enabled": true,
        "rtt_range": ["RTT6"],
        "requirements": ["measure.c2 >= 0.80"],
        "notes": "Signal-to-noise capability tied to op.snr."
      },

      "paradox_processing": {
        "enabled": false,
        "rtt_range": ["RTT7", "RTT8"],
        "requirements": [
          "typed_paradox_event",
          "measure.paradox_density >= 0.10",
          "measure.lattice_stability >= 0.60",
          "substrate_class = agentic"
        ],
        "notes": "Enabled only in harmonic regime."
      },

      "harmonic_escalation": {
        "enabled": false,
        "rtt_range": ["RTT9"],
        "requirements": [
          "operator_consent = true",
          "substrate_class = agentic"
        ],
        "notes": "Requires explicit consent and agentic substrate."
      },

      "resolution_preparation": {
        "enabled": false,
        "rtt_range": ["RTT10"],
        "requirements": [
          "operator_consent = true",
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ],
        "notes": "Resolution preparation capability tied to op.resolution_preparation."
      },

      "resolution_alignment": {
        "enabled": false,
        "rtt_range": ["RTT11"],
        "requirements": [
          "operator_consent = true",
          "measure.c3 >= 0.80"
        ],
        "notes": "Resolution alignment capability tied to op.resolution_alignment."
      },

      "collapse_execution": {
        "enabled": false,
        "rtt_range": ["RTT12"],
        "requirements": [
          "operator_consent = true",
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ],
        "notes": "Collapse capability tied to op.collapse; MUST return to RTT1."
      }
    }
  },

  "rules": {
    "capability_rules": [
      "Capabilities MUST NOT contradict session.state.json.",
      "Capabilities MUST NOT contradict operators.json.",
      "Capabilities MUST NOT contradict regimes.json.",
      "Capabilities MUST NOT contradict substrate.json.",
      "Capabilities MUST NOT contradict spec‑008.json.",
      "Capabilities MUST NOT invent measure IDs.",
      "Capabilities MUST NOT invent paradox types.",
      "Capabilities MUST NOT invent substrate classes."
    ],

    "rtt_rules": [
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT7 requires typed paradox.",
      "RTT9–RTT12 require operator_consent = true.",
      "RTT12 MUST collapse to RTT1 with lineage increment."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "navigation": "fft.ai.session.navigation.json",
    "permissions": "fft.ai.session.permissions.json",
    "profile": "fft.ai.session.profile.json",
    "awareness": "fft.ai.session.awareness.json",
    "analytics": "fft.ai.session.analytics.json",
    "trace": "fft.ai.session.trace.json",
    "render": "fft.ai.session.render.json",
    "ui": "fft.ai.session.ui.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
