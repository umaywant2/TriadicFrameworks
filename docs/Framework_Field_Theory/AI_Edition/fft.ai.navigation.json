{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Navigation",

  "metadata": {
    "title": "FFT AI Edition – Navigation Specification (v1.3)",
    "subtitle": "Canonical Movement Rules Across RTT • Regimes • Operators • Substrate • Paradox • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines navigation rules, movement constraints, RTT progression, paradox routing, substrate gating, consent gating, and collapse pathways for FFT AI Edition v1.3."
  },

  "status_line": "Navigation is a projection only; authoritative values come from RTT v0.9, spec‑008, substrate.json, operators.json, regimes.json, and runtime.json.",

  "navigation": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "rtt_progression": [
      "RTT1 → RTT2 → RTT3 → RTT4 → RTT5 → RTT6 → RTT7 → RTT8 → RTT9 → RTT10 → RTT11 → RTT12 → RTT1"
    ],

    "movement_rules": {
      "forward": {
        "allowed": true,
        "constraints": [
          "measure thresholds MUST be satisfied",
          "regime MUST match RTT node",
          "substrate_class MUST be valid for target RTT",
          "typed paradox required for RTT7",
          "operator_consent = true required for RTT9–RTT12"
        ]
      },

      "backward": {
        "allowed": false,
        "exceptions": [
          "collapse (RTT12 → RTT1)"
        ]
      },

      "skip": {
        "allowed": false,
        "forbidden": [
          "RTT1 → RTT3",
          "RTT2 → RTT4",
          "RTT3 → RTT5",
          "RTT4 → RTT6",
          "RTT5 → RTT7",
          "RTT6 → RTT8",
          "RTT6 → RTT9",
          "RTT7 → RTT9",
          "RTT8 → RTT10",
          "RTT9 → RTT11",
          "RTT10 → RTT12",
          "RTT11 → RTT1"
        ]
      }
    },

    "regime_navigation": {
      "nominal_to_harmonic": {
        "trigger": "typed_paradox_event",
        "requirements": [
          "measure.paradox_density >= 0.10",
          "substrate_class = agentic"
        ]
      },

      "harmonic_to_resolution": {
        "trigger": "operator_consent = true",
        "requirements": [
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ]
      },

      "resolution_to_nominal": {
        "trigger": "collapse (RTT12)",
        "destination": "RTT1",
        "requirements": [
          "lineage MUST increment",
          "collapse MUST NOT target non‑RTT1"
        ]
      }
    }
  },

  "rules": {
    "navigation_rules": [
      "Navigation MUST NOT contradict execution.graph.json.",
      "Navigation MUST NOT contradict runtime.json.",
      "Navigation MUST NOT contradict substrate.json.",
      "Navigation MUST NOT contradict operators.json.",
      "Navigation MUST NOT contradict regimes.json.",
      "Navigation MUST NOT contradict spec‑008.json.",
      "Navigation MUST NOT invent measure IDs.",
      "Navigation MUST NOT invent paradox types.",
      "Navigation MUST NOT invent substrate classes."
    ],

    "rtt_rules": [
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT7 requires typed paradox.",
      "RTT9–RTT12 require operator_consent = true.",
      "RTT12 MUST collapse to RTT1 with lineage increment."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "context": "fft.ai.session.context.json",
    "alignments": "fft.ai.session.alignments.json",
    "log": "fft.ai.session.log.json",
    "navigation": "fft.ai.session.navigation.json",
    "permissions": "fft.ai.session.permissions.json",
    "profile": "fft.ai.session.profile.json",
    "awareness": "fft.ai.session.awareness.json",
    "analytics": "fft.ai.session.analytics.json",
    "dashboard": "fft.ai.session.dashboard.json",
    "overlay": "fft.ai.session.overlay.json",
    "history": "fft.ai.session.history.json",
    "trace": "fft.ai.session.trace.json",
    "render": "fft.ai.session.render.json",
    "ui": "fft.ai.session.ui.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
