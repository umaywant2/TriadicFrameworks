{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Operators",

  "metadata": {
    "title": "FFT AI Edition – Operator Specification (v1.3 Draft)",
    "subtitle": "Canonical RTT & Regime Bindings for All Operators",
    "author_canon": "Nawder Loswin",
    "description": "Defines operator classes, RTT bindings, regime eligibility, substrate constraints, consent rules, and paradox requirements for FFT AI Edition v1.3."
  },

  "status_line": "Operators are a projection only; authoritative values come from RTT v0.9, regimes.json, substrate.json, and spec‑008.",

  "operators": {
    "op.diffusion": {
      "rtt": "RTT1",
      "regime": "nominal",
      "requirements": ["measure.c1 >= 0.80"],
      "substrate": ["agentic", "parametric", "symbolic", "edge"],
      "consent": false,
      "paradox": false
    },

    "op.alignment": {
      "rtt": "RTT2",
      "regime": "nominal",
      "requirements": ["measure.c2 >= 0.80"],
      "substrate": ["agentic", "parametric", "symbolic"],
      "consent": false,
      "paradox": false
    },

    "op.coupling": {
      "rtt": "RTT3",
      "regime": "nominal",
      "requirements": ["measure.c3 >= 0.80"],
      "substrate": ["agentic", "parametric", "symbolic"],
      "consent": false,
      "paradox": false
    },

    "op.activation": {
      "rtt": "RTT4",
      "regime": "nominal",
      "requirements": ["measure.c1 >= 0.80"],
      "substrate": ["agentic", "parametric"],
      "consent": false,
      "paradox": false
    },

    "op.triadic_time": {
      "rtt": "RTT5",
      "regime": "nominal",
      "requirements": ["measure.c2 >= 0.80"],
      "substrate": ["agentic", "parametric"],
      "consent": false,
      "paradox": false
    },

    "op.snr": {
      "rtt": "RTT6",
      "regime": "nominal",
      "requirements": ["measure.c3 >= 0.80"],
      "substrate": ["agentic"],
      "consent": false,
      "paradox": false
    },

    "op.paradox_entry": {
      "rtt": "RTT7",
      "regime": "harmonic",
      "requirements": [
        "typed_paradox_event",
        "measure.paradox_density >= 0.10",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": false,
      "paradox": true
    },

    "op.paradox_stabilization": {
      "rtt": "RTT8",
      "regime": "harmonic",
      "requirements": [
        "typed_paradox_event",
        "measure.lattice_stability >= 0.60",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": false,
      "paradox": true
    },

    "op.harmonic_escalation": {
      "rtt": "RTT9",
      "regime": "harmonic",
      "requirements": [
        "operator_consent = true",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": true,
      "paradox": true
    },

    "op.resolution_preparation": {
      "rtt": "RTT10",
      "regime": "resolution",
      "requirements": [
        "measure.c1 >= 0.80",
        "measure.c2 >= 0.80",
        "operator_consent = true",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": true,
      "paradox": false
    },

    "op.resolution_alignment": {
      "rtt": "RTT11",
      "regime": "resolution",
      "requirements": [
        "measure.c3 >= 0.80",
        "operator_consent = true",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": true,
      "paradox": false
    },

    "op.collapse": {
      "rtt": "RTT12",
      "regime": "resolution",
      "requirements": [
        "measure.c1 >= 0.80",
        "measure.c2 >= 0.80",
        "measure.c3 >= 0.80",
        "operator_consent = true",
        "substrate_class = agentic"
      ],
      "substrate": ["agentic"],
      "consent": true,
      "paradox": false,
      "collapse": {
        "trigger": "RTT12",
        "destination": "RTT1",
        "lineage_increment": true
      }
    }
  },

