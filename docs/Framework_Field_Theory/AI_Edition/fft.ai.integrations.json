{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Integrations",

  "metadata": {
    "title": "FFT AI Edition – Integrations (v1.3)",
    "subtitle": "External System Integration Envelope for RTT • Regimes • Operators • Substrate",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical external integration model for FFT AI Edition v1.3."
  },

  "status_line": "Integrations are projections only; authoritative values come from runtime, substrate, operators, regimes, and session.state.",

  "integrations": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "integration_modes": {
      "readers": {
        "enabled": true,
        "module": "fft.ai.reader.json",
        "constraints": [
          "Reader MUST respect RTT node.",
          "Reader MUST NOT invent measures.",
          "Reader MUST NOT override paradox state.",
          "Reader MUST NOT contradict substrate class."
        ]
      },

      "operators": {
        "enabled": true,
        "module": "fft.ai.operators.json",
        "constraints": [
          "Operator MUST match RTT node.",
          "Operator MUST respect consent gating.",
          "Operator MUST respect substrate class.",
          "Operator MUST NOT invent measure IDs."
        ]
      },

      "regimes": {
        "enabled": true,
        "module": "fft.ai.regimes.json",
        "constraints": [
          "Regime MUST match RTT node.",
          "Regime transitions MUST respect typed paradox.",
          "Regime transitions MUST respect lattice stability thresholds."
        ]
      },

      "substrate": {
        "enabled": true,
        "module": "fft.ai.substrate.json",
        "constraints": [
          "Harmonic escalation requires substrate_class = agentic.",
          "Non-agentic harmonic escalation forbidden.",
          "Non-agentic resolution forbidden."
        ]
      },

      "validation": {
        "enabled": true,
        "module": "fft.validation.json",
        "constraints": [
          "Validation MUST enforce measure IDs.",
          "Validation MUST enforce collapse rules.",
          "Validation MUST enforce consent rules.",
          "Validation MUST enforce paradox rules."
        ]
      },

      "runtime": {
        "enabled": true,
        "module": "fft.ai.runtime.json",
        "constraints": [
          "Runtime MUST enforce RTT12 collapse.",
          "Runtime MUST enforce lineage increment after collapse.",
          "Runtime MUST enforce substrate gating."
        ]
      },

      "execution_graph": {
        "enabled": true,
        "module": "fft.ai.execution.graph.json",
        "constraints": [
          "Execution graph MUST respect RTT node.",
          "Execution graph MUST respect operator constraints.",
          "Execution graph MUST NOT contradict session.state."
        ]
      },

      "discovery": {
        "enabled": true,
        "module": "fft.ai.discovery.json",
        "constraints": [
          "Discovery MUST NOT invent modules.",
          "Discovery MUST respect manifest and registry.",
          "Discovery MUST NOT contradict spec-008."
        ]
      },

      "capabilities": {
        "enabled": true,
        "module": "fft.ai.capabilities.json",
        "constraints": [
          "Capabilities MUST reflect substrate class.",
          "Capabilities MUST reflect consent state.",
          "Capabilities MUST reflect paradox state."
        ]
      }
    }
  },

  "rules": {
    "integration_rules": [
      "Integrations MUST NOT contradict session.state.json.",
      "Integrations MUST NOT contradict substrate.json.",
      "Integrations MUST NOT contradict operators.json.",
      "Integrations MUST NOT contradict regimes.json.",
      "Integrations MUST NOT contradict spec-008.json.",
      "Integrations MUST NOT invent measure IDs.",
      "Integrations MUST NOT invent paradox types.",
      "Integrations MUST NOT invent substrate classes."
    ],

    "rtt_rules": [
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT7 requires typed paradox.",
      "RTT9–RTT12 require operator_consent = true.",
      "RTT12 MUST collapse to RTT1 with lineage increment."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "context": "fft.ai.session.context.json",
    "alignments": "fft.ai.session.alignments.json",
    "log": "fft.ai.session.log.json",
    "navigation": "fft.ai.session.navigation.json",
    "permissions": "fft.ai.session.permissions.json",
    "profile": "fft.ai.session.profile.json",
    "awareness": "fft.ai.session.awareness.json",
    "analytics": "fft.ai.session.analytics.json",
    "dashboard": "fft.ai.session.dashboard.json",
    "overlay": "fft.ai.session.overlay.json",
    "history": "fft.ai.session.history.json",
    "trace": "fft.ai.session.trace.json",
    "render": "fft.ai.session.render.json",
    "ui": "fft.ai.session.ui.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
