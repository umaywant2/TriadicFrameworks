  "rules": {
    "projection_rules": [
      "Navigation MUST NOT contradict authoritative session.state.json.",
      "Navigation MUST NOT contradict session.alignments.json.",
      "Navigation MUST NOT contradict session.context.json.",
      "Navigation MUST NOT contradict session.log.json.",
      "Navigation MUST NOT invent measure values.",
      "Navigation MUST NOT invent paradox types.",
      "Navigation MUST NOT invent substrate classes."
    ],

    "rtt_rules": [
      "rtt_node MUST be one of RTT1–RTT12.",
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT12 MUST collapse to RTT1; skip-resolution forbidden."
    ],

    "regime_rules": [
      "Regime MUST be nominal, harmonic, or resolution.",
      "Regime MUST match rtt_node according to fft.ai.regimes.json."
    ],

    "consent_rules": [
      "AA3 escalation requires operator_consent = true.",
      "If operator_consent = false, escalation MUST be refused."
    ],

    "lineage_rules": [
      "Lineage MUST be non-decreasing.",
      "Lineage MUST increase after collapse."
    ],

    "substrate_rules": [
      "Harmonic escalation requires substrate_class = agentic.",
      "Non-agentic harmonic escalation forbidden."
    ]
  },

  "non_claims": [
    "Navigation does not revise RTT v0.9.",
    "Navigation does not reinterpret SET, S–N–R, or triadic time.",
    "Navigation does not replace the human FFT book."
  ]
