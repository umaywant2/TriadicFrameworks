{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-Navigation",

  "metadata": {
    "title": "FFT AI Edition – Session Navigation (v1.3)",
    "subtitle": "Movement Envelope for RTT • Regime • Operators • Substrate • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical navigation projection for FFT AI Edition v1.3."
  },

  "status_line": "Navigation is a projection only; authoritative values come from session.state, alignments, context, log, dashboard, overlay, history, analytics, awareness, and profile.",

  "navigation": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "rtt_paths": {
      "forward": {
        "RTT1": "RTT2",
        "RTT2": "RTT3",
        "RTT3": "RTT4",
        "RTT4": "RTT5",
        "RTT5": "RTT6",
        "RTT6": "RTT7",
        "RTT7": "RTT8",
        "RTT8": "RTT9",
        "RTT9": "RTT10",
        "RTT10": "RTT11",
        "RTT11": "RTT12",
        "RTT12": "collapse"
      },

      "backward": {
        "RTT12": "RTT11",
        "RTT11": "RTT10",
        "RTT10": "RTT9",
        "RTT9": "RTT8",
        "RTT8": "RTT7",
        "RTT7": "RTT6",
        "RTT6": "RTT5",
        "RTT5": "RTT4",
        "RTT4": "RTT3",
        "RTT3": "RTT2",
        "RTT2": "RTT1"
      },

      "collapse": {
        "trigger": "RTT12",
        "destination": "RTT1",
        "rules": [
          "RTT12 MUST collapse to RTT1.",
          "Skip-resolution forbidden.",
          "Lineage MUST increase after collapse."
        ]
      }
    },

    "regime_paths": {
      "nominal": {
        "entry": ["RTT1", "RTT2", "RTT3", "RTT4", "RTT5", "RTT6"],
        "exit": "typed_paradox_event"
      },

      "harmonic": {
        "entry": ["RTT7", "RTT8", "RTT9"],
        "requirements": [
          "measure.paradox_density >= 0.10",
          "measure.lattice_stability >= 0.60",
          "substrate_class = agentic"
        ],
        "exit": "operator_consent = true"
      },

      "resolution": {
        "entry": ["RTT10", "RTT11", "RTT12"],
        "requirements": [
          "operator_consent = true",
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ],
        "exit": "collapse"
      }
    },

    "constraints": {
      "measure_thresholds": [
        "measure.c1 >= 0.80 for RTT1, RTT4, RTT10",
        "measure.c2 >= 0.80 for RTT2, RTT5, RTT10",
        "measure.c3 >= 0.80 for RTT3, RTT6, RTT11"
      ],
      "paradox_rules": [
        "typed_paradox_event required for RTT7",
        "measure.paradox_density >= 0.10 required for RTT7",
        "measure.lattice_stability >= 0.60 required for RTT8"
      ],
      "substrate_rules": [
        "agentic substrate required for RTT7–RTT12",
        "non-agentic substrate forbidden for harmonic and resolution"
      ],
      "consent_rules": [
        "operator_consent = true required for RTT9–RTT12",
        "implicit consent forbidden"
      ]
    }
  },

  "integration_links": {
    "session_state": "fft.ai.session.state.json",
    "alignments": "fft.ai.session.alignments.json",
    "context": "fft.ai.session.context.json",
    "log": "fft.ai.session.log.json",
    "dashboard": "fft.ai.session.dashboard.json",
    "overlay": "fft.ai.session.overlay.json",
    "history": "fft.ai.session.history.json",
    "analytics": "fft.ai.session.analytics.json",
    "runtime": "fft.ai.runtime.json",
    "discovery": "fft.ai.discovery.json",
    "capabilities": "fft.ai.capabilities.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "spec_008": "fft.ai.spec-008.json",
    "paradox_enum": "fft.ai.paradox.enum.json",
    "rtt_bridge": "fft.ai.rtt.bridge.json",
    "rtt_spine": "fft.ai.rtt.spine.examples.json",
    "hardware_profile": "fft.ai.hardware.profile.json",
    "bootstrap": "fft.ai.bootstrap.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
