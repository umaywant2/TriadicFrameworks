{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-Context",

  "metadata": {
    "title": "FFT AI Edition – Session Context (v1.3)",
    "subtitle": "State • Alignments • Regime • RTT • Paradox • Consent • Substrate • Lineage",
    "author_canon": "Nawder Loswin",
    "description": "Defines the authoritative contextual envelope for FFT AI Edition v1.3 sessions."
  },

  "status_line": "Session context MUST unify state, alignments, regime, RTT mapping, paradox, consent, substrate, lineage, and collapse.",

  "context": {
    "session_id": "inherit-from-session.state",

    "rtt_node": "RTT1",
    "regime": "nominal",
    "substrate_class": "agentic",
    "operator": "op.diffusion",
    "operator_consent": false,
    "lineage": 1,

    "measures": {
      "measure.c1": 0.80,
      "measure.c2": 0.80,
      "measure.c3": 0.80,
      "measure.paradox_density": 0.00,
      "measure.lattice_stability": 1.00
    },

    "paradox": {
      "typed_paradox_events": [],
      "paradox_density": 0.00,
      "status": "none"
    },

    "collapse_state": null,

    "alignment_links": {
      "state_file": "fft.ai.session.state.json",
      "alignments_file": "fft.ai.session.alignments.json",
      "log_file": "fft.ai.session.log.json"
    },

    "rtt_links": {
      "bridge_file": "fft.ai.rtt.bridge.json",
      "spec_file": "fft.ai.spec-008.json",
      "regimes_file": "fft.ai.regimes.json"
    },

    "timestamps": {
      "created": "auto",
      "last_update": "auto"
    }
  },

  "rules": {
    "context_rules": [
      "Context MUST NOT contradict session.state.json.",
      "Context MUST NOT contradict session.alignments.json.",
      "Context MUST NOT contradict session.log.json."
    ],

    "rtt_rules": [
      "rtt_node MUST be one of RTT1–RTT12.",
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT12 MUST collapse to RTT1; skip-resolution forbidden."
    ],

    "regime_rules": [
      "Regime MUST match rtt_node according to fft.ai.regimes.json.",
      "Nominal regime allowed only for RTT1–RTT6.",
      "Harmonic regime allowed only for RTT7–RTT9.",
      "Resolution regime allowed only for RTT10–RTT12."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  }
}
