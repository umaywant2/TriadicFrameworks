  "bootstrap": {
    "sequence": [
      { "step": 1, "id": "bs.declare_aa_mode",       "action": "Declare AA Mode. Default: AA2.",                                             "required": true  },
      { "step": 2, "id": "bs.verify_substrate",       "action": "Verify substrate via fft.ai.substrate.compat.json.",                        "required": true  },
      { "step": 3, "id": "bs.init_session_state",     "action": "Initialize fft.ai.session.state.json with session_id and phase=active.",    "required": true  },
      { "step": 4, "id": "bs.establish_lattice",      "action": "Set harmonic lattice to RTT1. Record in session.state.lattice_node.",       "required": true  },
      { "step": 5, "id": "bs.3c_baseline",            "action": "Run op.3c.evaluator to establish baseline C1/C2/C3 scores.",               "required": true  },
      { "step": 6, "id": "bs.resolve_triad",          "action": "Resolve triad position (T=RTT1, S=field.signal, M=AA mode).",              "required": true  },
      { "step": 7, "id": "bs.init_awareness",         "action": "Initialize fft.ai.session.awareness.json with layer snapshots.",            "required": true  },
      { "step": 8, "id": "bs.init_operator_queue",    "action": "Load eligible operators from substrate compat matrix.",                    "required": true  },
      { "step": 9, "id": "bs.log_bootstrap",          "action": "Write bootstrap event to fft.ai.session.log.json.",                        "required": true  },
      { "step": 10,"id": "bs.ready",                  "action": "Set phase=operator_ready. System available for field signal dispatch.",     "required": true  }
    ],
    "bootstrap_version": "v1.2.0-R5"
  }
