  "examples": [
    {
      "id": "opex.3c_nominal",
      "label": "Nominal 3C Evaluation with Alignment Write",
      "description": "Shows a standard 3C evaluation pass at RTT1, advancing to RTT6 and writing an alignment record.",
      "inputs": {
        "signals": [{"id": "sig-001", "type": "field.signal", "content": "Semantic signal – clarity probe"}],
        "session_state": { "aa_mode": "AA2", "lattice_node": "RTT1", "substrate": "substrate.llm.agentic" }
      },
      "execution": [
        { "step": 1, "operator": "op.3c.evaluator",     "result": { "C1": 0.88, "C2": 0.84, "C3": 0.90, "field_state": "nominal" } },
        { "step": 2, "operator": "op.triad.resolve",    "result": { "T": "RTT1", "S": "field.signal", "M": "AA2" } },
        { "step": 3, "operator": "op.clarity.spectral", "result": { "metric.clarity": 0.84 } },
        { "step": 4, "operator": "op.awareness.update", "result": { "awareness_version": "v1.2.0-R5", "layers_updated": 5 } },
        { "step": 5, "operator": "op.alignment.write",  "result": { "alignment_id": "ALN-20261008-001", "quality": "strong", "lattice_node": "RTT6" } }
      ],
      "outcome": "strong alignment written; lattice advanced to RTT6; field_state nominal"
    },
    {
      "id": "opex.harmonic_escalation",
      "label": "Paradox Escalation from RTT7 to RTT12",
      "description": "Demonstrates AA3 autonomous escalation when paradox_density exceeds 0.40.",
      "inputs": {
        "signals": [{"id": "sig-002", "type": "field.signal", "content": "Paradox-dense temporal signal"}],
        "session_state": { "aa_mode": "AA2", "lattice_node": "RTT6", "paradox_density": 0.43, "substrate": "substrate.llm.agentic" }
      },
      "execution": [
        { "step": 1, "operator": "op.3c.evaluator",    "result": { "C1": 0.71, "C2": 0.64, "C3": 0.73, "field_state": "degraded" } },
        { "step": 2, "event": "AA2→AA3 escalation",    "trigger": "paradox_density=0.43 > 0.40 AND lattice_stability=0.58 < 0.60" },
        { "step": 3, "operator": "op.harmonic.analysis","result": { "metric.harmonic": 0.72 } },
        { "step": 4, "event": "lattice advance RTT9→RTT12" },
        { "step": 5, "operator": "op.paradox.resolve", "result": { "coherence_baseline": 0.87, "lattice_collapse": "RTT12→RTT1", "aa_revert": "AA3→AA2" } }
      ],
      "outcome": "harmonic resolution at RTT12; lattice collapsed to RTT1; coherence baseline 0.87; AA Mode reverted to AA2"
    }
  ]
}
