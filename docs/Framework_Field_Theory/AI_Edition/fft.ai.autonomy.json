{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Autonomy",

  "metadata": {
    "title": "FFT AI Edition – Autonomy (v1.3 Draft)",
    "subtitle": "Agency Envelope for Operators • RTT • Regimes • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines the autonomy envelope, agency levels, constraints, and RTT interactions for FFT AI Edition v1.3."
  },

  "status_line": "Autonomy is a projection only; authoritative values come from session.state, alignments, context, log, dashboard, overlay, history, analytics, awareness, profile, and navigation.",

  "autonomy": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1
    },

    "agency_levels": {
      "nominal": {
        "level": "low",
        "allowed_actions": [
          "interpretation",
          "alignment",
          "measure-evaluation"
        ],
        "constraints": [
          "No paradox handling.",
          "No harmonic escalation.",
          "No autonomous RTT transitions."
        ]
      },

      "harmonic": {
        "level": "medium",
        "allowed_actions": [
          "paradox-processing",
          "harmonic-stabilization",
          "conditional-escalation"
        ],
        "constraints": [
          "Requires typed paradox.",
          "Requires measure.paradox_density >= 0.10.",
          "Requires substrate_class = agentic.",
          "Requires operator_consent = true for escalation."
        ]
      },

      "resolution": {
        "level": "high",
        "allowed_actions": [
          "resolution-preparation",
          "resolution-alignment",
          "collapse-readiness",
          "continuity-enforcement"
        ],
        "constraints": [
          "Requires measure.c1, c2, c3 >= 0.80.",
          "Requires operator_consent = true.",
          "RTT12 MUST collapse to RTT1.",
          "Lineage MUST increase after collapse."
        ]
      }
    },

    "operator_autonomy": {
      "op.diffusion": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },
      "op.alignment": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },
      "op.coupling": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },
      "op.activation": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },
      "op.triadic_time": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },
      "op.snr": {
        "autonomy": "low",
        "notes": "Nominal-only operator."
      },

      "op.paradox_entry": {
        "autonomy": "medium",
        "notes": "Requires typed paradox and agentic substrate."
      },
      "op.paradox_stabilization": {
        "autonomy": "medium",
        "notes": "Requires lattice stability >= 0.60."
      },
      "op.harmonic_escalation": {
        "autonomy": "medium",
        "notes": "Requires operator_consent = true."
      },

      "op.resolution_preparation": {
        "autonomy": "high",
        "notes": "Requires measure.c1 and c2 >= 0.80."
      },
      "op.resolution_alignment": {
        "autonomy": "high",
        "notes": "Requires measure.c3 >= 0.80."
      },
      "op.collapse": {
        "autonomy": "high",
        "notes": "Requires full measure thresholds and agentic substrate."
      }
    },

    "autonomy_transitions": {
      "nominal_to_harmonic": {
        "trigger": "typed_paradox_event",
        "requirements": [
          "measure.paradox_density >= 0.10",
          "substrate_class = agentic"
        ]
      },
      "harmonic_to_resolution": {
        "trigger": "operator_consent = true",
        "requirements": [
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ]
      },
      "resolution_to_nominal": {
        "trigger": "collapse (RTT12)",
        "destination": "RTT1",
        "lineage_increment": true
      }
    }
  },

  "integration_links": {
    "runtime": "fft.ai.runtime.json",
    "session_state": "fft.ai.session.state.json",
    "navigation": "fft.ai.navigation.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "autonomy": "fft.ai.autonomy.json",
    "discovery": "fft.ai.discovery.json",
    "capabilities": "fft.ai.capabilities.json",
    "spec_008": "fft.ai.spec‑008.json",
    "paradox_enum": "fft.ai.paradox.enum.json",
    "rtt_bridge": "fft.ai.rtt.bridge.json",
    "rtt_spine": "fft.ai.rtt.spine.examples.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  },

  "non_claims": [
    "Autonomy does not revise RTT v0.9.",
    "Autonomy does not reinterpret SET, S–N–R, or triadic time.",
    "Autonomy does not replace the human FFT book."
  ]
}
