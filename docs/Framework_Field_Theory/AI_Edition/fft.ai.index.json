      "session": [
        "fft.ai.session.state.json",
        "fft.ai.session.state.refresh.json",
        "fft.ai.session.context.json",
        "fft.ai.session.alignments.json",
        "fft.ai.session.log.json",
        "fft.ai.session.history.json",
        "fft.ai.session.navigation.json",
        "fft.ai.session.permissions.json",
        "fft.ai.session.profile.json",
        "fft.ai.session.awareness.json",
        "fft.ai.session.analytics.json",
        "fft.ai.session.dashboard.json",
        "fft.ai.session.overlay.json",
        "fft.ai.session.ui.json",
        "fft.ai.session.trace.json",
        "fft.ai.session.render.json"
      ],

      "examples": [
        "fft.examples.json"
      ],

      "edition": [
        "fft.ai.index.json",
        "fft.ai.readme.json"
      ]
    },

    "load_order": [
      "core",
      "specifications",
      "substrate",
      "operators",
      "regimes",
      "rtt",
      "runtime",
      "session",
      "examples",
      "edition"
    ],

    "integration_map": {
      "state": "fft.ai.session.state.json",
      "context": "fft.ai.session.context.json",
      "alignments": "fft.ai.session.alignments.json",
      "log": "fft.ai.session.log.json",
      "history": "fft.ai.session.history.json",
      "analytics": "fft.ai.session.analytics.json",
      "navigation": "fft.ai.session.navigation.json",
      "permissions": "fft.ai.session.permissions.json",
      "profile": "fft.ai.session.profile.json",
      "awareness": "fft.ai.session.awareness.json",
      "dashboard": "fft.ai.session.dashboard.json",
      "overlay": "fft.ai.session.overlay.json",
      "ui": "fft.ai.session.ui.json",
      "trace": "fft.ai.session.trace.json",
      "render": "fft.ai.session.render.json"
    }
  },

  "rules": {
    "index_rules": [
      "Index MUST list all modules.",
      "Index MUST NOT invent module names.",
      "Index MUST NOT omit session-layer modules.",
      "Index MUST NOT contradict manifest.json.",
      "Index MUST NOT contradict registry.json."
    ],

    "load_rules": [
      "Load order MUST begin with core.",
      "Session-layer MUST load after runtime.",
      "Render MUST load last."
    ]
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
