{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Index",

  "metadata": {
    "title": "FFT AI Edition – Index (v1.3)",
    "subtitle": "Root Registry for All FFT AI Edition Modules",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical index and load order for FFT AI Edition v1.3."
  },

  "status_line": "Index is the root registry; all modules MUST appear here.",

  "index": {
    "session_id": "inherit-from-session.state",

    "modules": {
      "core": [
        "fft.ai.core.json",
        "fft.ai.core_v1_2_.json",
        "fft.core.json",
        "fft.invariant.json",
        "fft.structures.json",
        "fft.metadata.json"
      ],

      "specifications": [
        "fft.ai.spec.json",
        "fft.ai.spec-008.json",
        "fft.ai.manifest.json",
        "fft.validation.json"
      ],

      "substrate": [
        "fft.ai.substrate.json",
        "fft.ai.substrate.bridge.json",
        "fft.ai.substrate.compat.json",
        "fft.ai.substrate.lattice.json",
        "fft.ai.substrate.matrix.json"
      ],

      "operators": [
        "fft.ai.operators.json",
        "fft.operator.example.json",
        "fft.operator.port.json"
      ],

      "regimes": [
        "fft.ai.regimes.json",
        "fft.regimes.json"
      ],

      "rtt": [
