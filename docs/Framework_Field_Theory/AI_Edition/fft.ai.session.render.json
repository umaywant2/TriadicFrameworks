{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-Render",

  "metadata": {
    "title": "FFT AI Edition – Session Render (v1.3)",
    "subtitle": "Unified Presentation Layer for RTT • Regime • Measures • Paradox • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical rendering envelope for FFT AI Edition v1.3 sessions."
  },

  "status_line": "Render is a projection only; authoritative values come from all session-layer modules.",

  "render": {
    "session_id": "inherit-from-session.state",

    "header": {
      "title": "FFT AI Edition — Session",
      "rtt_node": "RTT1",
      "regime": "nominal",
      "substrate_class": "agentic",
      "operator": "op.diffusion",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "panels": {
      "state": {
        "title": "State",
        "source": "fft.ai.session.state.json"
      },
      "context": {
