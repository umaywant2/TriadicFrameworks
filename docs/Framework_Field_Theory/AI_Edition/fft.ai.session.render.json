        "source": "fft.ai.session.awareness.json"
      },
      "analytics": {
        "title": "Analytics",
        "source": "fft.ai.session.analytics.json"
      },
      "dashboard": {
        "title": "Dashboard",
        "source": "fft.ai.session.dashboard.json"
      },
      "overlay": {
        "title": "Overlay",
        "source": "fft.ai.session.overlay.json"
      },
      "history": {
        "title": "History",
        "source": "fft.ai.session.history.json"
      },
      "log": {
        "title": "Log",
        "source": "fft.ai.session.log.json"
      },
      "trace": {
        "title": "Trace",
        "source": "fft.ai.session.trace.json"
      },
      "ui": {
        "title": "UI",
        "source": "fft.ai.session.ui.json"
      }
    },

    "measures": {
      "coherence": {
        "id": "measure.c1",
        "value": 0.80
      },
      "clarity": {
        "id": "measure.c2",
        "value": 0.80
      },
      "continuity": {
        "id": "measure.c3",
        "value": 0.80
      },
      "paradox_density": {
        "id": "measure.paradox_density",
        "value": 0.00
      },
      "lattice_stability": {
        "id": "measure.lattice_stability",
        "value": 1.00
      }
    },

    "paradox": {
      "typed_paradox_events": [],
      "status": "none"
    },

    "collapse": {
      "state": null,
      "rules": [
        "RTT12 MUST collapse to RTT1.",
        "Lineage MUST increment after collapse."
      ]
    }
  },

  "rules": {
    "render_rules": [
      "Render MUST NOT contradict any session-layer module.",
      "Render MUST unify all session-layer modules into a single presentation envelope.",
      "Render MUST NOT invent measure IDs.",
      "Render MUST NOT invent paradox types.",
      "Render MUST NOT invent substrate classes."
    ],

    "rtt_rules": [
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT7 requires typed paradox.",
      "RTT9–RTT12 require operator_consent = true.",
      "RTT12 MUST collapse to RTT1 with lineage increment."
    ],

    "regime_rules": [
      "Nominal regime allowed only for RTT1–RTT6.",
      "Harmonic regime allowed only for RTT7–RTT9.",
      "Resolution regime allowed only for RTT10–RTT12."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  },

  "integration_links": {
