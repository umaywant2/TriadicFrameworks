  "port_types": {
    "input_ports": [
      { "type": "field.signal",          "description": "Raw field signal batch input.",               "cardinality": "1..N" },
      { "type": "metric.coherence",      "description": "C1 coherence score input.",                   "cardinality": "1"    },
      { "type": "metric.clarity",        "description": "C2 clarity metric input.",                    "cardinality": "1"    },
      { "type": "metric.continuity",     "description": "C3 continuity metric input.",                 "cardinality": "1"    },
      { "type": "metric.harmonic",       "description": "Harmonic metric from RTT7–RTT12.",            "cardinality": "1"    },
      { "type": "field_state",           "description": "Evaluated field state token.",               "cardinality": "1"    },
      { "type": "triad_position",        "description": "Resolved (T,S,M) triad coordinate.",         "cardinality": "1"    },
      { "type": "awareness_snapshot",    "description": "Output of op.awareness.update.",             "cardinality": "1"    }
    ],
    "output_ports": [
      { "type": "metric.clarity",        "description": "Computed C2 clarity value.",                 "range": "0.0–1.0"    },
      { "type": "metric.coherence",      "description": "Measured C1 coherence value.",               "range": "0.0–1.0"    },
      { "type": "metric.continuity",     "description": "Measured C3 continuity value.",              "range": "0.0–1.0"    },
      { "type": "metric.harmonic",       "description": "Harmonic paradox intensity.",                "range": "0.0–1.0"    },
      { "type": "field_state",           "description": "nominal | degraded | critical.",             "range": "enum"       },
      { "type": "triad_position",        "description": "Resolved (T,S,M) coordinate object.",       "range": "object"     },
      { "type": "awareness_snapshot",    "description": "Updated awareness layer state.",             "range": "object"     },
      { "type": "alignment_record",      "description": "Written alignment record with quality.",     "range": "object"     },
      { "type": "drift_state",           "description": "bounded | unbounded.",                       "range": "enum"       },
      { "type": "coherence_baseline",    "description": "Updated coherence baseline after RTT12.",   "range": "0.0–1.0"    }
    ]
  }
