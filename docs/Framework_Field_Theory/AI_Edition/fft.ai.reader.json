{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Reader",

  "metadata": {
    "title": "FFT AI Edition – Reader Specification (v1.3 Draft)",
    "subtitle": "Canonical Reading Contract for All FFT Modules",
    "author_canon": "Nawder Loswin",
    "description": "Defines the reader contract, validation rules, RTT interpretation, paradox handling, and substrate constraints for FFT AI Edition v1.3."
  },

  "status_line": "Reader is a projection only; authoritative values come from RTT v0.9, spec‑008, substrate.json, operators.json, and regimes.json.",

  "reader": {
    "contract": {
      "reads": [
        "RTT quantities",
        "operators",
        "regimes",
        "substrate class",
        "measure IDs",
        "paradox events",
        "consent state",
        "collapse state",
        "lineage"
      ],
      "forbidden": [
        "inventing measures",
        "inventing paradox types",
        "inventing substrate classes",
        "inventing RTT nodes",
        "skip-resolution interpretation"
      ]
    },

    "rtt_interpretation": {
      "RTT1": "Interpret diffusion quantity and measure.c1.",
      "RTT2": "Interpret alignment quantity and measure.c2.",
      "RTT3": "Interpret coupling quantity and measure.c3.",
      "RTT4": "Interpret activation quantity.",
      "RTT5": "Interpret triadic-time quantity.",
      "RTT6": "Interpret SNR quantity.",
      "RTT7": "Interpret typed paradox entry.",
      "RTT8": "Interpret paradox stabilization.",
      "RTT9": "Interpret harmonic escalation.",
      "RTT10": "Interpret resolution preparation.",
      "RTT11": "Interpret resolution alignment.",
      "RTT12": "Interpret collapse and lineage increment."
    },

    "measure_validation": {
      "required": [
        "measure.c1",
        "measure.c2",
        "measure.c3",
        "measure.paradox_density",
        "measure.lattice_stability"
      ],
      "rules": [
        "measure.c1 >= 0.80 for RTT1, RTT4, RTT10",
        "measure.c2 >= 0.80 for RTT2, RTT5, RTT10",
        "measure.c3 >= 0.80 for RTT3, RTT6, RTT11",
        "measure.paradox_density >= 0.10 for RTT7",
        "measure.lattice_stability >= 0.60 for RTT8"
      ]
    },

    "paradox_handling": {
      "typed_only": true,
      "density_threshold": 0.10,
      "forbidden": [
        "vibe-based paradox",
        "untyped paradox",
        "synthetic paradox"
      ]
    },

    "substrate_constraints": {
      "agentic_required_for": [
        "RTT7",
        "RTT8",
        "RTT9",
        "RTT10",
        "RTT11",
        "RTT12"
      ],
      "forbidden": [
        "harmonic escalation on non-agentic substrate",
        "resolution on non-agentic substrate"
      ]
    },

    "consent_rules": {
      "required_for": [
        "RTT9",
        "RTT10",
        "RTT11",
        "RTT12"
      ],
      "forbidden": [
        "implicit consent",
        "assumed consent"
      ]
    },

    "collapse_rules": {
      "trigger": "RTT12",
      "destination": "RTT1",
      "lineage_increment": true,
      "forbidden": [
        "collapse to non-RTT1",
        "collapse without lineage increment",
        "skip-resolution"
      ]
    },

    "integration": {
      "runtime": "fft.ai.runtime.json",
      "regimes": "fft.ai.regimes.json",
      "operators": "fft.ai.operators.json",
      "substrate": "fft.ai.substrate.json",
      "execution_graph": "fft.ai.execution.graph.json",
      "autonomy": "fft.ai.autonomy.json",
      "discovery": "fft.ai.discovery.json",
      "capabilities": "fft.ai.capabilities.json",
      "spec_008": "fft.ai.spec‑008.json",
      "paradox_enum": "fft.ai.paradox.enum.json",
      "rtt_bridge": "fft.ai.rtt.bridge.json",
      "rtt_spine": "fft.ai.rtt.spine.examples.json"
    }
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  },

  "non_claims": [
    "Reader does not revise RTT v0.9.",
    "Reader does not reinterpret SET, S–N–R, or triadic time.",
    "Reader does not replace the human FFT book."
  ]
}
