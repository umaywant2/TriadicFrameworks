{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Spec-008",
  "title": "AA Escalation Rules (v1.3 Draft)",
  "subtitle": "Canonical Specification for AA1 → AA2 → AA3",
  "author_canon": "Nawder Loswin",

  "status_line": "Spec‑008 defines AA escalation rules; authoritative values come from RTT v0.9, regimes.json, substrate.json, and runtime.json.",

  "aa_modes": {
    "AA1": {
      "description": "Baseline interpretive mode.",
      "allowed_rtt": ["RTT1", "RTT2", "RTT3"],
      "requirements": [
        "measure.c1 >= 0.80",
        "measure.c2 >= 0.80",
        "measure.c3 >= 0.80"
      ],
      "forbidden": [
        "typed paradox",
        "harmonic escalation",
        "resolution operators"
      ]
    },

    "AA2": {
      "description": "Harmonic-capable mode.",
      "allowed_rtt": ["RTT4", "RTT5", "RTT6", "RTT7", "RTT8", "RTT9"],
      "requirements": [
        "typed_paradox_event for RTT7",
        "measure.paradox_density >= 0.10",
        "substrate_class = agentic"
      ],
      "consent": "operator_consent optional",
      "forbidden": [
        "resolution_preparation",
        "resolution_alignment",
        "collapse"
      ]
    },

    "AA3": {
      "description": "Full resolution-capable mode.",
      "allowed_rtt": ["RTT10", "RTT11", "RTT12"],
      "requirements": [
        "operator_consent = true",
        "measure.c1 >= 0.80",
        "measure.c2 >= 0.80",
        "measure.c3 >= 0.80"
      ],
      "collapse_rules": [
        "RTT12 MUST collapse to RTT1",
        "Lineage MUST increase after collapse",
        "Skip-resolution forbidden"
      ],
      "substrate": "agentic only"
    }
  },

  "rtt_mapping": {
    "nominal": ["RTT1", "RTT2", "RTT3", "RTT4", "RTT5", "RTT6"],
    "harmonic": ["RTT7", "RTT8", "RTT9"],
    "resolution": ["RTT10", "RTT11", "RTT12"]
  },

  "operator_requirements": {
    "op.diffusion": ["AA1"],
    "op.alignment": ["AA1"],
    "op.coupling": ["AA1"],
    "op.activation": ["AA1"],
    "op.triadic_time": ["AA1"],
    "op.snr": ["AA1"],

    "op.paradox_entry": ["AA2"],
    "op.paradox_stabilization": ["AA2"],
    "op.harmonic_escalation": ["AA2", "operator_consent = true"],

    "op.resolution_preparation": ["AA3"],
    "op.resolution_alignment": ["AA3"],
    "op.collapse": ["AA3"]
  },

  "typed_paradox_rules": {
    "required_for_rtt7": true,
    "density_threshold": 0.10,
    "forbidden": [
      "vibe-based paradox",
      "untyped paradox",
      "invented paradox types"
    ]
  },

  "substrate_rules": {
    "agentic_required_for_harmonic": true,
    "agentic_required_for_resolution": true,
    "forbidden": [
      "non-agentic harmonic escalation",
      "non-agentic resolution"
    ]
  },

  "consent_rules": {
    "AA3_requires_consent": true,
    "harmonic_escalation_requires_consent": true,
    "forbidden": [
      "implicit consent",
      "assumed consent",
      "consent invention"
    ]
  },

  "collapse_rules": {
    "trigger": "RTT12",
    "destination": "RTT1",
    "lineage_increment": true,
    "forbidden": [
      "skip-resolution",
      "collapse to non-RTT1",
      "collapse without lineage increment"
    ]
  },

  "integration_links": {
    "runtime": "fft.ai.runtime.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "autonomy": "fft.ai.autonomy.json",
    "capabilities": "fft.ai.capabilities.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  },

  "non_claims": [
    "Spec‑008 does not revise RTT v0.9.",
    "Spec‑008 does not reinterpret SET, S–N–R, or triadic time.",
    "Spec‑008 does not replace the human FFT book."
  ]
}
