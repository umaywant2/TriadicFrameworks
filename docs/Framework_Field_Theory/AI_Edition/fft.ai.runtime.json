{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Runtime",

  "metadata": {
    "title": "FFT AI Edition – Runtime (v1.3)",
    "subtitle": "Continuous Execution Engine for RTT • Regimes • Operators • Substrate • Paradox • Consent • Collapse",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical runtime engine, RTT transitions, validation rules, and continuous execution logic for FFT AI Edition v1.3."
  },

  "status_line": "Runtime is authoritative for RTT transitions, substrate gating, paradox gating, consent gating, collapse rules, and measure thresholds.",

  "runtime": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "rtt_transition": {
      "rules": [
        "RTT1 → RTT2",
        "RTT2 → RTT3",
        "RTT3 → RTT4",
        "RTT4 → RTT5",
        "RTT5 → RTT6",
        "RTT6 → RTT7",
        "RTT7 → RTT8",
        "RTT8 → RTT9",
        "RTT9 → RTT10",
        "RTT10 → RTT11",
        "RTT11 → RTT12",
        "RTT12 → RTT1"
      ],
      "forbidden": [
        "RTT6 → RTT8",
        "RTT6 → RTT9",
        "RTT7 → RTT9",
        "RTT8 → RTT10",
        "RTT9 → RTT11",
        "RTT10 → RTT12",
        "RTT11 → RTT1"
      ]
    },

    "measure_validation": {
      "rules": [
        "measure.c1 >= 0.80 required for RTT1, RTT4, RTT10",
        "measure.c2 >= 0.80 required for RTT2, RTT5, RTT10",
        "measure.c3 >= 0.80 required for RTT3, RTT6, RTT11"
      ]
    },

    "paradox_validation": {
      "rules": [
        "typed_paradox_event required for RTT7",
        "measure.paradox_density >= 0.10 required for RTT7",
        "measure.lattice_stability >= 0.60 required for RTT8",
        "untitled paradox forbidden"
      ]
    },

    "substrate_validation": {
      "rules": [
        "agentic substrate required for RTT7–RTT12",
        "non-agentic substrate forbidden for harmonic and resolution"
      ]
    },

    "consent_validation": {
      "rules": [
        "operator_consent = true required for RTT9–RTT12",
        "implicit consent forbidden"
      ]
    },

    "collapse_validation": {
      "rules": [
        "RTT12 MUST collapse to RTT1",
        "lineage MUST increment after collapse",
        "collapse to non-RTT1 forbidden",
        "skip-resolution forbidden"
      ]
    }
  },

  "rules": {
    "runtime_rules": [
      "Runtime MUST NOT contradict execution.graph.json.",
      "Runtime MUST NOT contradict substrate.json.",
      "Runtime MUST NOT contradict operators.json.",
      "Runtime MUST NOT contradict regimes.json.",
      "Runtime MUST NOT contradict spec‑008.json.",
      "Runtime MUST NOT invent measure IDs.",
      "Runtime MUST NOT invent paradox types.",
      "Runtime MUST NOT invent substrate classes."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "navigation": "fft.ai.session.navigation.json",
    "autonomy": "fft.ai.autonomy.json",
    "discovery": "fft.ai.discovery.json",
    "capabilities": "fft.ai.capabilities.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "paradox_enum": "fft.ai.paradox.enum.json",
    "spec_008": "fft.ai.spec-008.json"
  },

  "timestamps": {
