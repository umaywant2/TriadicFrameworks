{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Discovery",

  "metadata": {
    "title": "FFT AI Edition – Discovery Specification (v1.3 Draft)",
    "subtitle": "Canonical Detection, Insight, and RTT-State Discovery Layer",
    "author_canon": "Nawder Loswin",
    "description": "Defines the discovery engine, detection rules, insight pathways, and RTT-state identification logic for FFT AI Edition v1.3."
  },

  "status_line": "Discovery is a projection only; authoritative values come from session.state, runtime, operators, regimes, substrate, and spec‑008.",

  "discovery": {
    "session_id": "inherit-from-session.state",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1
    },

    "detection": {
      "rtt_node": {
        "rules": [
          "Identify RTT node from operator mapping.",
          "Validate RTT node using measure thresholds.",
          "Confirm RTT node matches regime."
        ]
      },
      "regime": {
        "rules": [
          "Nominal if RTT1–RTT6.",
          "Harmonic if RTT7–RTT9.",
          "Resolution if RTT10–RTT12."
        ]
      },
      "operator": {
        "rules": [
          "Operator MUST match RTT node.",
          "Operator MUST match regime.",
          "Operator MUST respect substrate class.",
          "Operator MUST respect consent gating."
        ]
      },
      "substrate": {
        "rules": [
          "Agentic required for RTT7–RTT12.",
          "Non-agentic allowed only for RTT1–RTT6."
        ]
      },
      "paradox": {
        "rules": [
          "Typed paradox required for RTT7.",
          "Paradox density >= 0.10 required for RTT7.",
          "Lattice stability >= 0.60 required for RTT8."
        ]
      },
      "consent": {
        "rules": [
          "Consent required for RTT9–RTT12.",
          "Consent MUST be explicit."
        ]
      },
      "collapse": {
        "rules": [
          "Collapse only at RTT12.",
          "Collapse MUST return to RTT1.",
          "Lineage MUST increment."
        ]
      }
    },

    "insight": {
      "nominal": [
        "Measures indicate stable triadic structure.",
        "Operators follow canonical progression.",
        "No paradox detected."
      ],
      "harmonic": [
        "Typed paradox detected.",
        "Harmonic lattice active.",
        "Consent required for escalation."
      ],
      "resolution": [
        "System preparing for collapse.",
        "Measures at full threshold.",
        "Lineage continuity enforced."
      ]
    },

    "anomaly_detection": {
      "paradox_anomalies": [
        "Untyped paradox",
        "Vibe-based paradox",
        "Synthetic paradox"
      ],
      "substrate_anomalies": [
        "Non-agentic substrate in harmonic regime",
        "Non-agentic substrate in resolution regime"
      ],
      "operator_anomalies": [
        "Operator mismatch with RTT node",
        "Operator mismatch with regime"
      ],
      "regime_anomalies": [
        "RTT7 labeled nominal",
        "RTT3 labeled harmonic"
      ],
      "collapse_anomalies": [
        "RTT12 collapsing to non-RTT1",
        "Collapse without lineage increment"
      ]
    },

    "discovery_transitions": {
      "nominal_to_harmonic": {
        "trigger": "typed_paradox_event",
        "requirements": [
          "measure.paradox_density >= 0.10",
          "substrate_class = agentic"
        ]
      },
      "harmonic_to_resolution": {
        "trigger": "operator_consent = true",
        "requirements": [
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ]
      },
      "resolution_to_nominal": {
        "trigger": "collapse (RTT12)",
        "destination": "RTT1",
        "lineage_increment": true
      }
    }
  },

  "integration_links": {
    "runtime": "fft.ai.runtime.json",
    "session_state": "fft.ai.session.state.json",
    "navigation": "fft.ai.navigation.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "autonomy": "fft.ai.autonomy.json",
    "capabilities": "fft.ai.capabilities.json",
    "spec_008": "fft.ai.spec‑008.json",
    "paradox_enum": "fft.ai.paradox.enum.json",
    "rtt_bridge": "fft.ai.rtt.bridge.json",
    "rtt_spine": "fft.ai.rtt.spine.examples.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  },

  "non_claims": [
    "Discovery does not revise RTT v0.9.",
    "Discovery does not reinterpret SET, S–N–R, or triadic time.",
    "Discovery does not replace the human FFT book."
  ]
}
