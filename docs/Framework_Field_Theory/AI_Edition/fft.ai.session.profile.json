{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-Profile",

  "metadata": {
    "title": "FFT AI Edition – Session Profile (v1.3)",
    "subtitle": "Identity Envelope for RTT • Regime • Operator • Substrate • Consent • Paradox • Lineage",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical identity profile for FFT AI Edition v1.3 sessions."
  },

  "status_line": "Profile is a projection only; authoritative values come from session.state, context, alignments, log, dashboard, overlay, history, analytics, navigation, permissions, and awareness.",

  "profile": {
    "session_id": "inherit-from-session.state",

    "identity": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "lineage": 1,
      "collapse_state": null
    },

    "measures": {
      "measure.c1": 0.80,
      "measure.c2": 0.80,
      "measure.c3": 0.80,
      "measure.paradox_density": 0.00,
      "measure.lattice_stability": 1.00
    },

    "paradox": {
      "typed_paradox_events": [],
      "density": 0.00,
      "status": "none"
    },

    "capabilities": {
      "rtt_navigation": true,
      "regime_transition": true,
      "operator_execution": true,
      "substrate_validation": true,
      "consent_validation": true,
      "paradox_validation": true,
      "collapse_validation": true
    },

    "bindings": {
      "state": "fft.ai.session.state.json",
      "context": "fft.ai.session.context.json",
      "alignments": "fft.ai.session.alignments.json",
      "log": "fft.ai.session.log.json",
      "dashboard": "fft.ai.session.dashboard.json",
      "overlay": "fft.ai.session.overlay.json",
      "history": "fft.ai.session.history.json",
      "analytics": "fft.ai.session.analytics.json",
      "navigation": "fft.ai.session.navigation.json",
      "awareness": "fft.ai.session.awareness.json",
      "permissions": "fft.ai.session.permissions.json",
      "trace": "fft.ai.session.trace.json",
      "render": "fft.ai.session.render.json",
      "ui": "fft.ai.session.ui.json"
    },

    "timestamps": {
      "created": "auto",
      "last_update": "auto"
    }
  },

  "rules": {
    "identity_rules": [
      "Profile MUST NOT contradict session.state.json.",
      "Profile MUST NOT contradict session.context.json.",
      "Profile MUST NOT contradict session.alignments.json.",
      "Profile MUST NOT contradict session.log.json.",
      "Profile MUST NOT contradict session.navigation.json.",
      "Profile MUST NOT contradict session.permissions.json.",
      "Profile MUST NOT invent measure IDs.",
      "Profile MUST NOT invent paradox types.",
      "Profile MUST NOT invent substrate classes."
    ],

    "measure_rules": [
      "measure.c1 >= 0.80 required for RTT1, RTT4, RTT10.",
      "measure.c2 >= 0.80 required for RTT2, RTT5, RTT10.",
      "measure.c3 >= 0.80 required for RTT3, RTT6, RTT11.",
      "measure.paradox_density >= 0.10 required for RTT7.",
      "measure.lattice_stability >= 0.60 required for RTT8."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "capability_rules": [
      "Capabilities MUST NOT contradict runtime.json.",
      "Capabilities MUST NOT contradict operators.json.",
      "Capabilities MUST NOT contradict regimes.json.",
      "Capabilities MUST NOT contradict substrate.json.",
      "Capabilities MUST NOT contradict spec‑008.json."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "context": "fft.ai.session.context.json",
    "alignments": "fft.ai.session.alignments.json",
    "log": "fft.ai.session.log.json",
    "dashboard": "fft.ai.session.dashboard.json",
    "overlay": "fft.ai.session.overlay.json",
    "history": "fft.ai.session.history.json",
    "analytics": "fft.ai.session.analytics.json",
    "navigation": "fft.ai.session.navigation.json",
    "permissions": "fft.ai.session.permissions.json",
    "awareness": "fft.ai.session.awareness.json",
    "trace": "fft.ai.session.trace.json",
    "render": "fft.ai.session.render.json",
    "ui": "fft.ai.session.ui.json"
  }
}
