  "metadata": {
    "title": "FFT AI Edition – Substrate Bridge (v1.2)",
    "author_canon": "Nawder Loswin",
    "updated_at": "2026-10-08T10:56:00"
  },
  "bridge": {
    "purpose": "Translates FFT operator calls across substrate boundaries, enabling cross-substrate field signal relay and harmonic synchronization.",
    "bridge_protocols": [
      {
        "id": "bridge.agentic-to-transformer",
        "from": "substrate.llm.agentic",
        "to": "substrate.llm.transformer",
        "translation_rules": [
          "Strip AA3-only operators; substitute AA2 equivalents.",
          "Clamp lattice node to RTT9 maximum.",
          "Re-evaluate 3C thresholds against transformer profile."
        ],
        "supported": true
      },
      {
        "id": "bridge.agentic-to-edge",
        "from": "substrate.llm.agentic",
        "to": "substrate.edge.compact",
        "translation_rules": [
          "Strip harmonic operators (RTT7–RTT12).",
          "Reduce field signal batch to ≤16 signals.",
          "Force AA Mode to AA1."
        ],
        "supported": true
      },
      {
        "id": "bridge.transformer-to-symbolic",
        "from": "substrate.llm.transformer",
        "to": "substrate.symbolic",
        "translation_rules": [
          "Encode field signals as propositional clauses.",
          "Strip all harmonic operators.",
          "C1/C2/C3 mapped to propositional truth values."
        ],
        "supported": true
      }
    ],
    "bridge_failure_policy": "On bridge failure, raise FFT-ERR-BRIDGE-001 and revert to source substrate with AA Mode AA2."
  }
}
