{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-State",

  "metadata": {
    "title": "FFT AI Edition – Session State (v1.3 Draft)",
    "subtitle": "Canonical Session Envelope for RTT • Regimes • Operators • Runtime",
    "author_canon": "Nawder Loswin",
    "description": "Defines the session envelope, current RTT state, regime, operator, substrate, consent, lineage, and collapse state for FFT AI Edition v1.3."
  },

  "status_line": "Session state is a projection only; authoritative values come from runtime.json, navigation.json, autonomy.json, discovery.json, and bootstrap.json.",

  "session": {
    "session_id": "auto",

    "current": {
      "rtt_node": "RTT1",
      "regime": "nominal",
      "operator": "op.diffusion",
      "substrate_class": "agentic",
      "operator_consent": false,
      "typed_paradox_event": false,
      "paradox_density": 0.00,
      "lattice_stability": 1.00,
      "lineage": 1,
      "collapse_state": null
    },

    "history": {
      "rtt_nodes": ["RTT1"],
      "operators": ["op.diffusion"],
      "regimes": ["nominal"],
      "substrate_classes": ["agentic"],
      "lineage_values": [1]
    },

    "constraints": {
      "measure_thresholds": [
        "measure.c1 >= 0.80 for RTT1, RTT4, RTT10",
        "measure.c2 >= 0.80 for RTT2, RTT5, RTT10",
        "measure.c3 >= 0.80 for RTT3, RTT6, RTT11"
      ],
      "paradox_rules": [
        "typed_paradox_event required for RTT7",
        "measure.paradox_density >= 0.10 required for RTT7",
        "measure.lattice_stability >= 0.60 required for RTT8"
      ],
      "substrate_rules": [
        "agentic substrate required for RTT7–RTT12",
        "non-agentic substrate forbidden for harmonic and resolution"
      ],
      "consent_rules": [
        "operator_consent = true required for RTT9–RTT12",
        "implicit consent forbidden"
      ],
      "collapse_rules": [
        "RTT12 MUST collapse to RTT1",
        "lineage MUST increment",
        "collapse to non-RTT1 forbidden",
        "skip-resolution forbidden"
      ]
    },

    "transition_logic": {
      "nominal_to_harmonic": {
        "trigger": "typed_paradox_event",
        "requirements": [
          "measure.paradox_density >= 0.10",
          "substrate_class = agentic"
        ]
      },
      "harmonic_to_resolution": {
        "trigger": "operator_consent = true",
        "requirements": [
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ]
      },
      "resolution_to_nominal": {
        "trigger": "collapse (RTT12)",
        "destination": "RTT1",
        "lineage_increment": true
      }
    }
  },

  "integration_links": {
    "runtime": "fft.ai.runtime.json",
    "navigation": "fft.ai.navigation.json",
    "autonomy": "fft.ai.autonomy.json",
    "discovery": "fft.ai.discovery.json",
    "capabilities": "fft.ai.capabilities.json",
    "execution_graph": "fft.ai.execution.graph.json",
    "regimes": "fft.ai.regimes.json",
    "operators": "fft.ai.operators.json",
    "substrate": "fft.ai.substrate.json",
    "hardware_profile": "fft.ai.hardware.profile.json",
    "spec_008": "fft.ai.spec-008.json",
    "paradox_enum": "fft.ai.paradox.enum.json",
    "rtt_bridge": "fft.ai.rtt.bridge.json",
    "rtt_spine": "fft.ai.rtt.spine.examples.json",
    "bootstrap": "fft.ai.bootstrap.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  },

  "non_claims": [
    "Session state does not revise RTT v0.9.",
    "Session state does not reinterpret SET, S–N–R, or triadic time.",
    "Session state does not replace the human FFT book."
  ]
}
