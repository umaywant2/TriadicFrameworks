{
  "spec_version": "1.3.0",
  "canon_id": "FFT-AI-Session-Permissions",

  "metadata": {
    "title": "FFT AI Edition – Session Permissions (v1.3)",
    "subtitle": "Permission Envelope for RTT • Regime • Operators • Substrate • Consent",
    "author_canon": "Nawder Loswin",
    "description": "Defines the canonical permission model for FFT AI Edition v1.3 sessions."
  },

  "status_line": "Permissions are a projection only; authoritative values come from session.state, context, alignments, log, navigation, awareness, and profile.",

  "permissions": {
    "session_id": "inherit-from-session.state",

    "allowed": {
      "rtt_navigation": true,
      "regime_transition": true,
      "operator_execution": true,
      "substrate_validation": true,
      "consent_validation": true,
      "paradox_validation": true,
      "collapse_validation": true,
      "lineage_tracking": true,
      "measure_tracking": true
    },

    "restricted": {
      "harmonic_entry": {
        "requires": [
          "typed_paradox_event = true",
          "measure.paradox_density >= 0.10",
          "measure.lattice_stability >= 0.60",
          "substrate_class = agentic"
        ],
        "notes": "Harmonic regime requires typed paradox and stable lattice."
      },

      "resolution_entry": {
        "requires": [
          "operator_consent = true",
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ],
        "notes": "Resolution regime requires explicit consent and stable measures."
      },

      "collapse_execution": {
        "requires": [
          "rtt_node = RTT12",
          "operator_consent = true",
          "measure.c1 >= 0.80",
          "measure.c2 >= 0.80",
          "measure.c3 >= 0.80"
        ],
        "notes": "Collapse MUST be canonical and MUST return to RTT1."
      }
    },

    "forbidden": {
      "untyped_paradox": true,
      "implicit_consent": true,
      "assumed_consent": true,
      "non_agentic_harmonic": true,
      "non_agentic_resolution": true,
      "skip_resolution": true,
      "collapse_to_non_rtt1": true,
      "invented_measures": true,
      "invented_paradox_types": true,
      "invented_substrate_classes": true
    }
  },

  "rules": {
    "permission_rules": [
      "Permissions MUST NOT contradict session.state.json.",
      "Permissions MUST NOT contradict session.context.json.",
      "Permissions MUST NOT contradict session.alignments.json.",
      "Permissions MUST NOT contradict session.navigation.json.",
      "Permissions MUST NOT contradict session.awareness.json.",
      "Permissions MUST NOT contradict session.profile.json."
    ],

    "rtt_rules": [
      "RTT nodes MUST map to frozen RTT v0.9 quantities.",
      "RTT7 requires typed paradox.",
      "RTT9–RTT12 require operator_consent = true.",
      "RTT12 MUST collapse to RTT1 with lineage increment."
    ],

    "regime_rules": [
      "Nominal regime allowed only for RTT1–RTT6.",
      "Harmonic regime allowed only for RTT7–RTT9.",
      "Resolution regime allowed only for RTT10–RTT12."
    ],

    "substrate_rules": [
      "Agentic substrate required for RTT7–RTT12.",
      "Non-agentic substrate forbidden for harmonic and resolution."
    ],

    "paradox_rules": [
      "Typed paradox required for RTT7.",
      "Paradox density >= 0.10 required for RTT7.",
      "Lattice stability >= 0.60 required for RTT8.",
      "Untyped paradox forbidden."
    ],

    "consent_rules": [
      "operator_consent = true required for RTT9–RTT12.",
      "Implicit or assumed consent forbidden."
    ],

    "collapse_rules": [
      "RTT12 MUST collapse to RTT1.",
      "Lineage MUST increment after collapse.",
      "Collapse to non-RTT1 forbidden."
    ]
  },

  "integration_links": {
    "state": "fft.ai.session.state.json",
    "context": "fft.ai.session.context.json",
    "alignments": "fft.ai.session.alignments.json",
    "log": "fft.ai.session.log.json",
    "navigation": "fft.ai.session.navigation.json",
    "awareness": "fft.ai.session.awareness.json",
    "profile": "fft.ai.session.profile.json"
  },

  "timestamps": {
    "created": "auto",
    "last_update": "auto"
  }
}
