  "regimes": [
    {
      "id": "regime.resonance-time.core",
      "name": "Resonance-Time Core Regime",
      "class": "resonance-time",
      "lattice_node": "RTT1",
      "constraints": ["coherence=declared","drift=bounded","paradox=structural"]
    },
    {
      "id": "regime.harmonic.resonance",
      "name": "Harmonic Resonance Regime",
      "class": "harmonic",
      "lattice_node": "RTT9",
      "constraints": ["paradox=harmonic","aa_mode>=AA2"]
    }
  ],

  "invariants": [
    {
      "id": "inv.3c.field-stability",
      "name": "3C Field Stability Invariant",
      "expression": "C1(coherence) ∧ C2(clarity) ∧ C3(continuity) → field_state(nominal)",
      "scope": "global"
    },
    {
      "id": "inv.coherence.declared.bounded-drift",
      "name": "Declared Coherence Under Bounded Drift",
      "expression": "coherence(declared) ∧ drift(bounded) → stability(resonance-time)",
      "scope": "regime",
      "applies_to": ["regime.resonance-time.core"]
    }
  ],

  "operators": [
    {
      "id": "op.clarity.spectral",
      "name": "Spectral Clarity Operator",
      "inputs": ["field.signal"],
      "outputs": ["metric.clarity"],
      "conditions": ["C1 >= 0.75","drift_state == 'bounded'"]
    },
    {
      "id": "op.harmonic.analysis",
      "name": "Harmonic Analysis Operator",
      "inputs": ["field.signal"],
      "outputs": ["metric.harmonic"],
      "conditions": ["paradox_mode == 'harmonic'","lattice_node IN ['RTT7','RTT12']"]
    },
    {
      "id": "op.3c.evaluator",
      "name": "3C Condition Evaluator",
      "inputs": ["metric.coherence","metric.clarity","metric.continuity"],
      "outputs": ["field_state"],
      "conditions": ["aa_mode >= 'AA1'"]
    }
  ],

