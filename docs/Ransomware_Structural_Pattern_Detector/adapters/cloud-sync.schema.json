{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/ransomware-structural-pattern-detector/adapters/cloud-sync.schema.json",
  "title": "Ransomware Structural Pattern Detector - Cloud / Synchronization Adapter",
  "description": "Configuration and conformance schema for a cloud or synchronization adapter. The schema declares cross-environment observation, origin and transport lineage, propagation, evidence dependence, capability, containment, recovery, privacy, and verification boundaries without asserting ransomware, authority, execution success, or global resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter",
    "environment",
    "scope",
    "observation",
    "normalization",
    "lineage",
    "capabilities",
    "containment",
    "recovery",
    "verification",
    "privacy",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tf.rspd-adapter.cloud-sync/v0.1"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "observation": {
      "$ref": "#/$defs/observation"
    },
    "normalization": {
      "$ref": "#/$defs/normalization"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "containment": {
      "$ref": "#/$defs/containment"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "default": []
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "description": "Implementation-specific extension data that must not redefine canonical adapter semantics.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "supportLevel": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "unknown"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "increase_observation",
        "notify_authorized_operator",
        "deny_resource_writes",
        "contain_propagation",
        "isolate_resource_set",
        "isolate_account_scope",
        "restrict_resource_permissions",
        "suspend_synchronization",
        "preserve_evidence",
        "prepare_recovery",
        "initiate_recovery",
        "request_manual_review"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "development",
            "validation",
            "stable",
            "deprecated"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "provider_observer",
            "client_observer",
            "account_scoped",
            "resource_scoped",
            "cross_environment",
            "recovery_aware",
            "hybrid",
            "custom"
          ]
        },
        "implementation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "provider"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "cloud",
            "synchronization",
            "cloud_and_synchronization",
            "shared_resource_service",
            "mirrored_storage",
            "hybrid",
            "other"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider or implementation class. Example configurations should use a synthetic value."
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "enum": [
            "personal",
            "organizational",
            "shared",
            "multi_account",
            "multi_environment",
            "hybrid",
            "other",
            "unknown"
          ]
        },
        "region_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "resource_set",
            "container",
            "shared_space",
            "account",
            "account_set",
            "environment_set",
            "synchronization_relationship",
            "custom"
          ]
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "resource_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "environment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "includes_shared_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_historical_versions": {
          "type": "boolean",
          "default": false
        },
        "includes_recovery_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_remote_state": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "continuity"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observationSource"
          }
        },
        "continuity": {
          "type": "string",
          "enum": [
            "continuous",
            "polling",
            "snapshot",
            "resumed",
            "gapped",
            "delayed",
            "unknown"
          ]
        },
        "deduplication": {
          "type": "boolean"
        },
        "deduplication_method_ref": {
          "type": "string",
          "minLength": 1
        },
        "origin_collection": {
          "type": "boolean"
        },
        "transport_collection": {
          "type": "boolean"
        },
        "propagation_collection": {
          "type": "boolean"
        },
        "version_lineage_collection": {
          "type": "boolean"
        },
        "recovery_state_collection": {
          "type": "boolean"
        },
        "event_loss_detectable": {
          "type": "boolean"
        },
        "observation_delay_detectable": {
          "type": "boolean"
        }
      }
    },
    "observationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "provider_change_record",
            "synchronization_client",
            "resource_state",
            "resource_history",
            "version_history",
            "account_activity",
            "shared_resource_activity",
            "device_adapter",
            "recovery",
            "user_supplied",
            "custom"
          ]
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "native_name": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "direct_or_derived": {
          "type": "string",
          "enum": [
            "direct",
            "derived",
            "mixed",
            "unknown"
          ]
        },
        "delay_state": {
          "type": "string",
          "enum": [
            "real_time",
            "near_real_time",
            "delayed",
            "unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema",
        "preserve_native_operation",
        "preserve_provenance",
        "preserve_unknowns",
        "preserve_source_dependencies"
      ],
      "properties": {
        "output_schema": {
          "const": "tf.resource-transition/v0.1"
        },
        "preserve_native_operation": {
          "const": true
        },
        "preserve_provenance": {
          "const": true
        },
        "preserve_unknowns": {
          "const": true
        },
        "preserve_source_dependencies": {
          "const": true
        },
        "preserve_origin_transport_distinction": {
          "type": "boolean"
        },
        "preserve_replication_relationships": {
          "type": "boolean"
        },
        "preserve_propagation_relationships": {
          "type": "boolean"
        },
        "preserve_version_lineage": {
          "type": "boolean"
        },
        "derive_resource_class": {
          "type": "boolean"
        },
        "derive_baseline_state": {
          "type": "boolean"
        },
        "redaction_enabled": {
          "type": "boolean"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_state",
        "transport_state",
        "evidence_independence",
        "requirements"
      ],
      "properties": {
        "origin_state": {
          "type": "string",
          "enum": [
            "directly_observed",
            "inferred",
            "candidate",
            "conflicting",
            "unknown"
          ]
        },
        "transport_state": {
          "type": "string",
          "enum": [
            "directly_observed",
            "inferred",
            "candidate",
            "conflicting",
            "unknown",
            "not_applicable"
          ]
        },
        "replication_state": {
          "type": "string",
          "enum": [
            "not_observed",
            "possible",
            "observed",
            "active",
            "ceased",
            "unknown"
          ]
        },
        "propagation_state": {
          "type": "string",
          "enum": [
            "not_observed",
            "possible",
            "observed",
            "active",
            "ceased",
            "unknown"
          ]
        },
        "evidence_independence": {
          "type": "string",
          "enum": [
            "established",
            "partial",
            "not_established",
            "unknown"
          ]
        },
        "resource_identity_continuity": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_environment_correlation": {
          "$ref": "#/$defs/supportLevel"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "declaration_ref",
        "observation",
        "enforcement",
        "recovery",
        "verification"
      ],
      "properties": {
        "schema": {
          "const": "tf.platform-capabilities/v0.1"
        },
        "declaration_ref": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "$ref": "#/$defs/observationCapabilities"
        },
        "enforcement": {
          "$ref": "#/$defs/enforcementCapabilities"
        },
        "recovery": {
          "$ref": "#/$defs/recoveryCapabilities"
        },
        "verification": {
          "$ref": "#/$defs/verificationCapabilities"
        }
      }
    },
    "observationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_observation": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_identity": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_lineage": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_classification": {
          "$ref": "#/$defs/supportLevel"
        },
        "network_context": {
          "$ref": "#/$defs/supportLevel"
        },
        "origin_transport_distinction": {
          "$ref": "#/$defs/supportLevel"
        },
        "baseline_access": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_history": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_state_observation": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },
    "enforcementCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_denial": {
          "$ref": "#/$defs/supportLevel"
        },
        "propagation_containment": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_isolation": {
          "$ref": "#/$defs/supportLevel"
        },
        "account_scope_isolation": {
          "$ref": "#/$defs/supportLevel"
        },
        "permission_restriction": {
          "$ref": "#/$defs/supportLevel"
        },
        "synchronization_suspension": {
          "$ref": "#/$defs/supportLevel"
        },
        "session_termination": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },
    "recoveryCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery": {
          "$ref": "#/$defs/supportLevel"
        },
        "rollback": {
          "$ref": "#/$defs/supportLevel"
        },
        "version_restore": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_restore": {
          "$ref": "#/$defs/supportLevel"
        },
        "deleted_resource_restore": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },
    "verificationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_action_observation": {
          "$ref": "#/$defs/supportLevel"
        },
        "state_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_environment_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "persistence_detection": {
          "$ref": "#/$defs/supportLevel"
        },
        "reappearance_detection": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_schema",
        "default_authority",
        "authorization_required",
        "fallback_allowed"
      ],
      "properties": {
        "decision_schema": {
          "const": "tf.containment-decision/v0.1"
        },
        "default_authority": {
          "type": "string",
          "enum": [
            "recommend_only",
            "human_approved",
            "policy_authorized",
            "preauthorized_bounded",
            "automatic_bounded"
          ]
        },
        "authorization_required": {
          "type": "boolean"
        },
        "fallback_allowed": {
          "type": "boolean"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responseMapping"
          },
          "default": []
        }
      }
    },
    "responseMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_action",
        "capability",
        "support"
      ],
      "properties": {
        "requested_action": {
          "$ref": "#/$defs/action"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "native_mechanism_ref": {
          "type": "string",
          "minLength": 1
        },
        "response_scope": {
          "type": "string",
          "enum": [
            "resource",
            "resource_set",
            "shared_space",
            "account",
            "synchronization_relationship",
            "environment",
            "cross_environment",
            "custom",
            "unknown"
          ]
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "fully_reversible",
            "partially_reversible",
            "irreversible",
            "unknown"
          ]
        },
        "requires_additional_authorization": {
          "type": "boolean"
        },
        "fallback_action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_state_observed",
        "recovery_interference_observable"
      ],
      "properties": {
        "recovery_state_observed": {
          "type": "boolean"
        },
        "historical_versions_observed": {
          "type": "boolean"
        },
        "deleted_resource_state_observed": {
          "type": "boolean"
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recoveryMechanism"
          },
          "default": []
        },
        "recovery_interference_observable": {
          "type": "boolean"
        }
      }
    },
    "recoveryMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "support",
        "verification_supported"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "version_history",
            "deleted_resource_restore",
            "snapshot",
            "backup",
            "rollback",
            "resource_restore",
            "custom"
          ]
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "verification_supported": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema",
        "rescan_supported",
        "same_scope_comparison",
        "cross_environment_comparison",
        "preserve_limitations"
      ],
      "properties": {
        "output_schema": {
          "const": "tf.verification/v0.1"
        },
        "rescan_supported": {
          "$ref": "#/$defs/supportLevel"
        },
        "same_scope_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_environment_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "propagation_verification": {
          "$ref": "#/$defs/supportLevel"
        },
        "reappearance_detection": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        },
        "global_resolution_claim_allowed": {
          "const": false,
          "description": "A single adapter configuration must not claim universal cross-environment resolution."
        },
        "preserve_limitations": {
          "const": true
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "local_processing_preferred",
        "plaintext_credentials_allowed",
        "provider_tokens_exported"
      ],
      "properties": {
        "data_minimization": {
          "const": true
        },
        "local_processing_preferred": {
          "const": true
        },
        "plaintext_credentials_allowed": {
          "const": false
        },
        "provider_tokens_exported": {
          "const": false
        },
        "raw_resource_content_required": {
          "type": "boolean",
          "default": false
        },
        "raw_provider_identifiers_exported": {
          "type": "boolean",
          "default": false
        },
        "account_identifiers_exported": {
          "type": "boolean",
          "default": false
        },
        "device_names_exported": {
          "type": "boolean",
          "default": false
        },
        "pseudonymous_resource_ids": {
          "type": "boolean"
        },
        "pseudonymous_environment_ids": {
          "type": "boolean"
        },
        "redaction_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "informational",
            "minor",
            "material",
            "blocking"
          ]
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "created_at"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "specification_ref": {
          "type": "string",
          "default": "cloud-sync.md"
        },
        "detector_ref": {
          "type": "string",
          "default": "../detector.json"
        },
        "capabilities_schema_ref": {
          "type": "string",
          "default": "../../Shared_Structural_Event_Grammar/platform-capabilities.schema.json"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
