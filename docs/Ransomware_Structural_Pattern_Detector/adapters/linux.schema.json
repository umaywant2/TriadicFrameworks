{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/ransomware-structural-pattern-detector/adapters/linux.schema.json",
  "title": "Ransomware Structural Pattern Detector - Linux Adapter",
  "description": "Machine-readable configuration and conformance schema for a Linux adapter participating in the Ransomware Structural Pattern Detector architecture. The schema declares deployment profile, observation boundaries, native evidence sources, Linux mount, namespace and container context, normalization behavior, platform capabilities, privacy controls, containment mappings, recovery context, and verification support without asserting ransomware, authority, execution success, or resolution.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema",
    "adapter",
    "environment",
    "scope",
    "observation",
    "normalization",
    "capabilities",
    "containment",
    "recovery",
    "verification",
    "linux_context",
    "privacy",
    "provenance"
  ],

  "properties": {
    "schema": {
      "const": "tf.rspd-adapter.linux/v0.1",
      "description": "Canonical schema-family identifier and version."
    },

    "adapter": {
      "$ref": "#/$defs/adapter"
    },

    "environment": {
      "$ref": "#/$defs/environment"
    },

    "scope": {
      "$ref": "#/$defs/scope"
    },

    "observation": {
      "$ref": "#/$defs/observation"
    },

    "normalization": {
      "$ref": "#/$defs/normalization"
    },

    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },

    "containment": {
      "$ref": "#/$defs/containment"
    },

    "recovery": {
      "$ref": "#/$defs/recovery"
    },

    "verification": {
      "$ref": "#/$defs/verification"
    },

    "linux_context": {
      "$ref": "#/$defs/linuxContext"
    },

    "privacy": {
      "$ref": "#/$defs/privacy"
    },

    "limitations": {
      "type": "array",
      "description": "Known limitations of this concrete Linux adapter deployment.",
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "default": []
    },

    "provenance": {
      "$ref": "#/$defs/provenance"
    },

    "extensions": {
      "type": "object",
      "description": "Implementation-specific extension data. Extensions must not redefine canonical adapter semantics.",
      "additionalProperties": true
    }
  },

  "$defs": {
    "supportLevel": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "unknown"
      ],
      "description": "Evidence-backed support state for a declared adapter capability."
    },

    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "development",
            "validation",
            "stable",
            "deprecated"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "bounded_user_space_observer",
            "privileged_host_observer",
            "container_scoped_observer",
            "host_side_container_observer",
            "resource_scoped",
            "security_integration",
            "hybrid",
            "custom"
          ],
          "description": "Declared deployment profile. Profile selection does not itself establish capability."
        },
        "implementation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "const": "linux"
        },
        "platform_version": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86",
            "x86_64",
            "arm",
            "arm64",
            "riscv64",
            "other",
            "unknown"
          ]
        },
        "deployment": {
          "type": "string",
          "enum": [
            "workstation",
            "server",
            "virtual_machine",
            "cloud_host",
            "container",
            "container_host",
            "appliance",
            "specialized",
            "other",
            "unknown"
          ]
        }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "application",
            "resource_set",
            "directory_set",
            "mount_set",
            "filesystem_set",
            "namespace",
            "container",
            "host",
            "custom"
          ]
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "resource_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "includes_network_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_synchronized_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_container_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_recovery_resources": {
          "type": "boolean",
          "default": false
        },
        "includes_canaries": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "continuity"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observationSource"
          }
        },
        "continuity": {
          "type": "string",
          "enum": [
            "continuous",
            "resumed",
            "gapped",
            "snapshot",
            "unknown"
          ]
        },
        "deduplication": {
          "type": "boolean"
        },
        "deduplication_method_ref": {
          "type": "string",
          "minLength": 1
        },
        "actor_lineage_collection": {
          "type": "boolean"
        },
        "recovery_state_collection": {
          "type": "boolean"
        },
        "network_context_collection": {
          "type": "boolean"
        },
        "synchronization_context_collection": {
          "type": "boolean"
        },
        "container_context_collection": {
          "type": "boolean"
        },
        "mount_context_collection": {
          "type": "boolean"
        },
        "event_loss_detectable": {
          "type": "boolean"
        }
      }
    },

    "observationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "filesystem",
            "filesystem_permission",
            "resource_state",
            "process",
            "service",
            "network",
            "recovery",
            "synchronization",
            "container",
            "host",
            "security_integration",
            "user_supplied",
            "custom"
          ]
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "native_name": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "direct_or_derived": {
          "type": "string",
          "enum": [
            "direct",
            "derived",
            "mixed",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },

    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema",
        "preserve_native_operation",
        "preserve_provenance",
        "preserve_unknowns"
      ],
      "properties": {
        "output_schema": {
          "const": "tf.resource-transition/v0.1"
        },
        "preserve_native_operation": {
          "const": true
        },
        "preserve_provenance": {
          "const": true
        },
        "preserve_unknowns": {
          "const": true
        },
        "preserve_origin_transport_distinction": {
          "type": "boolean"
        },
        "preserve_source_dependencies": {
          "type": "boolean"
        },
        "preserve_namespace_context": {
          "type": "boolean"
        },
        "preserve_mount_context": {
          "type": "boolean"
        },
        "derive_resource_class": {
          "type": "boolean"
        },
        "derive_baseline_state": {
          "type": "boolean"
        },
        "redaction_enabled": {
          "type": "boolean"
        }
      }
    },

    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "declaration_ref",
        "observation",
        "enforcement",
        "recovery",
        "verification"
      ],
      "properties": {
        "schema": {
          "const": "tf.platform-capabilities/v0.1"
        },
        "declaration_ref": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "$ref": "#/$defs/observationCapabilities"
        },
        "enforcement": {
          "$ref": "#/$defs/enforcementCapabilities"
        },
        "recovery": {
          "$ref": "#/$defs/recoveryCapabilities"
        },
        "verification": {
          "$ref": "#/$defs/verificationCapabilities"
        }
      }
    },

    "observationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_observation": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_identity": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_lineage": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_classification": {
          "$ref": "#/$defs/supportLevel"
        },
        "network_context": {
          "$ref": "#/$defs/supportLevel"
        },
        "origin_transport_distinction": {
          "$ref": "#/$defs/supportLevel"
        },
        "baseline_access": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_state_observation": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "enforcementCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_denial": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_containment": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_isolation": {
          "$ref": "#/$defs/supportLevel"
        },
        "network_isolation": {
          "$ref": "#/$defs/supportLevel"
        },
        "quarantine": {
          "$ref": "#/$defs/supportLevel"
        },
        "permission_restriction": {
          "$ref": "#/$defs/supportLevel"
        },
        "actor_disablement": {
          "$ref": "#/$defs/supportLevel"
        },
        "session_termination": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "recoveryCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery": {
          "$ref": "#/$defs/supportLevel"
        },
        "rollback": {
          "$ref": "#/$defs/supportLevel"
        },
        "snapshot_restore": {
          "$ref": "#/$defs/supportLevel"
        },
        "resource_restore": {
          "$ref": "#/$defs/supportLevel"
        },
        "configuration_restore": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "verificationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_action_observation": {
          "$ref": "#/$defs/supportLevel"
        },
        "state_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "persistence_detection": {
          "$ref": "#/$defs/supportLevel"
        },
        "reappearance_detection": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_schema",
        "default_authority",
        "authorization_required",
        "fallback_allowed"
      ],
      "properties": {
        "decision_schema": {
          "const": "tf.containment-decision/v0.1"
        },
        "default_authority": {
          "type": "string",
          "enum": [
            "recommend_only",
            "human_approved",
            "policy_authorized",
            "preauthorized_bounded",
            "automatic_bounded"
          ]
        },
        "authorization_required": {
          "type": "boolean"
        },
        "fallback_allowed": {
          "type": "boolean"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responseMapping"
          },
          "default": []
        }
      }
    },

    "responseMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_action",
        "capability",
        "support"
      ],
      "properties": {
        "requested_action": {
          "$ref": "#/$defs/action"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "native_mechanism_ref": {
          "type": "string",
          "minLength": 1
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "fully_reversible",
            "partially_reversible",
            "irreversible",
            "unknown"
          ]
        },
        "requires_additional_authorization": {
          "type": "boolean"
        },
        "fallback_action": {
          "$ref": "#/$defs/action"
        }
      }
    },

    "action": {
      "type": "string",
      "enum": [
        "increase_observation",
        "notify_authorized_operator",
        "deny_resource_writes",
        "contain_actor",
        "isolate_resource_set",
        "isolate_network_scope",
        "quarantine_affected_resources",
        "restrict_actor_permissions",
        "disable_actor",
        "preserve_evidence",
        "prepare_recovery",
        "initiate_recovery",
        "request_manual_review"
      ]
    },

    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_state_observed",
        "recovery_interference_observable"
      ],
      "properties": {
        "recovery_state_observed": {
          "type": "boolean"
        },
        "protected_resource_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recoveryMechanism"
          },
          "default": []
        },
        "recovery_interference_observable": {
          "type": "boolean"
        }
      }
    },

    "recoveryMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "support",
        "verification_supported"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "backup",
            "snapshot",
            "version_history",
            "preserved_original",
            "resource_restore",
            "configuration_restore",
            "cloud_recovery",
            "custom"
          ]
        },
        "support": {
          "$ref": "#/$defs/supportLevel"
        },
        "verification_supported": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema",
        "rescan_supported",
        "same_scope_comparison",
        "preserve_limitations"
      ],
      "properties": {
        "output_schema": {
          "const": "tf.verification/v0.1"
        },
        "rescan_supported": {
          "$ref": "#/$defs/supportLevel"
        },
        "same_scope_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_mount_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_namespace_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "cross_environment_comparison": {
          "$ref": "#/$defs/supportLevel"
        },
        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        },
        "preserve_limitations": {
          "const": true
        }
      }
    },

    "linuxContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount_awareness",
        "namespace_awareness",
        "container_awareness",
        "host_visibility",
        "remote_storage_awareness",
        "privilege_context",
        "requirements"
      ],
      "properties": {
        "mount_awareness": {
          "$ref": "#/$defs/supportLevel"
        },
        "namespace_awareness": {
          "$ref": "#/$defs/supportLevel"
        },
        "container_awareness": {
          "$ref": "#/$defs/supportLevel"
        },
        "host_visibility": {
          "$ref": "#/$defs/supportLevel"
        },
        "remote_storage_awareness": {
          "$ref": "#/$defs/supportLevel"
        },
        "privilege_context": {
          "type": "string",
          "enum": [
            "bounded_user_space",
            "privileged_user_space",
            "container_scoped",
            "host_privileged",
            "delegated",
            "mixed",
            "unknown"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "local_processing_preferred",
        "plaintext_credentials_allowed"
      ],
      "properties": {
        "data_minimization": {
          "const": true
        },
        "local_processing_preferred": {
          "const": true
        },
        "plaintext_credentials_allowed": {
          "const": false
        },
        "raw_resource_content_required": {
          "type": "boolean",
          "default": false
        },
        "raw_paths_exported": {
          "type": "boolean",
          "default": false
        },
        "sensitive_process_arguments_exported": {
          "type": "boolean",
          "default": false
        },
        "environment_secrets_exported": {
          "type": "boolean",
          "default": false
        },
        "pseudonymous_resource_ids": {
          "type": "boolean"
        },
        "redaction_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "informational",
            "minor",
            "material",
            "blocking"
          ]
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "created_at"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "specification_ref": {
          "type": "string",
          "default": "linux.md"
        },
        "detector_ref": {
          "type": "string",
          "default": "../detector.json"
        },
        "capabilities_schema_ref": {
          "type": "string",
          "default": "../../Shared_Structural_Event_Grammar/platform-capabilities.schema.json"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
