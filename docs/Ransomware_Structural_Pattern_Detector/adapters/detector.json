{
  "registry": {
    "id": "rspd-adapter-registry",
    "name": "Ransomware Structural Pattern Detector Adapter Registry",
    "version": "0.1.0",
    "status": "experimental",
    "type": "adapter-registry",
    "summary": "Machine-readable registry for platform, cross-environment, and resource/service adapters participating in the Ransomware Structural Pattern Detector architecture."
  },

  "purpose": {
    "primary": "Declare the adapter family, artifact relationships, structural roles, shared contracts, and routing boundaries without redefining adapter-specific semantics or the Shared Structural Event Grammar.",
    "principle": "Standardize adapter discovery and lineage without pretending that platforms, environments, or resource systems expose equivalent capabilities.",
    "non_goals": [
      "Define ransomware detection logic",
      "Replace adapter-specific configuration schemas",
      "Replace the Shared Structural Event Grammar",
      "Declare runtime platform capability",
      "Authorize containment actions",
      "Record response execution",
      "Assert verification or resolution"
    ]
  },

  "categories": {
    "platform": {
      "description": "Adapters associated primarily with an operating-system or device execution boundary.",
      "members": [
        "windows",
        "linux",
        "macos",
        "android",
        "ios-ipados"
      ]
    },

    "cross_environment": {
      "description": "Adapters whose primary purpose is preserving structural lineage across environment boundaries.",
      "members": [
        "cloud-sync"
      ]
    },

    "resource_service": {
      "description": "Adapters associated primarily with a resource layer or service abstraction rather than an operating-system boundary.",
      "members": [
        "database",
        "cache"
      ]
    }
  },

  "shared_contracts": {
    "resource_transition": {
      "schema": "tf.resource-transition/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/resource-transition.schema.json",
      "role": "normalized_observation"
    },

    "structural_pattern": {
      "schema": "tf.structural-pattern/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/structural-pattern.schema.json",
      "role": "detector_output"
    },

    "platform_capabilities": {
      "schema": "tf.platform-capabilities/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/platform-capabilities.schema.json",
      "role": "capability_declaration"
    },

    "containment_decision": {
      "schema": "tf.containment-decision/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/containment-decision.schema.json",
      "role": "bounded_response_request"
    },

    "response_outcome": {
      "schema": "tf.response-outcome/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/response-outcome.schema.json",
      "role": "execution_truth"
    },

    "verification": {
      "schema": "tf.verification/v0.1",
      "ref": "../../Shared_Structural_Event_Grammar/verification.schema.json",
      "role": "post_response_state"
    }
  },

  "detector": {
    "ref": "../detector.json",
    "input_schema": "tf.resource-transition/v0.1",
    "output_schema": "tf.structural-pattern/v0.1",
    "relationship": "Adapters normalize observations for the detector and execute separately authorized responses. The detector interprets structural behavior but does not own native platform mechanisms."
  },

  "adapter_contract": {
    "artifact_pattern": {
      "specification": "<adapter>.md",
      "schema": "<adapter>.schema.json",
      "example": "<adapter>.example.json"
    },

    "required_roles": [
      "declare_scope",
      "observe",
      "normalize",
      "declare_capabilities",
      "preserve_provenance",
      "preserve_unknowns",
      "respect_authority",
      "record_actual_outcome",
      "support_bounded_verification"
    ],

    "semantic_boundaries": [
      "native_observation != domain_verdict",
      "observation != interpretation",
      "actor != origin",
      "capability != authority",
      "decision != execution",
      "requested_response != executed_response",
      "execution != resolution",
      "recovery_capability != verified_restoration",
      "unknown != false"
    ]
  },

  "adapters": [
    {
      "id": "windows",
      "name": "Windows Adapter",
      "category": "platform",
      "status": "experimental",

      "artifacts": {
        "specification": "windows.md",
        "schema": "windows.schema.json",
        "example": "windows.example.json"
      },

      "configuration_schema": "tf.rspd-adapter.windows/v0.1",

      "roles": [
        "resource_observation",
        "actor_observation",
        "recovery_context",
        "normalization",
        "capability_declaration",
        "response_mapping",
        "verification"
      ],

      "special_boundaries": [
        "platform_capability_vs_adapter_capability",
        "actor_identity_vs_intent",
        "recovery_activity_vs_ransomware",
        "local_observation_vs_remote_origin"
      ]
    },

    {
      "id": "linux",
