  "routing": {
    "observation_path": [
      "native_or_service_observation",
      "adapter",
      "tf.resource-transition/v0.1",
      "ransomware-structural-pattern-detector",
      "tf.structural-pattern/v0.1"
    ],

    "response_path": [
      "tf.structural-pattern/v0.1",
      "tf.containment-decision/v0.1",
      "adapter",
      "native_or_service_mechanism",
      "tf.response-outcome/v0.1",
      "tf.verification/v0.1"
    ],

    "cross_adapter_correlation": {
      "allowed": true,
      "requirements": [
        "preserve_source_adapter",
        "preserve_source_dependencies",
        "preserve_origin_transport_relationships",
        "avoid_duplicate_event_inflation",
        "avoid_false_evidence_independence",
        "preserve_observation_scope",
        "preserve_capability_boundaries"
      ]
    }
  },

  "discovery": {
    "selection_principle": "Select adapters according to the evidence source and structural boundary actually being observed rather than choosing one adapter to represent an entire multi-layer environment.",

    "multi_adapter_examples": [
      {
        "scenario": "synchronized_windows_resource",
        "adapters": [
          "windows",
          "cloud-sync"
        ],
        "reason": "Preserve local Windows observation separately from cross-environment origin, transport, replication, and propagation evidence."
      },
      {
        "scenario": "synchronized_macos_resource",
        "adapters": [
          "macos",
          "cloud-sync"
        ],
        "reason": "Preserve local macOS observation separately from synchronization lineage."
      },
      {
        "scenario": "android_provider_resource",
        "adapters": [
          "android",
          "cloud-sync"
        ],
        "reason": "Preserve Android-visible resource state separately from remote origin and synchronization evidence when available."
      },
      {
        "scenario": "ios_ipados_provider_resource",
        "adapters": [
          "ios-ipados",
          "cloud-sync"
        ],
        "reason": "Preserve bounded device-side evidence separately from cross-environment synchronization lineage."
      },
      {
        "scenario": "database_on_linux",
        "adapters": [
          "database",
          "linux"
        ],
        "reason": "Keep logical database transitions distinct from underlying Linux resource transitions while permitting correlation."
      },
      {
        "scenario": "database_on_windows",
        "adapters": [
          "database",
          "windows"
        ],
        "reason": "Keep database-layer evidence distinct from underlying Windows resource and actor observations."
      },
      {
        "scenario": "distributed_cache_with_database_source",
        "adapters": [
          "cache",
          "database"
        ],
        "reason": "Preserve cached state separately from authoritative database state."
      },
      {
        "scenario": "cloud_synchronized_database",
        "adapters": [
          "database",
          "cloud-sync"
        ],
        "reason": "Preserve logical database behavior separately from cross-environment transport and propagation."
      }
    ]
  },

  "invariants": [
    {
      "id": "REGISTRY-INV-01",
      "statement": "Adapter discovery does not establish adapter capability."
    },
    {
      "id": "REGISTRY-INV-02",
      "statement": "Adapter capability does not establish authority to act."
    },
    {
      "id": "REGISTRY-INV-03",
      "statement": "A native or service observation does not independently establish a ransomware verdict."
    },
    {
      "id": "REGISTRY-INV-04",
      "statement": "The actor visible in one adapter boundary may not be the originating actor."
    },
    {
      "id": "REGISTRY-INV-05",
      "statement": "Multiple adapters observing the same underlying transition must not automatically create independent evidence."
    },
    {
      "id": "REGISTRY-INV-06",
      "statement": "Cross-adapter correlation must preserve source provenance and dependency."
    },
    {
      "id": "REGISTRY-INV-07",
      "statement": "Requested response and executed response remain separate structural facts."
    },
    {
      "id": "REGISTRY-INV-08",
      "statement": "Execution does not establish resolution."
    },
    {
      "id": "REGISTRY-INV-09",
      "statement": "Recovery capability does not establish verified restoration."
    },
    {
      "id": "REGISTRY-INV-10",
      "statement": "Verification claims remain bounded to the environments and resources actually observed."
    },
    {
      "id": "REGISTRY-INV-11",
      "statement": "Unknown capability or state must not be silently interpreted as unsupported, false, absent, safe, or resolved."
    },
    {
      "id": "REGISTRY-INV-12",
      "statement": "Adapter-specific semantics must not redefine the canonical meanings of Shared Structural Event Grammar objects."
    }
  ],

  "documentation": {
    "adapter_readme": "README.md",
    "normalization_guide": "normalization_fields.md",
    "macos_normalized_event_documentation": "macos.normalized.event.json.md"
  }
}
