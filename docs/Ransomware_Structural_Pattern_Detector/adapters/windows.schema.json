{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/ransomware-structural-pattern-detector/adapters/windows.schema.json",
  "title": "Ransomware Structural Pattern Detector - Windows Adapter",
  "description": "Machine-readable configuration and conformance schema for a Windows adapter participating in the Ransomware Structural Pattern Detector architecture. The schema declares deployment profile, observation boundaries, native evidence sources, normalization behavior, platform capabilities, privacy controls, containment mappings, recovery context, and verification support without asserting ransomware, authority, execution success, or resolution.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema",
    "adapter",
    "environment",
    "scope",
    "observation",
    "normalization",
    "capabilities",
    "privacy",
    "provenance"
  ],

  "properties": {
    "schema": {
      "const": "tf.rspd-adapter.windows/v0.1",
      "description": "Canonical schema-family identifier and version."
    },

    "adapter": {
      "$ref": "#/$defs/adapter"
    },

    "environment": {
      "$ref": "#/$defs/environment"
    },

    "scope": {
      "$ref": "#/$defs/scope"
    },

    "observation": {
      "$ref": "#/$defs/observation"
    },

    "normalization": {
      "$ref": "#/$defs/normalization"
    },

    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },

    "containment": {
      "$ref": "#/$defs/containment"
    },

    "recovery": {
      "$ref": "#/$defs/recovery"
    },

    "verification": {
      "$ref": "#/$defs/verification"
    },

    "privacy": {
      "$ref": "#/$defs/privacy"
    },

    "limitations": {
      "type": "array",
      "description": "Known limitations of this concrete Windows adapter deployment.",
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "default": []
    },

    "provenance": {
      "$ref": "#/$defs/provenance"
    },

    "extensions": {
      "type": "object",
      "description": "Implementation-specific extension data. Extensions must not redefine canonical adapter semantics.",
      "additionalProperties": true
    }
  },

  "$defs": {
    "supportLevel": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "unknown"
      ]
    },

    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string",
          "minLength": 1
        },

        "status": {
          "type": "string",
          "enum": [
            "experimental",
            "development",
            "validation",
            "stable",
            "deprecated"
          ]
        },

        "profile": {
          "type": "string",
          "enum": [
            "application",
            "resource_scoped",
            "endpoint_observation",
            "filesystem_intervention",
            "security_integration",
            "hybrid",
            "custom"
          ],
          "description": "Declared deployment profile. The profile does not itself establish any capability."
        },

        "implementation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "const": "windows"
        },

        "platform_version": {
          "type": "string",
          "minLength": 1
        },

        "edition": {
          "type": "string",
          "minLength": 1
        },

        "architecture": {
          "type": "string",
          "enum": [
            "x86",
            "x64",
            "arm64",
            "other",
            "unknown"
          ]
        },

        "deployment": {
          "type": "string",
          "enum": [
            "workstation",
            "server",
            "virtual_machine",
            "cloud_host",
            "specialized",
            "other",
            "unknown"
          ]
        }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "application",
            "resource_set",
            "directory_set",
            "volume_set",
            "endpoint",
            "custom"
          ]
        },

        "scope_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the configured or authorized observation boundary."
        },

        "resource_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },

        "includes_network_resources": {
          "type": "boolean",
          "default": false
        },

        "includes_cloud_resources": {
          "type": "boolean",
          "default": false
        },

        "includes_recovery_resources": {
          "type": "boolean",
          "default": false
        },

        "includes_canaries": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "continuity"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "description": "Native or implementation-specific observation sources used by this adapter.",
          "items": {
            "$ref": "#/$defs/observationSource"
          },
          "minItems": 1
        },

        "continuity": {
          "type": "string",
          "enum": [
            "continuous",
            "resumed",
            "gapped",
            "snapshot",
            "unknown"
          ]
        },

        "deduplication": {
          "type": "boolean",
          "description": "Whether the implementation attempts to identify multiple observations representing the same underlying transition."
        },

        "deduplication_method_ref": {
          "type": "string",
          "minLength": 1
        },

        "actor_lineage_collection": {
          "type": "boolean"
        },

        "recovery_state_collection": {
          "type": "boolean"
        },

        "network_context_collection": {
          "type": "boolean"
        },

        "synchronization_context_collection": {
          "type": "boolean"
        },

        "event_loss_detectable": {
          "type": "boolean"
        }
      }
    },

    "observationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "class": {
          "type": "string",
          "enum": [
            "event_tracing",
            "filesystem",
            "filesystem_filter",
            "process",
            "service",
            "resource_state",
            "network",
            "recovery",
            "synchronization",
            "security_integration",
            "user_supplied",
            "custom"
          ]
        },

        "support": {
          "$ref": "#/$defs/supportLevel"
        },

        "native_name": {
          "type": "string",
          "minLength": 1
        },

        "scope_ref": {
          "type": "string",
          "minLength": 1
        },

        "direct_or_derived": {
          "type": "string",
          "enum": [
            "direct",
            "derived",
            "mixed",
            "unknown"
          ]
        },

        "notes": {
          "type": "string"
        }
      }
    },

    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema",
        "preserve_native_operation",
        "preserve_provenance",
        "preserve_unknowns"
      ],
      "properties": {
        "output_schema": {
          "const": "tf.resource-transition/v0.1"
        },

        "preserve_native_operation": {
          "type": "boolean",
          "const": true
        },

        "preserve_provenance": {
          "type": "boolean",
          "const": true
        },

        "preserve_unknowns": {
          "type": "boolean",
          "const": true
        },

        "preserve_origin_transport_distinction": {
          "type": "boolean"
        },

        "preserve_source_dependencies": {
          "type": "boolean"
        },

        "derive_resource_class": {
          "type": "boolean"
        },

        "derive_baseline_state": {
          "type": "boolean"
        },

        "redaction_enabled": {
          "type": "boolean"
        }
      }
    },

    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "declaration_ref"
      ],
      "properties": {
        "schema": {
          "const": "tf.platform-capabilities/v0.1"
        },

        "declaration_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the concrete platform-capabilities declaration for this adapter deployment."
        },

        "observation": {
          "$ref": "#/$defs/observationCapabilities"
        },

        "enforcement": {
          "$ref": "#/$defs/enforcementCapabilities"
        },

        "recovery": {
          "$ref": "#/$defs/recoveryCapabilities"
        },

        "verification": {
          "$ref": "#/$defs/verificationCapabilities"
        }
      }
    },

    "observationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_observation": {
          "$ref": "#/$defs/supportLevel"
        },

        "actor_identity": {
          "$ref": "#/$defs/supportLevel"
        },

        "actor_lineage": {
          "$ref": "#/$defs/supportLevel"
        },

        "resource_classification": {
          "$ref": "#/$defs/supportLevel"
        },

        "network_context": {
          "$ref": "#/$defs/supportLevel"
        },

        "origin_transport_distinction": {
          "$ref": "#/$defs/supportLevel"
        },

        "baseline_access": {
          "$ref": "#/$defs/supportLevel"
        },

        "recovery_state_observation": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "enforcementCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_denial": {
          "$ref": "#/$defs/supportLevel"
        },

        "actor_containment": {
          "$ref": "#/$defs/supportLevel"
        },

        "resource_isolation": {
          "$ref": "#/$defs/supportLevel"
        },

        "network_isolation": {
          "$ref": "#/$defs/supportLevel"
        },

        "quarantine": {
          "$ref": "#/$defs/supportLevel"
        },

        "permission_restriction": {
          "$ref": "#/$defs/supportLevel"
        },

        "actor_disablement": {
          "$ref": "#/$defs/supportLevel"
        },

        "session_termination": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "recoveryCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery": {
          "$ref": "#/$defs/supportLevel"
        },

        "rollback": {
          "$ref": "#/$defs/supportLevel"
        },

        "snapshot_restore": {
          "$ref": "#/$defs/supportLevel"
        },

        "resource_restore": {
          "$ref": "#/$defs/supportLevel"
        },

        "configuration_restore": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "verificationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_action_observation": {
          "$ref": "#/$defs/supportLevel"
        },

        "state_comparison": {
          "$ref": "#/$defs/supportLevel"
        },

        "persistence_detection": {
          "$ref": "#/$defs/supportLevel"
        },

        "reappearance_detection": {
          "$ref": "#/$defs/supportLevel"
        },

        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "containment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_schema": {
          "const": "tf.containment-decision/v0.1"
        },

        "default_authority": {
          "type": "string",
          "enum": [
            "recommend_only",
            "human_approved",
            "policy_authorized",
            "preauthorized_bounded",
            "automatic_bounded"
          ],
          "default": "recommend_only"
        },

        "authorization_required": {
          "type": "boolean",
          "default": true
        },

        "fallback_allowed": {
          "type": "boolean",
          "default": false
        },

        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responseMapping"
          },
          "default": []
        }
      }
    },

    "responseMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_action",
        "capability",
        "support"
      ],
      "properties": {
        "requested_action": {
          "type": "string",
          "enum": [
            "increase_observation",
            "notify_authorized_operator",
            "deny_resource_writes",
            "contain_actor",
            "isolate_resource_set",
            "isolate_network_scope",
            "quarantine_affected_resources",
            "restrict_actor_permissions",
            "disable_actor",
            "preserve_evidence",
            "prepare_recovery",
            "initiate_recovery",
            "request_manual_review"
          ]
        },

        "capability": {
          "type": "string",
          "minLength": 1
        },

        "support": {
          "$ref": "#/$defs/supportLevel"
        },

        "native_mechanism_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Implementation-local reference to the native mechanism, not an assertion that it executed."
        },

        "reversibility": {
          "type": "string",
          "enum": [
            "fully_reversible",
            "partially_reversible",
            "irreversible",
            "unknown"
          ]
        },

        "requires_additional_authorization": {
          "type": "boolean"
        },

        "fallback_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery_state_observed": {
          "type": "boolean"
        },

        "protected_resource_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },

        "mechanisms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recoveryMechanism"
          },
          "default": []
        },

        "recovery_interference_observable": {
          "type": "boolean"
        }
      }
    },

    "recoveryMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "class": {
          "type": "string",
          "enum": [
            "backup",
            "snapshot",
            "version_history",
            "preserved_original",
            "resource_restore",
            "configuration_restore",
            "cloud_recovery",
            "custom"
          ]
        },

        "support": {
          "$ref": "#/$defs/supportLevel"
        },

        "verification_supported": {
          "$ref": "#/$defs/supportLevel"
        }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_schema": {
          "const": "tf.verification/v0.1"
        },

        "rescan_supported": {
          "$ref": "#/$defs/supportLevel"
        },

        "same_scope_comparison": {
          "$ref": "#/$defs/supportLevel"
        },

        "cross_environment_comparison": {
          "$ref": "#/$defs/supportLevel"
        },

        "recovery_verification": {
          "$ref": "#/$defs/supportLevel"
        },

        "preserve_limitations": {
          "type": "boolean",
          "const": true
        }
      }
    },

    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "local_processing_preferred",
        "plaintext_credentials_allowed"
      ],
      "properties": {
        "data_minimization": {
          "type": "boolean",
          "const": true
        },

        "local_processing_preferred": {
          "type": "boolean",
          "const": true
        },

        "plaintext_credentials_allowed": {
          "type": "boolean",
          "const": false
        },

        "raw_resource_content_required": {
          "type": "boolean",
          "default": false
        },

        "raw_paths_exported": {
          "type": "boolean",
          "default": false
        },

        "sensitive_process_arguments_exported": {
          "type": "boolean",
          "default": false
        },

        "pseudonymous_resource_ids": {
          "type": "boolean"
        },

        "redaction_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        },

        "severity": {
          "type": "string",
          "enum": [
            "informational",
            "minor",
            "material",
            "blocking"
          ]
        },

        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "created_at"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },

        "created_at": {
          "type": "string",
          "format": "date-time"
        },

        "updated_at": {
          "type": "string",
          "format": "date-time"
        },

        "specification_ref": {
          "type": "string",
          "default": "windows.md"
        },

        "detector_ref": {
          "type": "string",
          "default": "../detector.json"
        },

        "capabilities_schema_ref": {
          "type": "string",
          "default": "../../Shared_Structural_Event_Grammar/platform-capabilities.schema.json"
        },

        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
