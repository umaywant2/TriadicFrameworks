    },
    {
      "adapter": "macos",
      "schema_id": "tf.rspd-adapter.macos/v0.1",
      "schema": "../adapters/macos.schema.json",
      "specification": "../adapters/macos.md"
    },
    {
      "adapter": "android",
      "schema_id": "tf.rspd-adapter.android/v0.1",
      "schema": "../adapters/android.schema.json",
      "specification": "../adapters/android.md"
    },
    {
      "adapter": "ios-ipados",
      "schema_id": "tf.rspd-adapter.ios-ipados/v0.1",
      "schema": "../adapters/ios-ipados.schema.json",
      "specification": "../adapters/ios-ipados.md"
    },
    {
      "adapter": "cloud-sync",
      "schema_id": "tf.rspd-adapter.cloud-sync/v0.1",
      "schema": "../adapters/cloud-sync.schema.json",
      "specification": "../adapters/cloud-sync.md"
    },
    {
      "adapter": "database",
      "schema_id": "tf.rspd-adapter.database/v0.1",
      "schema": "../adapters/database.schema.json",
      "specification": "../adapters/database.md"
    },
    {
      "adapter": "cache",
      "schema_id": "tf.rspd-adapter.cache/v0.1",
      "schema": "../adapters/cache.schema.json",
      "specification": "../adapters/cache.md"
    }
  ],

  "positive_fixtures": [
