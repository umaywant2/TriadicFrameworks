    {
      "id": "macos-normalized-event-example",
      "class": "runtime_event",
      "instance": "../adapters/macos.normalized.event.example.json",
      "schema": "../../Shared_Structural_Event_Grammar/resource-transition.schema.json",
      "expected": "pass"
    },
    {
      "id": "runtime-resource-transition-example",
      "class": "runtime_lineage",
