{
  "manifest": {
    "id": "rspd-validation-manifest",
    "name": "Ransomware Structural Pattern Detector Validation Manifest",
    "version": "0.1.0",
    "status": "experimental",
    "type": "validation-manifest",
    "description": "Machine-readable validation plan for RSPD schemas, adapter configurations, runtime examples, lineage relationships, and cross-artifact invariants."
  },

  "validation_model": {
    "schema_draft": "https://json-schema.org/draft/2020-12/schema",
    "fail_closed": true,
    "silent_repair": false,

    "result_states": [
      "pass",
      "fail",
      "error",
      "skip"
    ],

    "layers": [
      {
        "id": "syntax",
        "order": 1,
        "description": "Confirm that JSON artifacts parse successfully."
      },
      {
        "id": "schema",
        "order": 2,
        "description": "Validate instances against their declared JSON Schema contracts."
      },
      {
        "id": "relationship",
        "order": 3,
        "description": "Check repository-level relationships among specifications, schemas, examples, registries, and shared contracts."
      },
      {
        "id": "lineage",
        "order": 4,
        "description": "Check cross-object references in the canonical runtime example lineage."
      },
      {
        "id": "invariant",
        "order": 5,
        "description": "Check architectural rules that span individual schemas or artifacts."
      }
    ]
  },

  "paths": {
    "module_root": "..",
    "adapters": "../adapters",
    "examples": "../examples",
    "validation": ".",
    "shared_grammar": "../../Shared_Structural_Event_Grammar"
  },

  "shared_schemas": {
    "resource_transition": {
      "schema_id": "tf.resource-transition/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/resource-transition.schema.json"
    },
    "structural_pattern": {
      "schema_id": "tf.structural-pattern/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/structural-pattern.schema.json"
    },
    "platform_capabilities": {
      "schema_id": "tf.platform-capabilities/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/platform-capabilities.schema.json"
    },
    "containment_decision": {
      "schema_id": "tf.containment-decision/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/containment-decision.schema.json"
    },
    "response_outcome": {
      "schema_id": "tf.response-outcome/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/response-outcome.schema.json"
    },
    "verification": {
      "schema_id": "tf.verification/v0.1",
      "path": "../../Shared_Structural_Event_Grammar/verification.schema.json"
    }
  },

  "adapter_schemas": [
    {
      "adapter": "windows",
      "schema_id": "tf.rspd-adapter.windows/v0.1",
      "schema": "../adapters/windows.schema.json",
