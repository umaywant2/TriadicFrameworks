{
  "$schema": "https://www.triadicframeworks.org/schemas/module.schema.json",
  "module_name": "Structural Detection",
  "module_id": "structural_detection",
  "version": "1.0",
  "category": "analysis",
  "summary": "Detect motifs, drift, regimes, invariants, anomalies, and coherence using RTT/1 operators.",
