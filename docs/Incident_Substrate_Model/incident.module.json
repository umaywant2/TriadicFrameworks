{
  "module": {
    "name": "Incident Substrate Model",
    "id": "incident.substrate",
    "category": "Safety-Operations",
    "version": "1.0.0",
    "summary": "A resonance-native substrate for calm, structured, operator-safe incident ingestion, classification, rectification planning, and bounded remediation.",
    "purpose": "Provide a universal, grammar-driven substrate for incident response across all RTT-aligned repositories.",
    "keywords": [
      "incident response",
      "rectification",
      "substrate model",
      "operator grammar",
      "repo safety",
      "supply-chain",
      "remediation"
    ],
    "audience": ["repo_maintainers", "operators", "AIs"],
    "front_door": "/docs/Incident_Substrate_Model/README.md",
    "format": ["html", "markdown", "json"],
    "every_page_stands_alone": true
  },

  "ai": {
    "module": "incident_substrate_model",
    "version": "1.0.0",
    "purpose": "Ingest incidents, derive rectification steps, generate read-only plans, and execute bounded, operator-approved actions.",
    "canon": "RTT/1 - Operator-Safe Incident Rectification",
    "front_door": "/docs/Incident_Substrate_Model/README.md",
    "audience": ["repo_maintainers", "ai_partners", "security_operators"]
  },

  "session_context": {
    "canon": "TriadicFrameworks",
    "module": "Incident Substrate Model",
    "category": "Safety-Operations",
    "version": "1.0.0",
    "coherence": "structured",
    "drift": "minimal",
    "format": ["html", "markdown", "json"],
    "front_door": "/docs/Incident_Substrate_Model/README.md",
    "audience": ["repo_maintainers", "operators", "AIs"],
    "every_page_stands_alone": true
  },

  "session": {
    "mode": "read_only_first_pass",
    "requires_operator_approval": true,
    "allowed_write_actions": [
      "incident.execute.remove_file",
      "incident.execute.rotate_secret",
      "incident.execute.patch_dependency",
      "incident.execute.flag_for_followup"
    ]
  },

  "analyzer_layers": {
    "operator": [
      "incident-ingestion",
      "classification",
      "surface-mapping",
      "rectification-planning",
      "operator-approval",
      "bounded-execution"
    ],
    "dimensional": [
      "coherence",
      "substrate-structure"
    ],
    "regime": [
      "incident",
      "rectification"
    ],
    "cross_cutting": [
      "repo_safety",
      "dependency_safety",
      "cicd_safety"
    ]
  },

  "operators": {
    "ingest": [
      "incident.ingest",
      "incident.classify",
      "incident.map_surface_area"
    ],
    "plan": [
      "incident.derive_rectification_steps",
      "incident.generate_readonly_plan",
      "incident.flag_uncertainty"
    ],
    "approval": [
      "incident.request_operator_approval",
      "incident.hold_for_review"
    ],
    "execute": [
      "incident.execute.remove_file",
      "incident.execute.rotate_secret",
      "incident.execute.patch_dependency",
      "incident.execute.flag_for_followup"
    ]
  },

  "checks": [
    {
      "id": "secret_scan",
      "description": "Scan for hard-coded secrets or credentials.",
      "patterns": ["API_KEY", "BEGIN RSA", "BEGIN PRIVATE KEY", ".env", "token", "secret"],
      "severity": "high"
    },
    {
      "id": "machine_artifacts",
      "description": "Detect machine-specific or local environment artifacts.",
      "patterns": [".DS_Store", ".vscode/settings.json", ".idea", "Thumbs.db"],
      "severity": "low"
    },
    {
      "id": "infra_leak",
      "description": "Detect infrastructure-revealing content.",
      "patterns": ["ssh", "server", "ip address", "hostname", "kubeconfig"],
      "severity": "medium"
    },
    {
      "id": "private_notes",
      "description": "Detect potentially private or non-publishable notes.",
      "patterns": ["PRIVATE", "INTERNAL ONLY", "DO NOT PUBLISH", "DRAFT"],
      "severity": "medium"
    }
  ],

  "fixes": {
    "remove": ["machine_artifacts"],
    "rotate": ["secret_scan"],
    "flag": ["private_notes", "infra_leak"]
  },

  "reporting": {
    "plan_format": "markdown",
    "include_sections": [
      "incident_summary",
      "classification",
      "affected_surface_area",
      "proposed_rectification_steps",
      "uncertainties",
      "operator_actions_required"
    ]
  },

  "substrate": {
    "input": {
      "incident_source": "string",
      "intel": "object"
    },
    "output": {
      "readonly_plan": "object",
      "operator_actions_required": "array"
    }
  }
}
