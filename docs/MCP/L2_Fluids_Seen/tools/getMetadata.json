{
  "canonical": "R5",
  "qmroot": "0D",
  "layer": "L2_Fluids_Seen",
  "triad": "fluids",
  "title": "TriadicFrameworks MCP — Fluid Metadata Retrieval Tool",
  "description": "Retrieves metadata for fluid substrates, operators, diagnostics, and modules within the Fluids Seen Layer.",
  "note": "This is the canonical metadata resolver for L2 fluidic resonance.",

  "tool": {
    "name": "getMetadata",
    "version": "1.0.0",
    "purpose": "Return metadata for a given fluidic entity.",
    "lineage": "qmroot-0D",
    "supportsFluidMetadata": true,
    "supportsResonanceMetadata": true
  },

  "input": {
    "entity": {
      "type": "string",
      "description": "Name of the fluidic entity (substrate, operator, diagnostic, or module)."
    },
    "includeExtended": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include extended metadata fields."
    }
  },

  "output": {
    "entity": {
      "type": "object",
      "fields": {
        "name": "string",
        "category": "string",
        "metadata": {
          "type": "object",
          "description": "Metadata fields for the entity."
        },
        "extended": {
          "optional": true,
          "description": "Extended metadata returned only if includeExtended=true."
        }
      }
    },
    "layer": "L2_Fluids_Seen",
    "triad": "fluids",
    "qmroot": "0D",
    "canonical": "R5"
  },

  "resolutionRules": {
    "substrates": {
      "laminarFlow": {
