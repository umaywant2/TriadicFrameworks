      "viscosity": {
        "category": "operator",
        "metadata": {
          "primitives": ["viscosity"],
          "description": "Controls internal friction and resistance."
        }
      },
      "continuity": {
        "category": "operator",
        "metadata": {
          "primitives": ["continuity"],
          "description": "Preserves identity across transitions."
        }
      },
      "channel": {
        "category": "operator",
        "metadata": {
          "primitives": ["flowIntegrity"],
          "description": "Creates stable pathways for fluid movement."
        }
      },
      "rupture": {
        "category": "operator",
        "metadata": {
          "primitives": ["turbulence", "continuity"],
          "description": "Represents breakdown of continuity."
        }
      }
    }
