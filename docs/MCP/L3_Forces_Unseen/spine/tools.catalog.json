        "ai.metadata.json",
        "ai_registry.json"
      ]
    },
    {
      "id": "tool.docs",
      "category": "documentation",
      "description": "Access documentation pages for the S3 Spine subsystem.",
      "files": [
        "README.md",
        "m_Source.md",
        "operators.md",
        "dimensions.md",
        "cosmology.md",
        "coherence.md",
        "resources.catalog.md",
