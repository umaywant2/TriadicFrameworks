        "spine.examples.registry.json",
        "example.schema.json"
      ]
    },
    {
      "id": "tool.server",
      "category": "server",
      "description": "Access the MCP server configuration for the S3 Spine subsystem.",
      "files": ["server.json"]
    },
    {
      "id": "tool.protocol",
      "category": "protocol",
