      ]
    },
    {
      "id": "tool.dimensions",
      "category": "dimension",
      "description": "Access dimensional mapping for the S3 Spine subsystem.",
      "files": ["dimensional_mapping.json"]
    },
    {
      "id": "tool.module",
      "category": "module",
      "description": "Access the S3 Spine module definition.",
      "files": ["module.json"]
    },
    {
      "id": "tool.manifest",
      "category": "module",
      "description": "Access the canonical manifest for the S3 Spine subsystem.",
      "files": ["manifest.json"]
    },
    {
      "id": "tool.examples",
      "category": "example",
      "description": "Access example envelopes and example registry.",
