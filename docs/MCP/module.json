{
  "canonical": "R5",
  "module": "TriadicFrameworks-MCP",
  "version": "0.1.0",

  "lineage": [
    "qmroot",
    "frequency",
    "fluids",
    "forces"
  ],

  "note": "This manifest defines the cosmology-facing MCP corpus. The protocol-facing MCP server lives under docs/MCP/protocol/.",

  "cosmology": {
    "layers": [
      {
        "id": "L0_QMROOT",
        "triad": "root",
        "description": "Quantum origin and root-state mechanics; coherence anchor; lineage seed."
      },
      {
        "id": "L1_Frequency_Unseen",
        "triad": "oscillation",
        "description": "Unseen oscillation layer; spectral regimes, drift, coherence, analyzer behavior."
      },
      {
        "id": "L2_Fluids_Seen",
        "triad": "continuity",
        "description": "Seen-world continuity layer; flow, substrate, fluidic mechanics."
      },
      {
        "id": "L3_Forces_Unseen",
        "triad": "forces",
        "description": "Unseen force-regime layer; gradient, field, rupture, integrity; schemas, registries, spine."
      }
    ]
  },

  "structure": {
    "root": "docs/MCP",

    "layers": {
      "L0_QMROOT": {
        "path": "docs/MCP/L0_QMROOT",
        "files": [
          "README.md"
        ],
        "tools": []
      },

      "L1_Frequency_Unseen": {
        "path": "docs/MCP/L1_Frequency_Unseen",
        "files": [
          "README.md"
        ],
        "tools": []
      },

      "L2_Fluids_Seen": {
        "path": "docs/MCP/L2_Fluids_Seen",
        "files": [
          "README.md"
        ],
        "tools": []
      },

      "L3_Forces_Unseen": {
        "path": "docs/MCP/L3_Forces_Unseen",
        "files": [
          "README.md",
          "schemas/module.schema.json",
          "schemas/operator.schema.json",
          "registry/module_registry.json",
          "registry/operator_registry.json",
          "spine/S3.graph.json"
        ],
        "tools": []
      }
    }
  },

  "dimensions": {
    "path": "docs/MCP/L3_Forces_Unseen/dimensions",
    "triad": "forces",
    "items": [
      "L4.json",
      "L5.json",
      "L8.json",
      "L10.json",
      "L11.json",
      "L12.json",
      "L16.json",
      "L26.json",
      "L32.json",
