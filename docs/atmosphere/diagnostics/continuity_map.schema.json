{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity Map Schema (Atmosphere Module)",
  "description": "Schema for validating continuity_map.json — continuity fields, stability maps, temporal coherence overlays, drift pathways, and regime memory structures.",
  "type": "object",

  "properties": {
    "map": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "context": {
      "type": "object",
      "properties": {
        "continuity_definition": { "type": "string" },
        "global_role": { "type": "string" }
      },
      "required": ["continuity_definition", "global_role"]
    },

    "fields": {
      "type": "object",
      "properties": {
        "temporal_coherence_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "regime_memory_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "oscillation_periodicity_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "drift_accumulation_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "teleconnection_continuity_field": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "temporal_coherence_field",
        "regime_memory_field",
        "oscillation_periodicity_field",
        "drift_accumulation_field",
        "teleconnection_continuity_field"
      ]
    },

    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "map",
    "context",
    "fields",
    "maps",
    "scales",
    "summary"
  ]
}
