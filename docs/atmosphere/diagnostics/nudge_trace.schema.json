{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nudge Trace Schema",
  "type": "object",
  "required": ["module", "diagnostic", "category", "version", "events", "operators", "regimes"],
  "properties": {
    "module": { "type": "string", "const": "atmosphere" },
    "diagnostic": { "type": "string", "const": "nudge" },
    "category": { "type": "string", "const": "trace" },
    "version": { "type": "string" },

    "events": {
      "type": "object",
      "properties": {
        "micro_nudge": { "type": "array", "items": { "type": "string" } },
        "boundary_nudge": { "type": "array", "items": { "type": "string" } },
        "coherence_nudge": { "type": "array", "items": { "type": "string" } },
        "regime_precursor": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "micro_nudge",
        "boundary_nudge",
        "coherence_nudge",
        "regime_precursor"
      ]
    },

    "operators": {
      "type": "object",
      "properties": {
        "nudge": { "type": "array", "items": { "type": "string" } },
        "continuity": { "type": "array", "items": { "type": "string" } },
        "coherence": { "type": "array", "items": { "type": "string" } },
        "clarity": { "type": "array", "items": { "type": "string" } },
        "dimensional": { "type": "array", "items": { "type": "string" } },
        "drift": { "type": "array", "items": { "type": "string" } },
        "paradox": { "type": "array", "items": { "type": "string" } },
        "resonance": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "nudge",
        "continuity",
        "coherence",
        "clarity",
        "dimensional",
        "drift",
        "paradox",
        "resonance"
      ]
    },

    "regimes": {
      "type": "object",
      "properties": {
        "stable": { "type": "array", "items": { "type": "string" } },
        "transition": { "type": "array", "items": { "type": "string" } },
        "unstable": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["stable", "transition", "unstable"]
    }
  }
}
