{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drift Diagnostic Schema (Atmosphere Module)",
  "description": "Schema for validating drift_diagnostic.json — boundary weakening, coherence decay, gradient intensification, instability accumulation, oscillation drift, storm-precursor drift.",
  "type": "object",

  "properties": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "context": {
      "type": "object",
      "properties": {
        "drift_definition": { "type": "string" },
        "global_role": { "type": "string" }
      },
      "required": ["drift_definition", "global_role"]
    },

    "agents": {
      "type": "object",
      "properties": {
        "primary": { "type": "array", "items": { "type": "string" } },
        "secondary": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["primary", "secondary"]
    },

    "fields": {
      "type": "object",
      "properties": {
        "boundary_drift_field": { "type": "array", "items": { "type": "string" } },
        "coherence_decay_field": { "type": "array", "items": { "type": "string" } },
        "oscillation_drift_field": { "type": "array", "items": { "type": "string" } },
        "cross_domain_drift_field": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "boundary_drift_field",
        "coherence_decay_field",
        "oscillation_drift_field",
        "cross_domain_drift_field"
      ]
    },

    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "failure_modes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "cascades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "diagnostics": {
      "type": "object",
      "properties": {
        "maps": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["maps"]
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "diagnostic",
    "context",
    "agents",
    "fields",
    "metrics",
    "scales",
    "failure_modes",
    "cascades",
    "diagnostics",
    "summary"
  ]
}
