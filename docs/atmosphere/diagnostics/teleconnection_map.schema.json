{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleconnection Map Schema",
  "type": "object",
  "required": ["module", "diagnostic", "category", "version", "layers", "operators", "regimes", "coupling"],
  "properties": {
    "module": { "type": "string", "const": "atmosphere" },
    "diagnostic": { "type": "string", "const": "teleconnection" },
    "category": { "type": "string", "const": "map" },
    "version": { "type": "string" },

    "layers": {
      "type": "object",
      "properties": {
        "pacific": { "type": "array", "items": { "type": "string" } },
        "atlantic": { "type": "array", "items": { "type": "string" } },
        "indian_ocean": { "type": "array", "items": { "type": "string" } },
        "polar": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["pacific", "atlantic", "indian_ocean", "polar"]
    },

    "operators": {
      "type": "object",
      "properties": {
        "teleconnection": { "type": "array", "items": { "type": "string" } },
        "continuity": { "type": "array", "items": { "type": "string" } },
        "coherence": { "type": "array", "items": { "type": "string" } },
        "clarity": { "type": "array", "items": { "type": "string" } },
        "dimensional": { "type": "array", "items": { "type": "string" } },
        "drift": { "type": "array", "items": { "type": "string" } },
        "paradox": { "type": "array", "items": { "type": "string" } },
        "resonance": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "teleconnection",
        "continuity",
        "coherence",
        "clarity",
        "dimensional",
        "drift",
        "paradox",
        "resonance"
      ]
    },

    "regimes": {
      "type": "object",
      "properties": {
        "stable": { "type": "array", "items": { "type": "string" } },
        "transition": { "type": "array", "items": { "type": "string" } },
        "unstable": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["stable", "transition", "unstable"]
    },

    "coupling": {
      "type": "object",
      "properties": {
        "ocean": { "type": "array", "items": { "type": "string" } },
        "cryosphere": { "type": "array", "items": { "type": "string" } },
        "land": { "type": "array", "items": { "type": "string" } },
        "biosphere": { "type": "array", "items": { "type": "string" } },
        "magnetosphere": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["ocean", "cryosphere", "land", "biosphere", "magnetosphere"]
    }
  }
}
