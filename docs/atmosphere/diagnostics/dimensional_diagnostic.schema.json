{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensional Diagnostic Schema (Atmosphere Module)",
  "description": "Schema for validating dimensional_diagnostic.json — cross-domain alignment, gradient fields, flux coupling, composition response, teleconnection resonance.",
  "type": "object",

  "properties": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "context": {
      "type": "object",
      "properties": {
        "dimensional_definition": { "type": "string" },
        "global_role": { "type": "string" }
      },
      "required": ["dimensional_definition", "global_role"]
    },

    "agents": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["primary", "secondary"]
    },

    "indicators": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "fields": {
      "type": "object",
      "properties": {
        "gradient_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "flux_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "composition_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "teleconnection_field": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "gradient_field",
        "flux_field",
        "composition_field",
        "teleconnection_field"
      ]
    },

    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "failure_modes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "cascades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "diagnostics": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["outputs"]
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "diagnostic",
    "context",
    "agents",
    "indicators",
    "fields",
    "metrics",
    "scales",
    "failure_modes",
    "cascades",
    "diagnostics",
    "summary"
  ]
}

