{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clarity Envelope Schema (Atmosphere Module)",
  "description": "Schema for validating clarity_envelope.json — clarity boundaries, truth extraction envelopes, noise reduction limits, pattern convergence shells, and consensus alignment envelopes.",
  "type": "object",

  "properties": {
    "envelope": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "components": {
      "type": "object",
      "properties": {
        "clarity_layer": { "type": "string" },
        "truth_shell": { "type": "string" },
        "noise_boundary": { "type": "string" }
      },
      "required": [
        "clarity_layer",
        "truth_shell",
        "noise_boundary"
      ]
    },

    "sources": {
      "type": "object",
      "properties": {
        "composition": { "type": "string" },
        "forcing": { "type": "string" },
        "dynamics": { "type": "string" },
        "thermodynamics": { "type": "string" },
        "hydrospheric_coupling": { "type": "string" },
        "regime_transitions": { "type": "string" },
        "clarity_coherence": { "type": "string" }
      },
      "required": [
        "composition",
        "forcing",
        "dynamics",
        "thermodynamics",
        "hydrospheric_coupling",
        "regime_transitions",
        "clarity_coherence"
      ]
    },

    "signatures": {
      "type": "array",
      "items": { "type": "string" }
    },

    "agents": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["primary", "secondary"]
    },

    "fields": {
      "type": "object",
      "properties": {
        "truth_extraction_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "noise_reduction_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pattern_convergence_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consensus_alignment_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cross_domain_clarity_field": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "truth_extraction_field",
        "noise_reduction_field",
        "pattern_convergence_field",
        "consensus_alignment_field",
        "cross_domain_clarity_field"
      ]
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "cascades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "overlays": {
      "type": "array",
      "items": { "type": "string" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "envelope",
    "components",
    "sources",
    "signatures",
    "agents",
    "fields",
    "scales",
    "cascades",
    "overlays",
    "summary"
  ]
}
