{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clarity Trace Schema (Atmosphere Module)",
  "description": "Schema for validating clarity_trace.json — clarity signatures, truth extraction pulses, noise reduction sequences, pattern convergence traces, consensus alignment events, and multi-scale clarity indicators.",
  "type": "object",

  "properties": {
    "trace": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "required": ["name", "category", "version", "summary", "purpose"]
    },

    "context": {
      "type": "object",
      "properties": {
        "clarity_definition": { "type": "string" },
        "global_role": { "type": "string" }
      },
      "required": ["clarity_definition", "global_role"]
    },

    "signatures": {
      "type": "array",
      "items": { "type": "string" }
    },

    "agents": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["primary", "secondary"]
    },

    "fields": {
      "type": "object",
      "properties": {
        "truth_extraction_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "noise_reduction_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pattern_convergence_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consensus_alignment_field": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cross_domain_clarity_field": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "truth_extraction_field",
        "noise_reduction_field",
        "pattern_convergence_field",
        "consensus_alignment_field",
        "cross_domain_clarity_field"
      ]
    },

    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "scales": {
      "type": "object",
      "properties": {
        "micro": { "type": "string" },
        "meso": { "type": "string" },
        "macro": { "type": "string" },
        "mega": { "type": "string" }
      },
      "required": ["micro", "meso", "macro", "mega"]
    },

    "cascades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },

    "outputs": {
      "type": "object",
      "properties": {
        "traces": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["traces"]
    },

    "summary": {
      "type": "object",
      "properties": {
        "core_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" }
      },
      "required": ["core_capabilities", "role"]
    }
  },

  "required": [
    "trace",
    "context",
    "signatures",
    "agents",
    "fields",
    "paths",
    "scales",
    "cascades",
    "outputs",
    "summary"
  ]
}
