<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>TriadicFrameworks S3 Spine Visualizer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              base: { 900: '#0a0a12', 800: '#0f0f1a', 700: '#151522', 600: '#1a1a2e', 500: '#22223a' },
              cyan: { 400: '#00f5ff', 500: '#00d4dd', 600: '#00b3bb' },
              violet: { 400: '#7c3aed', 500: '#6d28d9', 600: '#5b21b6' },
              panel: { bg: '#0e0e18', border: '#1e1e30', hover: '#1a1a2e' }
            },
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace']
            }
          }
        }
      };
    </script>
    <style>
      :root {
        --bg: #0a0a12;
        --cyan: #00f5ff;
        --violet: #7c3aed;
        --panel-bg: #0e0e18;
        --panel-border: #1e1e30;
        --text-primary: #e8e8f0;
        --text-secondary: #9090a8;
        --text-dim: #5a5a72;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--bg); color: var(--text-primary); font-family: 'Inter', sans-serif; overflow: hidden; height: 100vh; }
      
      @keyframes pulse-glow {
        0%, 100% { filter: drop-shadow(0 0 6px rgba(0,245,255,0.3)); }
        50% { filter: drop-shadow(0 0 14px rgba(0,245,255,0.7)); }
      }
      @keyframes rotate-ring {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes node-enter {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }
      @keyframes flash-highlight {
        0% { filter: brightness(1); }
        50% { filter: brightness(2.5); }
        100% { filter: brightness(1); }
      }
      @keyframes spin-icon {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .webroot-pulse { animation: pulse-glow 3s ease-in-out infinite; }
      .selected-ring { animation: rotate-ring 4s linear infinite; }
      .node-flash { animation: flash-highlight 0.6s ease-out; }
      .spin-refresh { animation: spin-icon 0.8s ease-in-out; }
      
      .graph-tooltip {
        position: absolute; pointer-events: none; background: #1a1a2eee;
        border: 1px solid #2a2a44; border-radius: 8px; padding: 8px 12px;
        font-size: 12px; z-index: 100; backdrop-filter: blur(8px);
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        transition: opacity 0.15s;
      }
      .graph-tooltip .tt-name { color: #e8e8f0; font-weight: 600; font-size: 13px; }
      .graph-tooltip .tt-layer { color: #9090a8; font-size: 11px; margin-top: 2px; }

      #search-input-s3v::placeholder { color: #5a5a72; }
      #search-input-s3v:focus { outline: none; box-shadow: 0 0 0 2px rgba(0,245,255,0.3); }
      
      .pill-btn { transition: all 0.2s; cursor: pointer; user-select: none; }
      .pill-btn:hover { background: rgba(0,245,255,0.15); color: #00f5ff; }
      .pill-btn.active { background: rgba(0,245,255,0.2); color: #00f5ff; border-color: rgba(0,245,255,0.4); }
      
      .stat-card { background: rgba(255,255,255,0.03); border: 1px solid #1e1e30; border-radius: 10px; padding: 10px 14px; text-align: center; }
      .stat-card .stat-val { font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 600; color: #e8e8f0; }
      .stat-card .stat-label { font-size: 10px; color: #9090a8; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }

      .module-card { background: rgba(255,255,255,0.03); border: 1px solid #1e1e30; border-radius: 14px; padding: 20px; }
      
      .legend-item { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 8px; cursor: pointer; transition: background 0.15s; font-size: 12px; }
      .legend-item:hover { background: rgba(255,255,255,0.05); }
      .legend-item .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
      .legend-item .count { color: #5a5a72; font-family: 'JetBrains Mono', monospace; font-size: 11px; margin-left: auto; }

      .connected-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      
      #right-panel-s3v::-webkit-scrollbar { width: 5px; }
      #right-panel-s3v::-webkit-scrollbar-track { background: transparent; }
      #right-panel-s3v::-webkit-scrollbar-thumb { background: #2a2a44; border-radius: 4px; }
      
      .open-btn { background: linear-gradient(135deg, rgba(0,245,255,0.15), rgba(124,58,237,0.15)); border: 1px solid rgba(0,245,255,0.3); color: #00f5ff; border-radius: 10px; padding: 8px 16px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; }
      .open-btn:hover { background: linear-gradient(135deg, rgba(0,245,255,0.25), rgba(124,58,237,0.25)); border-color: rgba(0,245,255,0.5); }
      .open-btn:disabled { opacity: 0.3; cursor: not-allowed; }
      .open-btn:disabled:hover { background: linear-gradient(135deg, rgba(0,245,255,0.15), rgba(124,58,237,0.15)); border-color: rgba(0,245,255,0.3); }

      .badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 500; }

      .source-badge-live {
        background: rgba(34,197,94,0.15);
        border: 1px solid rgba(34,197,94,0.4);
        color: #22c55e;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .source-badge-embedded {
        background: rgba(245,158,11,0.15);
        border: 1px solid rgba(245,158,11,0.4);
        color: #f59e0b;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .refresh-btn {
        background: transparent;
        border: 1px solid #2a2a44;
        color: #9090a8;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
      }
      .refresh-btn:hover {
        border-color: rgba(0,245,255,0.4);
        color: #00f5ff;
        box-shadow: 0 0 8px rgba(0,245,255,0.15);
      }
      
      svg text { user-select: none; }

      #loading-overlay-s3v {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(10,10,18,0.85);
        z-index: 50;
        backdrop-filter: blur(4px);
        transition: opacity 0.3s;
      }
      #loading-overlay-s3v .loading-text {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: #00f5ff;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      #loading-overlay-s3v .loading-spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(0,245,255,0.2);
        border-top-color: #00f5ff;
        border-radius: 50%;
        animation: spin-icon 0.8s linear infinite;
      }

      @media (max-width: 768px) {
        #app-layout-s3v { flex-direction: column !important; }
        #graph-container-s3v { width: 100% !important; height: 55vh !important; }
        #right-panel-s3v { width: 100% !important; height: 45vh !important; border-left: none !important; border-top: 1px solid #1e1e30 !important; }
        #toolbar-s3v { flex-wrap: wrap; gap: 6px; }
        #filter-bar-s3v { flex-wrap: wrap; }
      }
    </style>
</head>
<body data-id="0">
    <app-icon data-id="1" hidden data-icon="hexagon" data-palette="Dark"></app-icon>

    <!-- TOOLBAR -->
    <div data-id="2" id="toolbar-s3v" class="flex items-center justify-between px-4 py-2 border-b" style="background:#0c0c16; border-color:#1e1e30; min-height:48px;">
      <div data-id="3" class="flex items-center gap-2">
        <span data-id="4" style="color:#00f5ff; font-size:18px;">⬡</span>
        <span data-id="5" class="font-mono text-sm font-semibold" style="color:#00f5ff;">S3 Spine Visualizer</span>
        <span data-id="6" id="data-source-badge-s3v" class="source-badge-embedded ml-2" style="display:none;"></span>
        <button data-id="7" id="refresh-btn-s3v" class="refresh-btn ml-1" title="Refresh data">
          <span data-id="8" id="refresh-icon-s3v" style="font-size:13px; display:inline-block;">↺</span>
          <span data-id="9" class="hidden sm:inline">Refresh</span>
        </button>
      </div>
      <div data-id="10" class="flex-1 max-w-xs mx-4">
        <input data-id="11" id="search-input-s3v" type="text" placeholder="Search modules..." class="w-full px-3 py-1.5 rounded-lg text-sm font-mono" style="background:#151522; border:1px solid #1e1e30; color:#e8e8f0;" />
      </div>
      <div data-id="12" class="hidden md:flex items-center gap-3 text-xs font-mono" id="header-stats-s3v" style="color:#9090a8;">
        <span data-id="13" class="px-2 py-1 rounded" style="background:rgba(0,245,255,0.08); color:#00f5ff;" id="stat-modules-header">55 modules</span>
        <span data-id="14" class="px-2 py-1 rounded" style="background:rgba(124,58,237,0.1); color:#a78bfa;" id="stat-edges-header">95 edges</span>
        <span data-id="15" class="px-2 py-1 rounded" style="background:rgba(20,184,166,0.1); color:#2dd4bf;" id="stat-layers-header">21 layers</span>
        <span data-id="16" class="px-2 py-1 rounded" style="background:rgba(236,72,153,0.1); color:#ec4899;" id="stat-r2-header">R2 ✦</span>
      </div>
    </div>

    <!-- FILTER BAR -->
    <div data-id="17" id="filter-bar-s3v" class="flex items-center gap-2 px-4 py-2 text-xs font-mono overflow-x-auto" style="background:#0b0b14; border-bottom:1px solid #1a1a28;">
      <span data-id="18" style="color:#5a5a72; margin-right:4px;">Edges:</span>
      <button data-id="19" class="pill-btn active px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="all">All</button>
      <button data-id="20" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="hierarchy">Hierarchy</button>
      <button data-id="21" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="import">Import</button>
      <button data-id="22" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="circular">Circular</button>
      <button data-id="23" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="related">Related</button>
      <button data-id="24" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-edge-filter="directed">Directed</button>
      <span data-id="25" style="color:#2a2a44; margin:0 4px;">|</span>
      <span data-id="26" style="color:#5a5a72; margin-right:4px;">Depth:</span>
      <button data-id="27" class="pill-btn active px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-depth-filter="all">All</button>
      <button data-id="28" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-depth-filter="0">0</button>
      <button data-id="29" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-depth-filter="1">1</button>
      <button data-id="30" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-depth-filter="2">2</button>
      <button data-id="31" class="pill-btn px-2.5 py-1 rounded-md border" style="border-color:#2a2a44;" data-depth-filter="3">3</button>
    </div>

    <!-- MAIN LAYOUT -->
    <div data-id="32" id="app-layout-s3v" class="flex" style="height:calc(100vh - 90px);">
      <!-- GRAPH -->
      <div data-id="33" id="graph-container-s3v" class="relative" style="width:70%; height:100%; overflow:hidden;">
        <svg data-id="34" id="graph-svg-s3v" width="100%" height="100%"></svg>
        <div data-id="35" id="tooltip-s3v" class="graph-tooltip" style="opacity:0;"></div>
        <!-- Loading overlay -->
        <div data-id="36" id="loading-overlay-s3v">
          <div data-id="37" class="loading-text">
            <div data-id="38" class="loading-spinner"></div>
            Loading spine data...
          </div>
        </div>
      </div>

      <!-- RIGHT PANEL -->
      <div data-id="39" id="right-panel-s3v" class="flex flex-col" style="width:30%; height:100%; background:#0e0e18; border-left:1px solid #1e1e30; overflow-y:auto;">
        
        <!-- Stats -->
        <div data-id="40" class="p-4 border-b" style="border-color:#1e1e30;">
          <div data-id="41" class="grid grid-cols-3 gap-2 mb-2">
            <div data-id="42" class="stat-card"><div data-id="43" class="stat-val" id="stat-modules-panel">55</div><div data-id="44" class="stat-label">Modules</div></div>
            <div data-id="45" class="stat-card"><div data-id="46" class="stat-val" style="color:#00f5ff;" id="stat-files-panel">1,461</div><div data-id="47" class="stat-label">Files</div></div>
            <div data-id="48" class="stat-card"><div data-id="49" class="stat-val" style="color:#a78bfa;" id="stat-r2-panel">20</div><div data-id="50" class="stat-label">R2 ✦</div></div>
          </div>
          <div data-id="51" class="grid grid-cols-2 gap-2">
            <div data-id="52" class="stat-card"><div data-id="53" class="stat-val text-base" id="stat-hierarchy-panel">54</div><div data-id="54" class="stat-label">Hierarchy</div></div>
            <div data-id="55" class="stat-card"><div data-id="56" class="stat-val text-base" id="stat-directed-panel">41</div><div data-id="57" class="stat-label">Directed</div></div>
          </div>
        </div>

        <!-- Module Card -->
        <div data-id="58" id="module-card-s3v" class="p-4 border-b" style="border-color:#1e1e30;">
          <div data-id="59" id="module-empty-s3v" class="text-center py-8">
            <div data-id="60" style="color:#5a5a72; font-size:40px; margin-bottom:8px;">⬡</div>
            <p data-id="61" class="text-sm" style="color:#5a5a72;">Click a node to inspect</p>
            <p data-id="62" class="text-xs mt-1" style="color:#3a3a52;">Double-click to open module URL</p>
          </div>
          <div data-id="63" id="module-detail-s3v" style="display:none;">
            <div data-id="64" class="flex items-center gap-3 mb-3">
              <div data-id="65" id="mod-circle-s3v" class="rounded-full flex-shrink-0" style="width:36px; height:36px;"></div>
              <div data-id="66">
                <div data-id="67" id="mod-name-s3v" class="font-semibold text-sm" style="color:#e8e8f0;"></div>
                <div data-id="68" id="mod-id-s3v" class="font-mono text-xs" style="color:#5a5a72;"></div>
              </div>
            </div>
            <div data-id="69" id="mod-badges-s3v" class="flex flex-wrap gap-1.5 mb-3"></div>
            <div data-id="70" id="mod-purpose-s3v" class="text-xs leading-relaxed mb-3" style="color:#9090a8; max-height:100px; overflow-y:auto;"></div>
            <div data-id="71" id="mod-meta-s3v" class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs mb-3" style="color:#9090a8;"></div>
            <div data-id="72" id="mod-open-s3v" class="mb-3"></div>
            <div data-id="73" id="mod-connections-s3v">
              <div data-id="74" class="text-xs font-medium mb-2" style="color:#5a5a72; text-transform:uppercase; letter-spacing:0.06em;">Connected Modules</div>
              <div data-id="75" id="mod-conn-list-s3v" class="flex flex-col gap-1"></div>
            </div>
          </div>
        </div>

        <!-- Legend -->
        <div data-id="76" class="p-4 flex-1">
          <div data-id="77" class="flex items-center justify-between mb-2">
            <span data-id="78" class="text-xs font-medium" style="color:#5a5a72; text-transform:uppercase; letter-spacing:0.06em;">Layer Legend</span>
            <button data-id="79" id="legend-reset-s3v" class="text-xs font-mono px-2 py-0.5 rounded" style="color:#00f5ff; background:rgba(0,245,255,0.08); cursor:pointer;">All layers</button>
          </div>
          <div data-id="80" id="legend-list-s3v" class="flex flex-col gap-0.5"></div>
        </div>

        <!-- Footer -->
        <div data-id="81" class="p-4 border-t text-center" style="border-color:#1e1e30;">
          <p data-id="82" id="footer-data-line-s3v" class="text-xs font-mono leading-relaxed" style="color:#3a3a52;">TriadicFrameworks S3 Spine — R2 Enriched · 55 A3 modules · rtt=1 | coherence=declared | drift=bounded</p>
          <p data-id="83" id="footer-source-line-s3v" class="text-xs font-mono mt-1" style="color:#3a3a52;">Data: EMBEDDED R2 · 55 modules · 1,461 files</p>
          <p data-id="84" class="text-xs mt-2" style="color:#3a3a52;">Made by Copilot</p>
        </div>
      </div>
    </div>

    <script>
    // ===== EMBEDDED FALLBACK DATA (kept as constant) =====
