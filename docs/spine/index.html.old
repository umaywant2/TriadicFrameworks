os_theory","type":"hierarchy","label":"contains"},{"source":"information_systems","target":"information_theory","type":"hierarchy","label":"contains"},{"source":"OPERATORS","target":"OPERATORS_TEACHING_BUNDLE","type":"hierarchy","label":"contains"},{"source":"OPERATORS","target":"structural_detection","type":"hierarchy","label":"contains"},{"source":"tft-core","target":"tops","type":"hierarchy","label":"contains"},{"source":"tft-core","target":"entft","type":"hierarchy","label":"contains"},{"source":"tft-core","target":"nous","type":"hierarchy","label":"contains"},{"source":"tft-core","target":"resonance-labs","type":"hierarchy","label":"contains"},{"source":"rtt-inside","target":"rtt-inside-benchmarks","type":"hierarchy","label":"contains"},{"source":"rtt-inside","target":"rtt-tel","type":"hierarchy","label":"contains"},{"source":"rtt-inside","target":"Mudpuppy","type":"hierarchy","label":"contains"},{"source":"rtt-inside","target":"SoftKitty","type":"hierarchy","label":"contains"},{"source":"rtt-integrations","target":"UE6-INTEGRATIONS","type":"hierarchy","label":"contains"},{"source":"scripts","target":"formats","type":"import","label":".fff files consumed as input"},{"source":"scripts","target":"entft","type":"import","label":"logic_core.sh <-> triadic logic"},{"source":"scripts","target":"tops","type":"import","label":"grid_ops.sh <-> grid_ops.py"},{"source":"docs","target":"entft","type":"import","label":"glyph lifecycle registries"},{"source":"docs","target":"formats","type":"import","label":".fff format spec mirrored"},{"source":"rtt-inside","target":"rtt-root","type":"import","label":"RTT core substrates and operators"},{"source":"rtt-codes","target":"rtt-root","type":"import","label":"QR payload schema references sub-schemas"},{"source":"research","target":"rtt-root","type":"import","label":"RTT/1 operators for domain research"},{"source":"fcg","target":"rtt-root","type":"import","label":"RTT/1 operators for framework grammar"},{"source":"entft","target":"tops","type":"circular","label":"Mutual runtime coupling"},{"source":"entft","target":"nous","type":"circular","label":"Mutual runtime coupling"},{"source":"incident_substrate_model","target":"gsm","type":"informs","label":"Incident model informs governance"},{"source":"rtt-inside-benchmarks","target":"rtt-tel","type":"export","label":"Benchmark results to TEL"},{"source":"rtt-tel","target":"rtt-inside-benchmarks","type":"import","label":"TEL imports benchmark records"},{"source":"rtt-inside-benchmarks","target":"rtt-paradoxes","type":"shares-regime-grammar","label":"Shared regime grammar"},{"source":"rtt-inside-benchmarks","target":"rtt-lowdim","type":"shares-operator-grammar","label":"Shared operator grammar"},{"source":"rtt-inside-benchmarks","target":"rtt-integrations","type":"provides-standards","label":"Benchmark standards for integrations"},{"source":"UE6-INTEGRATIONS","target":"rtt-inside-benchmarks","type":"propagates-to","label":"UE6 sessions propagate to benchmarks"},{"source":"UE6-INTEGRATIONS","target":"rtt-tel","type":"propagates-to","label":"UE6 events logged to TEL"},{"source":"RTT_MORPHIC_RESONANCE","target":"RTT_2","type":"parallel-to","label":"Parallel resonance-time layer"},{"source":"RTT_MORPHIC_RESONANCE","target":"RTT_3","type":"parallel-to","label":"Parallel resonance-time layer"},{"source":"OPERATORS","target":"RTT_2","type":"related","label":"Operator grammar feeds RTT/2"},{"source":"OPERATORS","target":"RTT_3","type":"related","label":"Operator grammar feeds RTT/3"},{"source":"STRUCTURAL_DETECTION_ENGINE","target":"OPERATORS","type":"related","label":"Detection engine is an operator"},{"source":"STRUCTURAL_INTEGRATION_ENGINE","target":"OPERATORS","type":"related","label":"Integration engine is an operator"},{"source":"STRUCTURAL_DETECTION_ENGINE","target":"RTT_2","type":"related","label":"SDE uses RTT/2"},{"source":"STRUCTURAL_INTEGRATION_ENGINE","target":"RTT_3","type":"related","label":"SIE uses RTT/3"},{"source":"Mudpuppy","target":"rtt-paradoxes","type":"references","label":"Paradoxes Canon referenced"},{"source":"SoftKitty","target":"rtt-paradoxes","type":"references","label":"Paradoxes Canon referenced"},{"source":"rtt-emotions","target":"RTT_MORPHIC_RESONANCE","type":"related","label":"Emotional operators interact with morphic field"},{"source":"OPERATORS","target":"OPERATORS_TEACHING_BUNDLE","type":"contains","label":"Teaching bundle pedagogical surface"},{"source":"rtt-tel","target":"STRUCTURAL_INTEGRATION_ENGINE","type":"alias","label":"TEL = Triadic Echo Lattice"},{"source":"STRUCTURAL_DETECTION_ENGINE","target":"STRUCTURAL_INTEGRATION_ENGINE","type":"upstream","label":"Echo Classifier feeds TEL"},{"source":"STRUCTURAL_INTEGRATION_ENGINE","target":"rtt-inside-benchmarks","type":"downstream","label":"TEL feeds Benchmarks"},{"source":"rtt-inside-benchmarks","target":"rtt-tel","type":"provides-data","label":"Benchmark data logged to TEL"},{"source":"rtt-integrations","target":"UE6-INTEGRATIONS","type":"contains","label":"UE6 integration container"},{"source":"RTT_MORPHIC_RESONANCE","target":"rtt-lowdim","type":"uses","label":"MR primitives on low-dim substrate"},{"source":"gsm","target":"rtt-root","type":"import","label":"Resonance-aware structural grammar"},{"source":"webroot","target":"rtt-root","type":"import","label":"RTT core substrates"}]};

    // ===== LAYER COLORS =====
    const LAYER_COLORS = {
      "Meta & Governance": "#00f5ff",
      "RTT Technology Layer": "#7c3aed",
      "Core Frameworks — Structural Spine": "#f59e0b",
      "Operator Layer": "#10b981",
      "RTT Dimensional": "#ec4899",
      "RTT Deployment Layer": "#3b82f6",
      "Tools & Infrastructure": "#6b7280",
      "Theories": "#14b8a6",
      "Theory": "#0d9488",
      "Education & Teaching": "#84cc16",
      "Applied Domain Models": "#f97316",
      "Research-Canonical": "#a78bfa",
      "Research & Validation": "#c084fc",
      "Framework-Structural": "#fb923c",
      "Integration & Deployment": "#38bdf8",
      "Ethics & Care": "#f43f5e",
      "Substrate Grammar": "#d97706",
      "Safety & Operations": "#ef4444",
      "Spacetime": "#818cf8",
      "RTT Analytics — Metadata Layer": "#2dd4bf",
      "RTT Hardware Layer": "#64748b"
    };

    const EDGE_COLORS = {
      "hierarchy": { color: "#334155", opacity: 0.4, dash: false },
      "import": { color: "#00f5ff", opacity: 0.6, dash: false },
      "circular": { color: "#f97316", opacity: 0.9, dash: true },
      "informs": { color: "#a78bfa", opacity: 0.7, dash: false },
      "related": { color: "#7c3aed", opacity: 0.5, dash: false },
      "upstream": { color: "#10b981", opacity: 0.7, dash: false },
      "downstream": { color: "#10b981", opacity: 0.7, dash: false },
      "parallel-to": { color: "#ec4899", opacity: 0.6, dash: false },
      "export": { color: "#3b82f6", opacity: 0.6, dash: false },
      "provides-data": { color: "#3b82f6", opacity: 0.6, dash: false },
      "provides-standards": { color: "#3b82f6", opacity: 0.6, dash: false },
      "references": { color: "#14b8a6", opacity: 0.5, dash: false },
      "alias": { color: "#64748b", opacity: 0.4, dash: true },
      "shares-regime-grammar": { color: "#7c3aed", opacity: 0.5, dash: false },
      "shares-operator-grammar": { color: "#7c3aed", opacity: 0.5, dash: false },
      "propagates-to": { color: "#10b981", opacity: 0.7, dash: false },
      "uses": { color: "#7c3aed", opacity: 0.5, dash: false },
      "contains": { color: "#334155", opacity: 0.4, dash: false }
    };
    const DEFAULT_EDGE_STYLE = { color: "#475569", opacity: 0.4, dash: false };

    const DIRECTED_TYPES = new Set(["import","circular","informs","related","upstream","downstream","parallel-to","export","provides-data","provides-standards","references","alias","shares-regime-grammar","shares-operator-grammar","propagates-to","uses"]);

    // ===== STATE =====
    let selectedNode = null;
    let activeEdgeFilter = "all";
    let activeDepthFilter = "all";
    let activeLayerFilter = null;
    let searchQuery = "";
    let dataSource = "embedded";
    let dataMetadata = { generated: null, version: null, round: null };
    let currentSimulation = null;
    let nodeMap = {};

    // Declare graph-level variables for reuse
    let currentNodes = [];
    let currentEdges = [];
    let linkElements = null;
    let nodeElements = null;
    let g = null;
    let zoom = null;

    // ===== INIT =====
    if (typeof lucide !== "undefined" && typeof lucide.createIcons === "function") {
      lucide.createIcons();
    }

    // ===== D3 GRAPH SETUP (svg, defs, zoom — created once) =====
    const container = document.getElementById("graph-container-s3v");
    const svg = d3.select("#graph-svg-s3v");

    const defs = svg.append("defs");

    // Glow filter for webroot
    const glowFilter = defs.append("filter").attr("id", "glow-webroot");
    glowFilter.append("feGaussianBlur").attr("stdDeviation", "4").attr("result", "blur");
    glowFilter.append("feMerge").selectAll("feMergeNode").data(["blur", "SourceGraphic"]).enter().append("feMergeNode").attr("in", d => d);

    // Selection glow
    const selGlow = defs.append("filter").attr("id", "glow-selected");
    selGlow.append("feGaussianBlur").attr("stdDeviation", "3").attr("result", "blur");
    selGlow.append("feMerge").selectAll("feMergeNode").data(["blur", "SourceGraphic"]).enter().append("feMergeNode").attr("in", d => d);

    g = svg.append("g");

    zoom = d3.zoom()
      .scaleExtent([0.15, 5])
      .on("zoom", (event) => {
        g.attr("transform", event.transform);
      });
    svg.call(zoom);

    // Click background → deselect
    svg.on("click", function() {
      deselectNode();
    });

    // ===== HELPER FUNCTIONS =====
    function nodeRadius(d) {
      const r = 8 + Math.sqrt(d.file_count) * 0.9;
      if (d.id === "webroot") return 22;
      return Math.min(Math.max(r, 8), 25);
    }

    function getConnectedEdges(nodeId) {
      return currentEdges.filter(e => {
        const sId = typeof e.source === "object" ? e.source.id : e.source;
        const tId = typeof e.target === "object" ? e.target.id : e.target;
        return sId === nodeId || tId === nodeId;
      });
    }
    function getNeighborIds(nodeId) {
      const ids = new Set();
      getConnectedEdges(nodeId).forEach(e => {
        const sId = typeof e.source === "object" ? e.source.id : e.source;
        const tId = typeof e.target === "object" ? e.target.id : e.target;
        if (sId !== nodeId) ids.add(sId);
        if (tId !== nodeId) ids.add(tId);
      });
      return ids;
    }

    function selectNode(d) {
      selectedNode = d;
      const neighborIds = getNeighborIds(d.id);
      neighborIds.add(d.id);

      nodeElements.each(function(nd) {
        const inSet = neighborIds.has(nd.id);
        d3.select(this).style("opacity", inSet ? 1 : 0.12);
        d3.select(this).select(".sel-ring")
          .attr("stroke-opacity", nd.id === d.id ? 0.8 : 0);
        if (nd.id === d.id) {
          d3.select(this).select(".sel-ring").classed("selected-ring", true);
        } else {
          d3.select(this).select(".sel-ring").classed("selected-ring", false);
        }
      });

      linkElements.each(function(e) {
        const sId = typeof e.source === "object" ? e.source.id : e.source;
        const tId = typeof e.target === "object" ? e.target.id : e.target;
        const connected = sId === d.id || tId === d.id;
        d3.select(this).attr("stroke-opacity", connected ? (EDGE_COLORS[e.type] || DEFAULT_EDGE_STYLE).opacity : 0.04);
      });

      showModuleCard(d, neighborIds);
    }

    function deselectNode() {
      selectedNode = null;
      if (nodeElements) {
        nodeElements.style("opacity", 1);
        nodeElements.selectAll(".sel-ring").attr("stroke-opacity", 0).classed("selected-ring", false);
      }
      if (linkElements) {
        linkElements.each(function(e) {
          d3.select(this).attr("stroke-opacity", (EDGE_COLORS[e.type] || DEFAULT_EDGE_STYLE).opacity);
        });
      }
      document.getElementById("module-empty-s3v").style.display = "";
      document.getElementById("module-detail-s3v").style.display = "none";
      applyFilters();
    }

    function showModuleCard(d, neighborIds) {
      document.getElementById("module-empty-s3v").style.display = "none";
      const detail = document.getElementById("module-detail-s3v");
      detail.style.display = "";

      const color = LAYER_COLORS[d.layer] || "#475569";
      document.getElementById("mod-circle-s3v").style.background = color;
      document.getElementById("mod-name-s3v").textContent = d.name;
      document.getElementById("mod-id-s3v").textContent = d.id;

      const badgesEl = document.getElementById("mod-badges-s3v");
      badgesEl.innerHTML = "";
      const addBadge = (text, bg, fg) => {
        const b = document.createElement("span");
        b.className = "badge";
        b.style.background = bg;
        b.style.color = fg;
        b.textContent = text;
        badgesEl.appendChild(b);
      };
      addBadge(`Depth ${d.depth}`, "rgba(255,255,255,0.06)", "#c0c0d0");
      addBadge(d.layer, color + "22", color);
      addBadge(`v${d.version}`, "rgba(124,58,237,0.12)", "#a78bfa");
      if (d.enriched_r2) addBadge("R2 ✦", "rgba(236,72,153,0.12)", "#ec4899");

      document.getElementById("mod-purpose-s3v").textContent = d.purpose;

      const metaEl = document.getElementById("mod-meta-s3v");
      metaEl.innerHTML = "";
      const addMeta = (label, val) => {
        metaEl.innerHTML += `<div><span style="color:#5a5a72;">${label}:</span></div><div style="color:#c0c0d0; font-family:'JetBrains Mono',monospace; font-size:11px; word-break:break-all;">${val}</div>`;
      };
      addMeta("Path", d.path);
      addMeta("Files", d.file_count.toLocaleString());
      addMeta("Status", d.status);
      addMeta("Parent", d.parent || "—");

      const openEl = document.getElementById("mod-open-s3v");
      openEl.innerHTML = "";
      const btn = document.createElement("button");
      btn.className = "open-btn";
      btn.innerHTML = "Open Module →";
      if (!d.url) btn.disabled = true;
      openEl.appendChild(btn);
      if (d.url) {
        btn.addEventListener("click", () => window.open(d.url, "_blank"));
      }

      const connList = document.getElementById("mod-conn-list-s3v");
      connList.innerHTML = "";
      const nIds = [...neighborIds].filter(id => id !== d.id).slice(0, 5);
      nIds.forEach(id => {
        const n = nodeMap[id];
        if (!n) return;
        const nColor = LAYER_COLORS[n.layer] || "#475569";
        const row = document.createElement("div");
        row.className = "flex items-center gap-2 text-xs py-1";
        row.innerHTML = `<span class="connected-dot" style="background:${nColor};"></span><span style="color:#c0c0d0;">${n.name.length > 28 ? n.name.slice(0, 26) + '…' : n.name}</span>`;
        connList.appendChild(row);
      });
      if (neighborIds.size - 1 > 5) {
        const more = document.createElement("div");
        more.className = "text-xs mt-1";
        more.style.color = "#5a5a72";
        more.textContent = `+${neighborIds.size - 1 - 5} more`;
        connList.appendChild(more);
      }
    }

    // ===== FILTERS =====
    function applyFilters() {
      if (selectedNode) return;
      if (!nodeElements || !linkElements) return;

      nodeElements.each(function(d) {
        let visible = true;
        if (activeDepthFilter !== "all" && d.depth !== parseInt(activeDepthFilter)) visible = false;
        if (activeLayerFilter && d.layer !== activeLayerFilter) visible = false;
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const match = d.name.toLowerCase().includes(q) || d.id.toLowerCase().includes(q) || d.layer.toLowerCase().includes(q);
          if (!match) visible = false;
        }
        d3.select(this).style("opacity", visible ? 1 : (searchQuery ? 0.06 : 0.08));
        if (visible && searchQuery) {
          d3.select(this).select(".main-circle").classed("node-flash", true);
          setTimeout(() => d3.select(this).select(".main-circle").classed("node-flash", false), 600);
        }
      });

      linkElements.each(function(e) {
        const s = EDGE_COLORS[e.type] || DEFAULT_EDGE_STYLE;
        let show = true;
        if (activeEdgeFilter !== "all") {
          if (activeEdgeFilter === "directed") {
            show = DIRECTED_TYPES.has(e.type);
          } else {
            show = e.type === activeEdgeFilter;
          }
        }
        d3.select(this).attr("stroke-opacity", show ? s.opacity : 0.02);
      });
    }

    // ===== UPDATE UI BADGES AND STATS =====
    function updateDataSourceUI(nodes, edges) {
      const badge = document.getElementById("data-source-badge-s3v");
      const totalFiles = nodes.reduce((sum, n) => sum + (n.file_count || 0), 0);
      const totalModules = nodes.length;
      const totalEdges = edges.length;
      const uniqueLayers = new Set(nodes.map(n => n.layer)).size;
      const r2Count = nodes.filter(n => n.enriched_r2).length;
      const hierarchyCount = edges.filter(e => e.type === "hierarchy" || e.type === "contains").length;
      const directedCount = edges.filter(e => DIRECTED_TYPES.has(e.type)).length;

      if (dataSource === "live") {
        const dateStr = dataMetadata.generated ? dataMetadata.generated.substring(0, 10) : "unknown";
        const roundStr = dataMetadata.round || "R2";
        badge.className = "source-badge-live ml-2";
        badge.textContent = `🟢 LIVE · ${roundStr} · ${dateStr}`;
      } else {
        badge.className = "source-badge-embedded ml-2";
        badge.textContent = `📦 EMBEDDED · R2 · ${totalFiles.toLocaleString()} files`;
      }
      badge.style.display = "inline-flex";

      // Header stats
      document.getElementById("stat-modules-header").textContent = `${totalModules} modules`;
      document.getElementById("stat-edges-header").textContent = `${totalEdges} edges`;
      document.getElementById("stat-layers-header").textContent = `${uniqueLayers} layers`;

      // Panel stats
      document.getElementById("stat-modules-panel").textContent = totalModules;
      document.getElementById("stat-files-panel").textContent = totalFiles.toLocaleString();
      document.getElementById("stat-r2-panel").textContent = r2Count;
      document.getElementById("stat-hierarchy-panel").textContent = hierarchyCount;
      document.getElementById("stat-directed-panel").textContent = directedCount;

      // Footer data line
      const footerMain = document.getElementById("footer-data-line-s3v");
      footerMain.textContent = `TriadicFrameworks S3 Spine — R2 Enriched · ${totalModules} A3 modules · rtt=1 | coherence=declared | drift=bounded`;

      const footerSource = document.getElementById("footer-source-line-s3v");
      if (dataSource === "live") {
        const dateStr = dataMetadata.generated ? dataMetadata.generated.substring(0, 10) : "unknown";
        footerSource.textContent = `Data: LIVE from /spine/module_graph.json · ${dateStr} · ${totalModules} modules · ${totalFiles.toLocaleString()} files`;
      } else {
        footerSource.textContent = `Data: EMBEDDED R2 · ${totalModules} modules · ${totalFiles.toLocaleString()} files`;
      }
    }

    // ===== BUILD LEGEND =====
    function buildLegend(nodes) {
      const layerCounts = {};
      nodes.forEach(n => {
        layerCounts[n.layer] = (layerCounts[n.layer] || 0) + 1;
      });
      const legendList = document.getElementById("legend-list-s3v");
      legendList.innerHTML = "";
      Object.keys(LAYER_COLORS).forEach(layer => {
        if (!layerCounts[layer]) return;
        const item = document.createElement("div");
        item.className = "legend-item";
        item.dataset.layer = layer;
        item.innerHTML = `<span class="dot" style="background:${LAYER_COLORS[layer]};"></span><span style="color:#c0c0d0;">${layer}</span><span class="count">${layerCounts[layer]}</span>`;
        legendList.appendChild(item);
        item.addEventListener("click", function() {
          activeLayerFilter = this.dataset.layer;
          if (selectedNode) deselectNode();
          document.querySelectorAll("#legend-list-s3v .legend-item").forEach(i => i.style.background = "");
          this.style.background = "rgba(255,255,255,0.05)";
          applyFilters();
        });
      });
    }

    // ===== INIT GRAPH (accepts nodes, edges) =====
    function initGraph(rawNodes, rawEdges) {
      // Stop previous simulation
      if (currentSimulation) {
        currentSimulation.stop();
        currentSimulation = null;
      }

      // Clear previous graph elements
      g.selectAll("*").remove();

      // Remove old arrow markers (keep glow filters)
      defs.selectAll("marker").remove();

      // Reset state
      selectedNode = null;
      activeLayerFilter = null;
      document.getElementById("module-empty-s3v").style.display = "";
      document.getElementById("module-detail-s3v").style.display = "none";

      // Copy data
      const nodes = rawNodes.map(d => ({ ...d }));
      const edges = rawEdges.map(d => ({ ...d }));
      currentNodes = nodes;
      currentEdges = edges;
      nodeMap = {};
      nodes.forEach(n => { nodeMap[n.id] = n; });

      const width = container.clientWidth;
      const height = container.clientHeight;

      // Build legend
      buildLegend(nodes);

      // Update UI
      updateDataSourceUI(nodes, edges);

      // Arrowhead markers
      const arrowColors = new Set();
      edges.forEach(e => {
        const s = EDGE_COLORS[e.type] || DEFAULT_EDGE_STYLE;
        arrowColors.add(s.color);
      });
      arrowColors.forEach(c => {
        const id = "arrow-" + c.replace("#", "");
        defs.append("marker")
          .attr("id", id)
          .attr("viewBox", "0 -5 10 10")
          .attr("refX", 20)
          .attr("refY", 0)
          .attr("markerWidth", 6)
          .attr("markerHeight", 6)
          .attr("orient", "auto")
          .append("path")
          .attr("d", "M0,-4L10,0L0,4")
          .attr("fill", c);
      });

      // Simulation
      const simulation = d3.forceSimulation(nodes)
        .force("link", d3.forceLink(edges).id(d => d.id).distance(d => d.type === "hierarchy" ? 80 : 150).strength(d => d.type === "hierarchy" ? 0.8 : 0.3))
        .force("charge", d3.forceManyBody().strength(-300))
        .force("center", d3.forceCenter(width / 2, height / 2))
        .force("collide", d3.forceCollide().radius(d => nodeRadius(d) + 8))
        .alphaDecay(0.02);
      currentSimulation = simulation;

      // Edges
      const linkGroup = g.append("g").attr("class", "links");
      linkElements = linkGroup.selectAll("line")
        .data(edges)
        .enter().append("line")
        .each(function(d) {
          const s = EDGE_COLORS[d.type] || DEFAULT_EDGE_STYLE;
          const el = d3.select(this);
          el.attr("stroke", s.color)
            .attr("stroke-opacity", s.opacity)
            .attr("stroke-width", d.type === "hierarchy" ? 1 : 1.5)
            .attr("marker-end", `url(#arrow-${s.color.replace("#", "")})`)
            .attr("data-edge-type", d.type);
          if (s.dash) {
            el.attr("stroke-dasharray", "5,4");
          }
        });

      // Node groups
      const nodeGroup = g.append("g").attr("class", "nodes");
      nodeElements = nodeGroup.selectAll("g")
        .data(nodes)
        .enter().append("g")
        .attr("class", "node-g")
        .style("cursor", "pointer");

      // Background glow for webroot
      nodeElements.filter(d => d.id === "webroot")
        .append("circle")
        .attr("r", d => nodeRadius(d) + 6)
        .attr("fill", "none")
        .attr("stroke", "#00f5ff")
        .attr("stroke-width", 2)
        .attr("stroke-opacity", 0.3)
        .attr("filter", "url(#glow-webroot)")
        .classed("webroot-pulse", true);

      // Selected ring (hidden initially)
      nodeElements.append("circle")
        .attr("class", "sel-ring")
        .attr("r", d => nodeRadius(d) + 5)
        .attr("fill", "none")
        .attr("stroke", "#fff")
        .attr("stroke-width", 2)
        .attr("stroke-dasharray", "4,3")
        .attr("stroke-opacity", 0)
        .attr("filter", "url(#glow-selected)");

      // Main circle
      nodeElements.append("circle")
        .attr("class", "main-circle")
        .attr("r", d => nodeRadius(d))
        .attr("fill", d => LAYER_COLORS[d.layer] || "#475569")
        .attr("fill-opacity", d => d.depth === 3 ? 0.85 : 1)
        .attr("stroke", "#ffffff")
        .attr("stroke-width", 1.5)
        .attr("stroke-opacity", 0.6);

      // R2 enriched marker
      nodeElements.filter(d => d.enriched_r2)
        .append("text")
        .attr("text-anchor", "middle")
        .attr("dy", "0.35em")
        .attr("font-size", d => Math.max(8, nodeRadius(d) * 0.55))
        .attr("fill", "#fff")
        .attr("pointer-events", "none")
        .text("✦");

      // Labels
      nodeElements.append("text")
        .attr("text-anchor", "middle")
        .attr("dy", d => nodeRadius(d) + 14)
        .attr("font-size", "9px")
        .attr("font-family", "'JetBrains Mono', monospace")
        .attr("fill", "#7a7a92")
        .attr("pointer-events", "none")
        .text(d => d.id.length > 14 ? d.id.slice(0, 12) + "…" : d.id);

      // Node entry animation
      nodeElements.each(function(d, i) {
        const el = d3.select(this);
        el.style("opacity", 0)
          .transition()
          .delay(d.depth * 150 + i * 15)
          .duration(500)
          .style("opacity", 1);
      });

      // Drag
      const drag = d3.drag()
        .on("start", (event, d) => {
          if (!event.active) simulation.alphaTarget(0.3).restart();
          d.fx = d.x; d.fy = d.y;
        })
        .on("drag", (event, d) => {
          d.fx = event.x; d.fy = event.y;
        })
        .on("end", (event, d) => {
          if (!event.active) simulation.alphaTarget(0);
          d.fx = null; d.fy = null;
        });
      nodeElements.call(drag);

      // Tooltip
      const tooltip = document.getElementById("tooltip-s3v");
      nodeElements.on("mouseenter", function(event, d) {
        const layerColor = LAYER_COLORS[d.layer] || "#475569";
        tooltip.innerHTML = `<div class="tt-name">${d.name}</div><div class="tt-layer" style="color:${layerColor};">${d.layer}</div>`;
        tooltip.style.opacity = "1";
        d3.select(this).select(".main-circle")
          .attr("stroke-width", 3)
          .attr("stroke-opacity", 1)
          .attr("stroke", "#fff");
      });
      nodeElements.on("mousemove", function(event) {
        const rect = container.getBoundingClientRect();
        const x = event.clientX - rect.left + 14;
        const y = event.clientY - rect.top - 10;
        tooltip.style.left = Math.min(x, rect.width - 200) + "px";
        tooltip.style.top = y + "px";
      });
      nodeElements.on("mouseleave", function(event, d) {
        tooltip.style.opacity = "0";
        const isSelected = selectedNode && selectedNode.id === d.id;
        d3.select(this).select(".main-circle")
          .attr("stroke-width", isSelected ? 3 : 1.5)
          .attr("stroke-opacity", isSelected ? 1 : 0.6)
          .attr("stroke", "#fff");
      });

      // Click node
      nodeElements.on("click", function(event, d) {
        event.stopPropagation();
        selectNode(d);
      });

      // Double-click → open URL
      nodeElements.on("dblclick", function(event, d) {
        event.stopPropagation();
        if (d.url) window.open(d.url, "_blank");
      });

      // Tick
      simulation.on("tick", () => {
        linkElements
          .attr("x1", d => d.source.x)
          .attr("y1", d => d.source.y)
          .attr("x2", d => d.target.x)
          .attr("y2", d => d.target.y);
        nodeElements.attr("transform", d => `translate(${d.x},${d.y})`);
      });

      // Auto-fit after simulation settles
      simulation.on("end", () => {
        const bounds = g.node().getBBox();
        if (bounds.width > 0 && bounds.height > 0) {
          const w = container.clientWidth;
          const h = container.clientHeight;
          const scale = Math.min(w / (bounds.width + 100), h / (bounds.height + 100), 1.2);
          const tx = w / 2 - (bounds.x + bounds.width / 2) * scale;
          const ty = h / 2 - (bounds.y + bounds.height / 2) * scale;
          svg.transition().duration(800)
            .call(zoom.transform, d3.zoomIdentity.translate(tx, ty).scale(scale));
        }
      });

      // Hide loading overlay
      const overlay = document.getElementById("loading-overlay-s3v");
      if (overlay) {
        overlay.style.opacity = "0";
        setTimeout(() => { overlay.style.display = "none"; }, 300);
      }
    }

    // ===== DATA LOADING =====
    async function loadGraphData() {
      // Show loading overlay
      const overlay = document.getElementById("loading-overlay-s3v");
      if (overlay) {
        overlay.style.display = "flex";
        overlay.style.opacity = "1";
      }

      let fetchedData = null;

      try {
        const response = await fetch("/spine/module_graph.json", { cache: "no-cache" });
        if (response.ok) {
          const data = await response.json();

          // Transform fetched format to GRAPH_DATA format
          const nodes = Object.entries(data.nodes).map(([id, m]) => ({
            id,
            name: m.name,
            layer: m.layer,
            depth: m.depth || 0,
            file_count: m.stats?.file_count ?? m.file_count ?? 0,
            parent: m.parent,
            url: m.url,
            purpose: m.purpose || '',
            version: m.version || '1.0',
            status: m.status || 'Active, Canonical',
            enriched_r2: m.enriched_r2 || false,
            path: m.path || ''
          }));

          // Build node ID set for edge validation
          const nodeIdSet = new Set(nodes.map(n => n.id));

          const hierarchyEdges = (data.hierarchy?.edges || []).map(e => ({
            source: e.parent,
            target: e.child,
            type: 'hierarchy',
            label: 'contains'
          }));

          const otherEdges = (data.edges || []).map(e => ({
            source: e.from || e.source,
            target: e.to || e.target,
            type: e.type || 'import',
            label: (e.label || '').substring(0, 80)
          }));

          const edges = [...hierarchyEdges, ...otherEdges].filter(e => e.source && e.target && nodeIdSet.has(e.source) && nodeIdSet.has(e.target));

          // Store metadata
          dataMetadata.generated = data.$generated || null;
          dataMetadata.version = data.$version || null;
          dataMetadata.round = data.$round || null;
          dataSource = "live";

          fetchedData = { nodes, edges };
        }
      } catch (err) {
        // Fetch failed (CORS, network, sandbox) — fall through to embedded
      }

      if (fetchedData) {
        initGraph(fetchedData.nodes, fetchedData.edges);
      } else {
        // Fallback to embedded GRAPH_DATA
        dataSource = "embedded";
        dataMetadata = { generated: null, version: null, round: null };
        initGraph(GRAPH_DATA.nodes, GRAPH_DATA.edges);
      }
    }

    // ===== EVENT BINDINGS =====

    // Edge filter buttons
    document.querySelectorAll("[data-edge-filter]").forEach(btn => {
      btn.addEventListener("click", function() {
        document.querySelectorAll("[data-edge-filter]").forEach(b => b.classList.remove("active"));
        this.classList.add("active");
        activeEdgeFilter = this.dataset.edgeFilter;
        if (selectedNode) deselectNode();
        applyFilters();
      });
    });

    // Depth filter buttons
    document.querySelectorAll("[data-depth-filter]").forEach(btn => {
      btn.addEventListener("click", function() {
        document.querySelectorAll("[data-depth-filter]").forEach(b => b.classList.remove("active"));
        this.classList.add("active");
        activeDepthFilter = this.dataset.depthFilter;
        if (selectedNode) deselectNode();
        applyFilters();
      });
    });

    // Search
    document.getElementById("search-input-s3v").addEventListener("input", function() {
      searchQuery = this.value.trim();
      if (selectedNode) deselectNode();
      applyFilters();
    });

    // Legend reset
    document.getElementById("legend-reset-s3v").addEventListener("click", function() {
      activeLayerFilter = null;
      document.querySelectorAll("#legend-list-s3v .legend-item").forEach(i => i.style.background = "");
      if (selectedNode) deselectNode();
      applyFilters();
    });

    // Refresh button
    document.getElementById("refresh-btn-s3v").addEventListener("click", function() {
      const icon = document.getElementById("refresh-icon-s3v");
      icon.classList.add("spin-refresh");
      setTimeout(() => icon.classList.remove("spin-refresh"), 800);
      loadGraphData();
    });

    // Resize
    window.addEventListener("resize", () => {
      if (currentSimulation) {
        const w = container.clientWidth;
        const h = container.clientHeight;
        currentSimulation.force("center", d3.forceCenter(w / 2, h / 2));
        currentSimulation.alpha(0.3).restart();
      }
    });

    // ===== INITIAL LOAD =====
    loadGraphData();
    </script>
</body>
</html>