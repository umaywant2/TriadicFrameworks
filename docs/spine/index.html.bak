const LAYER_COLORS = {
  "Meta & Governance":"#4a9eff",
  "Operator Layer":"#f39c12",
  "RTT Technology Layer":"#e74c3c",
  "Education & Teaching":"#2ecc71",
  "Applied Domain Models":"#9b59b6",
  "Core Frameworks — Structural Spine":"#1abc9c",
  "Theory":"#3498db",
  "Substrate Grammar":"#e67e22",
  "Research-Canonical":"#1abc9c",
  "Integration & Deployment":"#95a5a6",
  "Safety & Operations":"#e74c3c",
  "Tools & Infrastructure":"#7f8c8d",
  "Ethics & Care":"#27ae60",
  "Framework-Structural":"#c0392b",
  "RTT Deployment Layer":"#8e44ad",
  "Root":"#ffffff",
};

// Build legend
const legendEl = document.getElementById('legend');
const seenLayers = new Set();
GRAPH_DATA.nodes.forEach(n => seenLayers.add(n.layer));
[...seenLayers].sort().forEach(layer => {
  const c = LAYER_COLORS[layer] || '#95a5a6';
  const div = document.createElement('div');
  div.className = 'leg-item';
  div.innerHTML = `<div class="leg-dot" style="background:${c}"></div><span>${layer}</span>`;
  div.onclick = () => filterByLayer(layer);
  legendEl.appendChild(div);
});

// ── D3 Setup ──────────────────────────────────────────────────────────────────
const svg = d3.select('#graph');
const W = window.innerWidth, H = window.innerHeight;
const g = svg.append('g');

const zoom = d3.zoom().scaleExtent([0.05, 4]).on('zoom', e => g.attr('transform', e.transform));
svg.call(zoom);

let activeNodes = GRAPH_DATA.nodes;
let activeEdges = GRAPH_DATA.edges;

function buildNodeMap(nodes) {
  const m = {};
  nodes.forEach(n => m[n.id] = n);
  return m;
}

function render(nodes, edges) {
  g.selectAll('*').remove();

  const nodeMap = buildNodeMap(nodes);
  const validEdges = edges.filter(e => nodeMap[e.source] && nodeMap[e.target]);

  const sim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(validEdges).id(d => d.id).distance(d => {
      const sd = nodeMap[d.source]?.depth ?? 1;
      const td = nodeMap[d.target]?.depth ?? 1;
      return 60 + (sd + td) * 15;
    }).strength(0.4))
    .force('charge', d3.forceManyBody().strength(d => d.depth === 0 ? -800 : d.depth === 1 ? -200 : -80))
    .force('center', d3.forceCenter(W / 2, H / 2))
    .force('collision', d3.forceCollide().radius(d => [18,12,8,6][d.depth] || 6))
    .alphaDecay(0.02);

  // Links
  const link = g.append('g').selectAll('line')
    .data(validEdges).join('line')
    .attr('class', d => `link ${d.type || 'feeds'}`)
    .attr('marker-end', 'none');

  // Nodes
  const node = g.append('g').selectAll('.node')
    .data(nodes).join('g')
    .attr('class', d => `node depth-${d.depth}${d.enriched_r5 ? ' r5' : ''}`)
    .call(d3.drag()
      .on('start', (e,d) => { if(!e.active) sim.alphaTarget(0.3).restart(); d.fx=d.x; d.fy=d.y; })
      .on('drag',  (e,d) => { d.fx=e.x; d.fy=e.y; })
      .on('end',   (e,d) => { if(!e.active) sim.alphaTarget(0); d.fx=null; d.fy=null; }));

  node.append('circle')
    .attr('fill', d => d.color || LAYER_COLORS[d.layer] || '#95a5a6')
    .on('click', (e,d) => { if(d.url) window.open(d.url,'_blank'); })
    .on('mouseover', (e,d) => showTooltip(e,d))
    .on('mousemove', (e) => moveTooltip(e))
    .on('mouseout',  () => hideTooltip());

  node.filter(d => d.depth <= 2).append('text')
    .attr('dy', d => ([18,12,8,6][d.depth]||6) + 11)
    .text(d => d.name.length > 18 ? d.name.slice(0,17)+'…' : d.name);

  sim.on('tick', () => {
    link.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y)
        .attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);
    node.attr('transform',d=>`translate(${d.x},${d.y})`);
  });
}

// ── Tooltip ───────────────────────────────────────────────────────────────────
const tip = document.getElementById('tooltip');
function showTooltip(e,d) {
  tip.innerHTML = `
    <div class="t-name">${d.name}</div>
    <div class="t-row">ID: <span>${d.id}</span></div>
    <div class="t-row">Layer: <span>${d.layer}</span></div>
    <div class="t-row">Depth: <span>${d.depth}</span></div>
    <div class="t-row">Files: <span>${d.file_count}</span></div>
    <div class="t-row">Parent: <span>${d.parent}</span></div>
    <div class="t-row">Status: <span>${d.status}</span></div>
    ${d.enriched_r5 ? '<div class="t-r5">★ New in R5 — Spine Overlay Pack v2.0</div>' : ''}
    <div class="t-row" style="margin-top:4px;font-size:9px;color:#4a9eff;">Click to open ↗</div>
  `;
  tip.style.display = 'block';
  moveTooltip(e);
}
function moveTooltip(e) {
  const x = e.clientX + 14, y = e.clientY - 10;
  tip.style.left = (x + 270 > W ? x - 280 : x) + 'px';
  tip.style.top  = (y + 200 > H ? y - 210 : y) + 'px';
}
function hideTooltip() { tip.style.display = 'none'; }

// ── Search ────────────────────────────────────────────────────────────────────
document.getElementById('search-box').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  if (!q) { render(GRAPH_DATA.nodes, GRAPH_DATA.edges); return; }
  const match = new Set(GRAPH_DATA.nodes.filter(n =>
    n.name.toLowerCase().includes(q) || n.id.toLowerCase().includes(q) || n.layer.toLowerCase().includes(q)
  ).map(n => n.id));
  // Include parents up to root
  GRAPH_DATA.nodes.forEach(n => { if(match.has(n.id) && n.parent) match.add(n.parent); });
  const nodes = GRAPH_DATA.nodes.filter(n => match.has(n.id));
  const edges = GRAPH_DATA.edges.filter(e => match.has(e.source) && match.has(e.target));
  render(nodes, edges);
});

// ── Filter buttons ────────────────────────────────────────────────────────────
function filterByLayer(layer) {
  const nodes = GRAPH_DATA.nodes.filter(n => n.layer === layer || n.depth === 0);
  const ids = new Set(nodes.map(n=>n.id));
  const edges = GRAPH_DATA.edges.filter(e => ids.has(e.source) && ids.has(e.target));
  render(nodes, edges);
}

document.getElementById('btn-reset').onclick = () => {
  render(GRAPH_DATA.nodes, GRAPH_DATA.edges);
  svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity.translate(0,0).scale(1));
};
document.getElementById('btn-all').onclick   = () => render(GRAPH_DATA.nodes, GRAPH_DATA.edges);
document.getElementById('btn-r5').onclick    = () => {
  const nodes = GRAPH_DATA.nodes.filter(n => n.enriched_r5 || n.depth === 0);
  const ids = new Set(nodes.map(n=>n.id));
  const edges = GRAPH_DATA.edges.filter(e => ids.has(e.source) && ids.has(e.target));
  render(nodes, edges);
};
document.getElementById('btn-spine').onclick = () => {
  const spineIds = new Set(['webroot','spine-overlay-pack','spine-structural','spine-drift',
    'spine-coherence','spine-substrate','spine-dimensional','spine-domain',
    'STRUCTURAL_FAULTLINE_DETECTOR','DRIFT_SENTINEL','COHERENCE_TENSOR_ENGINE',
    'STABILITY_BASIN_CARTOGRAPHER','DIMENSIONAL_RESONANCE_SCANNER',
    'TRIADIC_REGIME_SYNTHESIZER','CROSS_DOMAIN_CAUSALITY_WEAVER',
    'CRYSTAL_MYCELIAL_ENGINE','PARADOX_GRADIENT_ANALYZER',
    'REGIME_INTERLOCK_MAPPER','TEMPORAL_REGIME_SEQUENCER',
    'STABILITY_BASIN_CARTOGRAPHER','ipd-12','tft-opengpu',
    'atmosphere','expectations','grammar-for-intelligence',
    'RTT_INSIDE_ENTERPRISE','RTT_INSIDE_QCOMPUTE',
    'rtt-inside','rtt-root','education','prompts','rtt-infinity-prompts']);
  const nodes = GRAPH_DATA.nodes.filter(n => spineIds.has(n.id));
  const ids = new Set(nodes.map(n=>n.id));
  const edges = GRAPH_DATA.edges.filter(e => ids.has(e.source) && ids.has(e.target));
  render(nodes, edges);
};

window.addEventListener('resize', () => render(GRAPH_DATA.nodes, GRAPH_DATA.edges));

// Initial render
render(GRAPH_DATA.nodes, GRAPH_DATA.edges);
</script>
</body>
</html>
