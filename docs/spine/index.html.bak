<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:#0a0a0f;color:#e0e0e0;font-family:'Segoe UI',system-ui,sans-serif;overflow:hidden;}
  #canvas{width:100vw;height:100vh;}
  svg{width:100%;height:100%;}
  .link{stroke-opacity:0.45;stroke-width:1.2;}
  .link.feeds{stroke:#4a9eff;}
  .link.primary-engine{stroke:#e74c3c;stroke-width:2;stroke-dasharray:6,3;}
  .link.co-primary-engine{stroke:#f39c12;stroke-width:2;stroke-dasharray:6,3;}
  .link.coordinate-system{stroke:#2ecc71;stroke-dasharray:4,4;}
  .link.environmental-signal{stroke:#9b59b6;stroke-dasharray:3,5;}
  .link.envelope-provider{stroke:#1abc9c;stroke-dasharray:4,4;}
  .link.tertiary-engine{stroke:#e67e22;stroke-dasharray:5,4;}
  .link.compute-layer{stroke:#7f8c8d;stroke-dasharray:4,4;}
  .link.narration-grammar{stroke:#27ae60;stroke-dasharray:3,5;}
  .link.implements{stroke:#c0392b;}
  .link.uses{stroke:#95a5a6;stroke-dasharray:3,5;}
  .link.contains-ref{stroke:#555;stroke-dasharray:2,4;}
  .node circle{stroke:#0a0a0f;stroke-width:1.5;cursor:pointer;transition:opacity 0.2s;}
  .node circle:hover{stroke:#fff;stroke-width:2.5;opacity:1!important;}
  .node text{font-size:9px;fill:#ccc;pointer-events:none;text-anchor:middle;}
  .node.depth-0 circle{r:18;}
  .node.depth-1 circle{r:9;}
  .node.depth-2 circle{r:6;}
  .node.depth-3 circle{r:4;}
  .node.r5 circle{stroke:#f1c40f;stroke-width:2;}
  /* PANEL */
  #panel{position:fixed;top:0;left:0;width:280px;height:100vh;background:rgba(10,10,20,0.92);border-right:1px solid #222;padding:20px 16px;overflow-y:auto;z-index:10;}
  #panel h1{font-size:14px;color:#4a9eff;letter-spacing:.05em;margin-bottom:2px;}
  #panel .sub{font-size:10px;color:#888;margin-bottom:16px;}
  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;}
  .stat{background:#111;border:1px solid #222;border-radius:6px;padding:8px;text-align:center;}
  .stat .val{font-size:22px;font-weight:700;color:#4a9eff;line-height:1;}
  .stat .lbl{font-size:9px;color:#888;margin-top:2px;}
  .ctx-grid{font-size:10px;}
  .ctx-grid tr td:first-child{color:#888;padding-right:8px;white-space:nowrap;}
  .ctx-grid tr td:last-child{color:#ccc;}
  #legend{margin-top:12px;}
  #legend h2{font-size:10px;color:#666;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;}
  .leg-item{display:flex;align-items:center;gap:7px;font-size:9px;color:#aaa;margin-bottom:4px;cursor:pointer;}
  .leg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  #tooltip{position:fixed;background:rgba(10,10,20,0.96);border:1px solid #333;border-radius:8px;padding:10px 13px;font-size:11px;pointer-events:none;z-index:100;max-width:260px;display:none;}
  #tooltip .t-name{font-weight:700;color:#fff;margin-bottom:4px;}
  #tooltip .t-row{color:#aaa;margin-bottom:2px;}
  #tooltip .t-row span{color:#ccc;}
  #tooltip .t-r5{color:#f1c40f;font-size:10px;margin-top:4px;}
  #search-box{width:100%;background:#111;border:1px solid #333;border-radius:5px;color:#ccc;padding:6px 8px;font-size:11px;margin-bottom:12px;outline:none;}
  #search-box:focus{border-color:#4a9eff;}
  .section-head{font-size:9px;color:#555;text-transform:uppercase;letter-spacing:.1em;margin:12px 0 6px;}
  .spine-badge{display:inline-block;background:#1abc9c22;border:1px solid #1abc9c55;border-radius:4px;color:#1abc9c;font-size:9px;padding:1px 5px;margin-left:4px;}
  /* Controls */
  #controls{position:fixed;bottom:16px;right:16px;z-index:10;display:flex;gap:8px;}
  #controls button{background:#111;border:1px solid #333;color:#aaa;border-radius:5px;padding:6px 12px;font-size:10px;cursor:pointer;}
  #controls button:hover{background:#222;color:#fff;}
</style>
</head>
