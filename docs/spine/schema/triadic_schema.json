{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://triadic-atlas/schema/v1/language-module",
  "title": "Triadic Atlas Language Module Schema v1.0",
  "description": "Defines the structure of a single language module in the Triadic Languages Atlas Starter Edition. All 19 source modules must conform to this schema.",
  "type": "object",
  "required": ["id", "name", "category", "script_family", "token_count", "tokens", "triadic", "meta"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique snake_case identifier for the language module."
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name of the language or symbol system."
    },
    "category": {
      "type": "string",
      "enum": ["natural", "symbolic", "programming"],
      "description": "Top-level category of the language."
    },
    "subcategory": {
      "type": "string",
      "description": "More granular classification (spoken, ancient_script, formal_notation, systems, query_language, etc.)."
    },
    "script_family": {
      "type": "string",
      "description": "Writing system or script family (e.g. Latin, Devanagari, Sinographic, Runic, etc.)."
    },
    "paradigm": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Programming paradigms (only for programming category)."
    },
    "token_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of tokens in the module's token list."
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["token", "gloss"],
        "properties": {
          "token": {"type": "string", "description": "The token/symbol/word in its native script."},
          "gloss": {"type": "string", "description": "English gloss / definition."},
          "romanization": {"type": "string", "description": "Romanized form (for non-Latin scripts)."},
          "frequency_rank": {"type": "integer", "description": "Frequency rank in natural language corpora."},
          "type": {"type": "string", "description": "Token type (keyword, operator, phonogram, logogram, etc.)."},
          "domain": {"type": "string", "description": "Mathematical domain (for math symbols)."},
          "latex": {"type": "string", "description": "LaTeX encoding (for math symbols)."},
          "radical_no": {"type": "integer", "description": "Kangxi radical number (for kanji radicals)."},
          "strokes": {"type": "integer", "description": "Stroke count (for kanji radicals)."},
          "example_kanji": {"type": "string", "description": "Example kanji using this radical."},
          "name": {"type": "string", "description": "Rune name (for runic systems)."},
          "transliteration": {"type": "string", "description": "Phonetic transliteration (for runes)."},
          "aett": {"type": "integer", "description": "Runic aett number (1–3)."},
          "position": {"type": "integer", "description": "Position within aett."},
          "gardiner": {"type": "string", "description": "Gardiner Sign List reference (for hieroglyphs)."}
        }
      }
    },
    "triadic": {
      "type": "object",
      "required": ["axis_1_phonemic", "axis_2_lexical", "axis_3_structural", "composite"],
      "description": "Triadic score for each axis (0–10 scale) and the composite average.",
      "properties": {
        "axis_1_phonemic": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Phonemic Complexity: sound system richness, tone, prosody, consonant/vowel inventory."
        },
        "axis_2_lexical": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Lexical Density: semantic richness, polysemy, compounding, morphological depth."
        },
        "axis_3_structural": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Structural Complexity: grammar rules, case systems, word order rigidity, agreement."
        },
        "composite": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Composite triadic score = (axis_1 + axis_2 + axis_3) / 3, rounded to 1 decimal."
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["source_tab"],
      "description": "Metadata about the language, its origin, and dataset provenance.",
      "properties": {
        "native_speakers": {"type": "string"},
        "origin_family": {"type": "string"},
        "writing_system": {"type": "string"},
        "source_tab": {"type": "string"},
        "notes": {"type": "string"},
        "version": {"type": "string"},
        "created": {"type": "string"},
        "creator": {"type": "string"},
        "typing": {"type": "string"},
        "standard": {"type": "string"},
        "period": {"type": "string"},
        "total_kangxi_radicals": {"type": "integer"},
        "gardiner_reference": {"type": "string"}
      }
    }
  }
}
