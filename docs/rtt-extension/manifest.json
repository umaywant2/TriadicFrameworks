{
  "manifest_version": 3,
  "name": "RTT‑Inside Extension (Beta)",
  "version": "0.1.0",
  "description": "Lightweight RTT structural awareness for browser pages.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RTT‑Inside"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}

