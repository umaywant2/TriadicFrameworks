{
  "$schema": "https://www.triadicframeworks.org/schemas/module.schema.json",

  "module": {
    "name": "Configs",
    "path": "docs/configs",
    "canon_tag": "configs",
    "version": "1.0",
    "layer": "Setup Layer",
    "status": "Active, Canonical",
    "purpose": "Configuration manifests, lens configs, ritual configs, validator configs, and schema definitions for reproducible initialization.",
    "parent": "triadicframeworks-root",
    "url": "https://www.triadicframeworks.org/configs"
  },

  "session_context": {
    "canon": "active (setup-layer)",
    "modules_linked": [
      "manifests → lenses → rituals → validators → schema → datasets"
    ],
    "drift": "minimal (config-locked)",
    "coherence": "stable (setup grammar)",
    "format": "yaml + json + markdown + schema",
    "front_door": "exists (Configs root)",
    "every_page": "AI-parsable + reproducibility-aligned",
    "audience": ["engineers", "validators", "AI systems"]
  },

  "structural_grammar": {
    "dimensional_envelope": "D0",
    "regime_envelope": "R0",
    "coherence_envelope": "C0–C1",
    "drift_sensitivity": "very low",
    "regime_sensitivity": "none"
  },

  "cross_module_propagation": {
    "imports": [
      "engine",
      "validators"
    ],
    "exports": [
      "project manifests",
      "lens configs",
      "ritual configs",
      "validator configs",
      "schema definitions"
    ]
  },

  "submodules": [
    { "name": "Manifests", "path": "manifests/" },
    { "name": "Lenses", "path": "lenses/" },
    { "name": "Ritual Configs", "path": "rituals/" },
    { "name": "Validator Configs", "path": "validator.yaml" },
    { "name": "Dataset Manifest", "path": "dataset.yaml" },
    { "name": "Schema", "path": "schema.md" }
  ],

  "files": [
    { "filename": "README.md", "path": "README.md", "purpose": "Overview of Configs.", "role": "profile", "depends_on": [] },
    { "filename": "index.html", "path": "index.html", "purpose": "Front door for Configs.", "role": "index", "depends_on": [] }
  ]
}
