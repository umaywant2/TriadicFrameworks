    ],
    "every_page_stands_alone": true
  },

  "session_context": {
    "canon": "TriadicFrameworks",
    "module": "Research/Structural_Assisted_Intelligence",
    "category": "Research-Kernel",
    "version": "SAI/0.1",
    "header": "rtt=1 | coherence=declared | drift=bounded | paradox=structural",
    "coherence": "declared",
    "drift": "bounded",
    "paradox": "structural",
