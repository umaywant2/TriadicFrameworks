{
  "project": "RTT_UE6_Integration",
  "version": "1.0",
  "description": "Complete AI‑reconstructable manifest for the RTT × UE6 integration.",
  "status": "active",

  "structure": {
    "root": "/RTT",
    "folders": [
      "/RTT/Core",
      "/RTT/Examples",
      "/RTT/Materials",
      "/RTT/UI",
      "/RTT/Maps",
      "/RTT/Scripts",
      "/RTT/Schemas"
    ]
  },

  "blueprints": {
    "BP_RTT_Primitives": "RTT_Primitives.json",
    "BP_RTT_ResonanceDemo": "BP_RTT_ResonanceDemo.json",
    "BP_RTT_EntropyDemo": "BP_RTT_EntropyDemo.json",
    "BP_RTT_HybridDemo": "BP_RTT_HybridDemo.json"
  },

  "materials": {
    "M_RTT_ResonanceHeatmap": {
      "path": "/RTT/Materials/M_RTT_ResonanceHeatmap",
      "manifest": "material_resonance.json"
    },
    "M_RTT_EntropyField": {
      "path": "/RTT/Materials/M_RTT_EntropyField",
      "manifest": "material_entropy.json"
    }
  },

  "widgets": {
    "WBP_RTT_Timeline": "widget_timeline.json",
    "WBP_RTT_OperatorPanel": "widget_operator_panel.json"
  },

  "editor_tools": {
    "RTTTools.py": "tool_rtttools.json",
    "RTT_ResonanceVisualizer.py": "tool_resonance_visualizer.json",
    "RTT_EntropyInspector.py": "tool_entropy_inspector.json",
    "RTT_OperatorTimeline.py": "tool_operator_timeline.json",
    "RTT_MenuExtension.py": "tool_menu_extension.json"
  },

  "maps": {
    "RTT_Showcase": "RTT_Showcase.json"
  },

  "schemas": {
    "blueprint_schema": "ue6_blueprint.schema.json",
    "project_schema": "ue6_project.schema.json"
  },

  "operator_alignment": {
    "phi": ["BP_RTT_Primitives"],
    "variance": ["BP_RTT_Primitives"],
    "resonance": ["BP_RTT_Primitives", "BP_RTT_ResonanceDemo", "BP_RTT_HybridDemo"],
    "entropy": ["BP_RTT_Primitives", "BP_RTT_EntropyDemo", "BP_RTT_HybridDemo"],
    "hybrid": ["BP_RTT_HybridDemo"]
  },

  "cross_module_propagation": "ue6_cross_module_propagation.json",

  "reconstruction_instructions": {
    "step_1": "Create UE6 project with folder structure defined in structure.folders.",
    "step_2": "Rebuild Blueprints using manifests in blueprints.*",
    "step_3": "Rebuild materials using materials.* manifests.",
    "step_4": "Rebuild widgets using widgets.* manifests.",
    "step_5": "Install editor tools from editor_tools.* manifests.",
    "step_6": "Recreate RTT_Showcase map using maps.RTT_Showcase manifest.",
    "step_7": "Validate all assets using schemas.blueprint_schema.",
    "step_8": "Verify operator alignment and cross‑module propagation."
  }
}
