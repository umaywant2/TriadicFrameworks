{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE6 Blueprint Manifest Schema",
  "description": "Schema for RTT × UE6 Blueprint manifests.",
  "type": "object",

  "required": ["asset_name", "asset_type", "parent_class", "path", "components", "event_graph", "status"],

  "properties": {
    "asset_name": { "type": "string" },
    "asset_type": { "type": "string", "enum": ["BlueprintClass"] },
    "parent_class": { "type": "string" },
    "path": { "type": "string" },

    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "role": { "type": "string" },
          "attached_to": { "type": "string" }
        }
      }
    },

    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": {},
          "category": { "type": "string" }
        }
      }
    },

    "event_graph": {
      "type": "object",
      "description": "Event → sequence of actions",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object" }
      }
    },

    "rtt_alignment": {
      "type": "object",
      "description": "Mapping of RTT operators to Blueprint functions."
    },

    "purpose": { "type": "string" },
    "status": { "type": "string" }
  }
}
