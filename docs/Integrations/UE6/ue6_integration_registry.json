{
  "module": "RTT_UE6_Integration",
  "version": "1.0",
  "category": "Integrations",
  "description": "Unified registry for all RTT × UE6 integration assets, including Blueprints, materials, widgets, editor tools, and example maps.",
  "status": "active",

  "blueprints": {
    "BP_RTT_Primitives": {
      "path": "/RTT/Core/BP_RTT_Primitives",
      "manifest": "RTT_Primitives.json",
      "operators": ["phi", "variance", "resonance", "entropy"]
    },
    "BP_RTT_ResonanceDemo": {
      "path": "/RTT/Examples/BP_RTT_ResonanceDemo",
      "manifest": "BP_RTT_ResonanceDemo.json",
      "operators": ["resonance"]
    },
    "BP_RTT_EntropyDemo": {
      "path": "/RTT/Examples/BP_RTT_EntropyDemo",
      "manifest": "BP_RTT_EntropyDemo.json",
      "operators": ["entropy"]
    },
    "BP_RTT_HybridDemo": {
      "path": "/RTT/Examples/BP_RTT_HybridDemo",
      "manifest": "BP_RTT_HybridDemo.json",
      "operators": ["resonance", "entropy", "hybrid"]
    }
  },

  "materials": {
    "M_RTT_ResonanceHeatmap": {
      "path": "/RTT/Materials/M_RTT_ResonanceHeatmap",
      "type": "Material",
      "parameters": ["ResonanceAmplitude", "ResonanceFrequency", "ResonancePhase"],
      "purpose": "Visualize resonance amplitude, frequency, and phase."
    },
    "M_RTT_EntropyField": {
      "path": "/RTT/Materials/M_RTT_EntropyField",
      "type": "Material",
      "parameters": ["EntropyIntensity", "EntropyRadius", "EntropyCenter"],
      "purpose": "Visualize entropy gradients and collapse signatures."
    }
  },

  "widgets": {
    "WBP_RTT_Timeline": {
      "path": "/RTT/UI/WBP_RTT_Timeline",
      "type": "UserWidget",
      "purpose": "Editor/runtime operator timeline visualization."
    },
    "WBP_RTT_OperatorPanel": {
      "path": "/RTT/UI/WBP_RTT_OperatorPanel",
      "type": "UserWidget",
      "purpose": "Runtime operator inspector for φ–V–R–Entropy."
    }
  },

  "editor_tools": {
    "RTTTools.py": {
      "path": "/Scripts/RTTTools.py",
      "purpose": "Entry point for all RTT editor utilities."
    },
    "RTT_ResonanceVisualizer.py": {
      "path": "/Scripts/RTT_ResonanceVisualizer.py",
      "purpose": "Editor resonance field visualization."
    },
    "RTT_EntropyInspector.py": {
      "path": "/Scripts/RTT_EntropyInspector.py",
      "purpose": "Editor entropy boundary visualization."
    },
    "RTT_OperatorTimeline.py": {
      "path": "/Scripts/RTT_OperatorTimeline.py",
      "purpose": "Operator timeline debugger."
    },
    "RTT_MenuExtension.py": {
      "path": "/Scripts/RTT_MenuExtension.py",
      "purpose": "Adds RTT Tools menu to UE6 toolbar."
    }
  },

  "maps": {
    "RTT_Showcase": {
      "path": "/RTT/Maps/RTT_Showcase",
      "manifest": "RTT_Showcase.json",
      "areas": [
        { "name": "PhiVarianceArea", "actors": ["BP_RTT_Primitives"] },
        { "name": "ResonanceArea", "actors": ["BP_RTT_ResonanceDemo"] },
        { "name": "EntropyArea", "actors": ["BP_RTT_EntropyDemo"] },
        { "name": "HybridArea", "actors": ["BP_RTT_HybridDemo"] }
      ],
      "ui": ["WBP_RTT_OperatorPanel"]
    }
  },

  "operator_alignment": {
    "phi": ["BP_RTT_Primitives"],
    "variance": ["BP_RTT_Primitives"],
    "resonance": ["BP_RTT_Primitives", "BP_RTT_ResonanceDemo", "BP_RTT_HybridDemo"],
    "entropy": ["BP_RTT_Primitives", "BP_RTT_EntropyDemo", "BP_RTT_HybridDemo"],
    "hybrid": ["BP_RTT_HybridDemo"]
  },

  "integration_surface": {
    "c++": ["URTTComponent", "FRTTResonanceFrame", "FRTTEntropySignature"],
    "blueprint": ["BP_RTT_Primitives", "BP_RTT_ResonanceDemo", "BP_RTT_EntropyDemo", "BP_RTT_HybridDemo"],
    "materials": ["M_RTT_ResonanceHeatmap", "M_RTT_EntropyField"],
    "editor": ["RTTTools", "RTT_ResonanceVisualizer", "RTT_EntropyInspector", "RTT_OperatorTimeline", "RTT_MenuExtension"],
    "ui": ["WBP_RTT_Timeline", "WBP_RTT_OperatorPanel"],
    "maps": ["RTT_Showcase"]
  }
}
