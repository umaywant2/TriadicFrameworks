{
  "asset_name": "BP_RTT_EntropyDemo",
  "asset_type": "BlueprintClass",
  "parent_class": "Actor",
  "path": "/RTT/Examples/BP_RTT_EntropyDemo",

  "components": [
    { "name": "DefaultSceneRoot", "type": "SceneComponent", "role": "root" },
    { "name": "RTTComponent", "type": "URTTComponent", "role": "operator_binding", "attached_to": "DefaultSceneRoot" },
    { "name": "EntropySphere", "type": "StaticMeshComponent", "role": "entropy_visual", "attached_to": "DefaultSceneRoot" }
  ],

  "variables": [
    { "name": "EntropyScale", "type": "float", "default": 1.0, "category": "RTT" }
  ],

  "event_graph": {
    "BeginPlay": [
      {
        "action": "CreateDynamicMaterialInstance",
        "target": "EntropySphere",
        "material": "M_RTT_EntropyField",
        "store_as": "EntropyMID"
      }
    ],
    "Tick": [
      {
        "call": "RTT_TraceEntropy",
        "target": "RTTComponent",
        "store_as": "EntropySignature"
      },
      {
        "set_material_params": {
          "material": "EntropyMID",
          "params": {
            "EntropyIntensity": "EntropySignature.Intensity",
            "EntropyRadius": "EntropySignature.Radius * EntropyScale",
            "EntropyCenter": "EntropySignature.Location"
          }
        }
      }
    ]
  },

  "rtt_alignment": {
    "entropy": "RTT_TraceEntropy"
  },

  "purpose": "Visual demonstration of entropy gradients and collapse signatures using a dynamic material.",
  "status": "active"
}
