{
  "template": {
    "module": {
      "name": "<MODULE_NAME>",
      "category": "<CATEGORY>",
      "summary": "<ONE_SENTENCE_SUMMARY>",
      "purpose": "<ONE_PARAGRAPH_PURPOSE>",
      "version": "1.0.0",
      "keywords": ["<KW1>", "<KW2>", "<KW3>"],
      "audience": "<TARGET_AUDIENCE>"
    },

    "roles": {
      "engine": "Defines the module’s core logic.",
      "profile": "Describes the module’s conceptual structure.",
      "signature": "Defines the module’s operator or schema signature.",
      "diagnostic": "Diagnostic or classification tools.",
      "map": "Maps relationships or examples.",
      "example": "Worked examples.",
      "extension": "Future expansion points.",
      "index": "README.md overview.",
      "reference": "Reference materials.",
      "template": "Contributor templates."
    },

    "analyzer_layer": {
      "operator": ["<OPERATOR_1>", "<OPERATOR_2>"],
      "dimensional": ["macro-scale", "micro-scale"],
      "regime": ["<REGIME_1>", "<REGIME_2>"],
      "drift": ["<DRIFT_1>", "<DRIFT_2>"],
      "coherence": ["module-consistency"],
      "cross-cutting": ["workflow"]
    },

    "files": {
      "README": "README.md",
      "capture": "d_Capture.md",
      "classify": "d_Classify.md",
      "operators": "d_Operators.md",
      "examples": "d_Examples.md",
      "paper": "d_Paper.md",
      "source": "d_Source.md"
    },

    "ai": {
      "module": "<MODULE_NAME>",
      "version": "1.0.0",
      "purpose": "AI-ready metadata for module discovery.",
      "navigation": "sitemap_main.xml",
      "discussions": "https://github.com/umaywant2/TriadicFrameworks/discussions",
      "contact": {
        "x": "@TriadicFrameworks",
        "youtube": "@TriadicFrameworks"
      },
      "license": "Open educational use permitted"
    },

    "citation": {
      "author": "<AUTHOR_NAME>",
      "publication_date": "<YEAR>",
      "title": "<MODULE_TITLE>",
      "subject": "<SUBJECT>"
    }
  }
}
