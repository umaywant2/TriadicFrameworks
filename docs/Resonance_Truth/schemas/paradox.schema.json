{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/Resonance_Truth/schemas/paradox.schema.json",
  "title": "RTT Resonance Truth Paradox",
  "description": "Schema for an unresolved structural Paradox identified by the RTT Resonance Truth Service v0.1 model. A Paradox represents qualified incompatibility that remains after relevant Truth Class, Regime, scope, freshness, Lineage, domain semantics, and ordinary disagreement have been considered. Difference, multiplicity, dissent, fragmentation, or uncertainty alone do not constitute Paradox.",
  "type": "object",

  "required": [
    "paradox_id",
    "evaluation_id",
    "paradox_type",
    "status",
    "competing_state_references",
    "containment",
    "rationale"
  ],

  "properties": {
    "paradox_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this Paradox record."
    },

    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the Evaluation in which this Paradox was identified, preserved, or reevaluated."
    },

    "claim_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional identifier of the Claim to which this Paradox applies."
    },

    "regime_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional identifier of the governing Regime under which the competing states remain incompatible."
    },

    "truth_classes": {
      "type": "array",
      "description": "Truth Classes participating in the unresolved incompatibility.",
      "items": {
        "type": "string",
        "enum": [
          "temporal",
          "locational",
          "identity",
          "integrity",
          "authority",
          "state",
          "transactional",
          "intent",
          "observational",
          "lineage"
        ]
      },
      "uniqueItems": true,
      "default": []
    },

    "paradox_type": {
      "type": "string",
      "enum": [
        "structural",
        "regime",
        "lineage",
        "authority",
        "temporal",
        "semantic",
        "state",
        "transactional",
        "intent",
        "observational",
        "other"
      ],
      "description": "Primary structural classification of the unresolved incompatibility."
    },

    "status": {
      "type": "string",
      "enum": [
        "active",
        "contained",
        "deferred",
        "resolved"
      ],
      "description": "Lifecycle state of the Paradox record. Resolution does not erase the historical Paradox."
    },

    "competing_state_references": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "description": "Identifiers of the competing qualified states, clusters, Evidence structures, Lineage graphs, assertions, or other operational structures participating in the Paradox.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "supporting_evidence_references": {
      "type": "array",
      "description": "Identifiers of Evidence supporting the presence and characterization of the Paradox.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },

    "excluded_explanations": {
      "type": "array",
      "description": "Ordinary explanations evaluated and found insufficient to eliminate the apparent incompatibility. This field helps demonstrate that the system characterized the disagreement before classifying Paradox.",
      "items": {
        "type": "string",
        "enum": [
          "different_truth_class",
          "different_regime",
          "different_scope",
          "valid_multiplicity",
          "stale_evidence",
          "expired_evidence",
          "local_state_lag",
          "materialization_lag",
          "sampling_difference",
          "observer_difference",
          "lineage_dependency",
          "incomplete_evidence",
          "evidence_gap",
          "lineage_gap",
          "policy_precedence",
          "different_epoch",
          "different_version",
          "domain_specific_compatibility"
        ]
      },
      "uniqueItems": true,
      "default": []
    },

    "containment": {
      "type": "string",
      "enum": [
        "preserve",
        "quarantine",
        "dual_state",
        "defer",
        "escalate",
        "resolved"
      ],
      "description": "How the unresolved incompatibility is operationally contained. Containment does not itself decide which competing state is correct."
    },

    "accepted_value_permitted": {
      "type": "boolean",
      "description": "Indicates whether the governing Regime permits synthesis of an accepted domain value while this Paradox remains active."
    },

    "resolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/paradox_resolution"
        }
      ],
      "description": "Resolution information when the Paradox has been resolved. Historical competing states remain referenceable."
    },

    "rationale": {
      "type": "array",
      "minItems": 1,
      "description": "Structured reasons explaining why the condition qualifies as Paradox rather than ordinary difference, dissent, multiplicity, Drift, or insufficient Evidence.",
      "items": {
        "$ref": "#/$defs/decision_reason"
      }
    },

    "detected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp at which the Paradox was identified."
    },

    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp at which the Paradox was resolved, when applicable."
    },

    "metadata": {
      "type": "object",
      "description": "Optional domain-specific or implementation metadata. Metadata must not override canonical Paradox fields.",
      "additionalProperties": true,
      "default": {}
    }
  },

  "$defs": {
    "paradox_resolution": {
      "type": "object",
      "required": [
        "resolution_type",
        "description"
      ],
      "properties": {
        "resolution_type": {
          "type": "string",
          "enum": [
            "new_evidence",
            "regime_separation",
            "scope_separation",
            "lineage_resolution",
            "authority_resolution",
            "staleness_resolution",
            "policy_resolution",
            "domain_semantics",
            "manual_resolution",
            "other"
          ],
          "description": "Primary mechanism by which the previously unresolved incompatibility became resolved."
        },

        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation of the Paradox resolution."
        },

        "selected_state_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional identifier of the state or structure selected after resolution. Null is valid when resolution separates Regimes or determines that multiple states are legitimately compatible."
        },

        "evidence_references": {
          "type": "array",
          "description": "Identifiers of new or reevaluated Evidence participating in resolution.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },

        "evaluation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional identifier of a later Evaluation that resolved the Paradox."
        }
      },
      "additionalProperties": false
    },

    "decision_reason": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Stable machine-readable reason code."
        },

        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation of the Paradox classification."
        },

        "evidence_references": {
          "type": "array",
          "description": "Identifiers of competing states, clusters, Evidence, Lineage objects, Regimes, or other structures relevant to this reason.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },

        "regime_rule": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional governing Regime rule relevant to the Paradox classification."
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false,

  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolution",
          "resolved_at"
        ],
        "properties": {
          "resolution": {
            "type": "object"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          },
          "containment": {
            "const": "resolved"
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "contained",
              "deferred"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "null"
          },
          "resolved_at": {
            "type": "null"
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "containment": {
            "const": "dual_state"
          }
        },
        "required": [
          "containment"
        ]
      },
      "then": {
        "properties": {
          "accepted_value_permitted": {
            "const": false
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "containment": {
            "const": "quarantine"
          }
        },
        "required": [
          "containment"
        ]
      },
      "then": {
        "properties": {
          "accepted_value_permitted": {
            "const": false
          }
        }
      }
    }
  ],

  "examples": [
    {
      "paradox_id": "paradox-ntp-fragmented-001",
      "evaluation_id": "evaluation-ntp-fragmented-001",
      "claim_id": "claim-temporal-fragmented-001",
      "regime_id": "regime-display-clock",
      "truth_classes": [
        "temporal"
      ],
      "paradox_type": "structural",
      "status": "active",
      "competing_state_references": [
        "cluster-temporal-a",
        "cluster-temporal-b"
      ],
      "supporting_evidence_references": [
        "obs-ntp-a-001",
        "obs-ntp-b-001",
        "obs-ntp-c-001",
        "obs-ntp-d-001"
      ],
      "excluded_explanations": [
        "different_truth_class",
        "different_regime",
        "different_scope",
        "valid_multiplicity",
        "stale_evidence",
        "expired_evidence",
        "different_epoch"
      ],
      "containment": "dual_state",
      "accepted_value_permitted": false,
      "resolution": null,
      "rationale": [
        {
          "code": "UNRESOLVED_COMPETING_TEMPORAL_CLUSTERS",
          "message": "Two independently supported and internally coherent temporal clusters remain mutually incompatible within the same declared Regime, and the Evaluation provides no justified basis for selecting either cluster as authoritative.",
          "evidence_references": [
            "cluster-temporal-a",
            "cluster-temporal-b"
          ],
          "regime_rule": "no-preference-without-structural-basis"
        }
      ],
      "detected_at": "2026-01-01T12:00:01Z",
      "resolved_at": null,
      "metadata": {
        "synthetic": true
      }
    },

    {
      "paradox_id": "paradox-lineage-example-001",
      "evaluation_id": "evaluation-lineage-example-001",
      "claim_id": "claim-lineage-example-001",
      "regime_id": "regime-provenance-example",
      "truth_classes": [
        "lineage"
      ],
      "paradox_type": "lineage",
      "status": "contained",
      "competing_state_references": [
        "lineage-claim-a",
        "lineage-claim-b"
      ],
      "supporting_evidence_references": [
        "attestation-a",
        "attestation-b"
      ],
      "excluded_explanations": [
        "different_regime",
        "different_scope",
        "different_version",
        "lineage_gap",
        "domain_specific_compatibility"
      ],
      "containment": "quarantine",
      "accepted_value_permitted": false,
      "resolution": null,
      "rationale": [
        {
          "code": "INCOMPATIBLE_QUALIFIED_LINEAGE",
          "message": "Two qualified provenance structures assert mutually exclusive origins for the same artifact under the same evaluated Regime.",
          "evidence_references": [
            "lineage-claim-a",
            "lineage-claim-b",
            "attestation-a",
            "attestation-b"
          ],
          "regime_rule": null
        }
      ],
      "detected_at": "2026-01-01T12:00:00Z",
      "resolved_at": null,
      "metadata": {
        "example_only": true
      }
    },

    {
      "paradox_id": "paradox-resolved-example-001",
      "evaluation_id": "evaluation-example-001",
      "claim_id": "claim-example-001",
      "regime_id": "regime-example-001",
      "truth_classes": [
        "state"
      ],
      "paradox_type": "regime",
      "status": "resolved",
      "competing_state_references": [
        "state-view-a",
        "state-view-b"
      ],
      "supporting_evidence_references": [
        "evidence-a",
        "evidence-b",
        "evidence-c"
      ],
      "excluded_explanations": [],
      "containment": "resolved",
      "accepted_value_permitted": true,
      "resolution": {
        "resolution_type": "regime_separation",
        "description": "The previously incompatible state views were shown to belong to distinct operational Regimes and therefore no longer constitute structural contradiction.",
        "selected_state_reference": null,
        "evidence_references": [
          "evidence-c"
        ],
        "evaluation_id": "evaluation-example-002"
      },
      "rationale": [
        {
          "code": "APPARENT_PARADOX_RESOLVED_BY_REGIME",
          "message": "A later Evaluation established that the competing state views apply under distinct Regimes.",
          "evidence_references": [
            "state-view-a",
            "state-view-b",
            "evidence-c"
          ],
          "regime_rule": null
        }
      ],
      "detected_at": "2026-01-01T12:00:00Z",
      "resolved_at": "2026-01-01T12:05:00Z",
      "metadata": {
        "example_only": true
      }
    }
  ]
}
