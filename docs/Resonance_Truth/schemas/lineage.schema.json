{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/Resonance_Truth/schemas/lineage.schema.json",
  "title": "RTT Resonance Truth Lineage",
  "description": "Schema for Lineage relationships used by the RTT Resonance Truth Service v0.1 model. Lineage preserves origin, dependency, delegation, derivation, transformation, transition, and related structural paths through which Claims, observations, Sources, and Truth States acquire operational context. Lineage is graph-capable and must not be interpreted as proof of correctness by itself.",
  "type": "object",

  "required": [
    "lineage_id",
    "nodes",
    "edges",
    "status"
  ],

  "properties": {
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this Lineage graph or bounded Lineage subgraph."
    },

    "subject_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional identifier of the primary object, Claim, Evidence item, artifact, Truth State, or other subject whose Lineage is represented."
    },

    "claim_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional identifier of the Claim for which this Lineage structure is relevant."
    },

    "regime_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional identifier of the Regime under which this Lineage is being interpreted."
    },

    "nodes": {
      "type": "array",
      "description": "Objects participating in the Lineage graph.",
      "items": {
        "$ref": "#/$defs/lineage_node"
      }
    },

    "edges": {
      "type": "array",
      "description": "Directed relationships among Lineage nodes.",
      "items": {
        "$ref": "#/$defs/lineage_edge"
      }
    },

    "root_node_ids": {
      "type": "array",
      "description": "Identifiers of nodes treated as origins or roots within this bounded Lineage graph. Multiple roots are permitted.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },

    "terminal_node_ids": {
      "type": "array",
      "description": "Identifiers of nodes treated as terminal or downstream objects within this bounded Lineage graph. Multiple terminal nodes are permitted.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },

    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "gapped",
        "contested",
        "cyclic",
        "indeterminate"
      ],
      "description": "Structural status of the bounded Lineage representation. This status describes Lineage structure and is not a Truth-State qualification."
    },

    "independence": {
      "type": "string",
      "enum": [
        "independent",
        "partially_dependent",
        "dependent",
        "unknown",
        "not_applicable"
      ],
      "description": "Optional summary classification of structural independence within the Lineage graph. Independence should be derived from relationships where possible rather than inferred from identifier count alone.",
      "default": "unknown"
    },

    "distance": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Optional derived Lineage distance for domains where a meaningful scalar distance exists. Null is valid when graph structure cannot honestly be represented by one scalar."
    },

    "gaps": {
      "type": "array",
      "description": "Known gaps in the Lineage representation. A gap represents missing or unavailable structure and must not be interpreted automatically as qualified absence.",
      "items": {
        "$ref": "#/$defs/lineage_gap"
      },
      "default": []
    },

    "rationale": {
      "type": "array",
      "description": "Structured reasons explaining notable Lineage classifications, limitations, gaps, or independence findings.",
      "items": {
        "$ref": "#/$defs/decision_reason"
      },
      "default": []
    },

    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp at which this Lineage record was created, when serialized independently."
    },

    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp of the most recent Lineage-record update, when applicable."
    },

    "metadata": {
      "type": "object",
      "description": "Optional domain-specific or implementation metadata. Metadata must not override canonical Lineage fields.",
      "additionalProperties": true,
      "default": {}
    }
  },

  "$defs": {
    "lineage_node": {
      "type": "object",

      "required": [
        "node_id",
        "entity_type"
      ],

      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for this node inside the Lineage graph."
        },

        "entity_type": {
          "type": "string",
          "enum": [
            "claim",
            "observation",
            "source",
            "anchor",
            "regime",
            "evaluation",
            "truth_state",
            "coherence_state",
            "drift_state",
            "paradox",
            "correction_policy",
            "artifact",
            "transaction",
            "transition",
            "materialization",
            "other"
          ],
          "description": "Canonical or domain-relevant type of entity represented by the node."
        },

        "entity_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Identifier of the external or canonical object represented by this node. Null is permitted when the graph contains an otherwise meaningful unresolved or synthetic node."
        },

        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional human-readable node label."
        },

        "status": {
          "type": "string",
          "enum": [
            "known",
            "derived",
            "unknown",
            "missing",
            "contested"
          ],
          "default": "known",
          "description": "Structural knowledge status of this Lineage node."
        },

        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Optional time associated with observation or availability of this node."
        },

        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Optional beginning of the node's relevant validity interval."
        },

        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Optional end of the node's relevant validity interval."
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },

      "additionalProperties": false
    },

    "lineage_edge": {
      "type": "object",

      "required": [
        "edge_id",
        "from_node_id",
        "to_node_id",
        "relation"
      ],

      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for this Lineage relationship."
        },

        "from_node_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the upstream or relationship-source node."
        },

        "to_node_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the downstream or relationship-target node."
        },

        "relation": {
          "type": "string",
          "minLength": 1,
          "description": "Directional Lineage relationship. Examples include derives_from, delegated_by, transformed_from, depends_on, observed_by, produced_by, precedes, committed_as, materialized_as, supersedes, compensates, reconstructs_from, drifted_from, reconciles_toward, or another domain-defined relation."
        },

        "transformation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional transformation applied across this relationship."
        },

        "regime_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional Regime under which this relationship is meaningful."
        },

        "status": {
          "type": "string",
          "enum": [
            "known",
            "qualified",
            "degraded",
            "contested",
            "unknown"
          ],
          "default": "known",
          "description": "Structural status of the relationship. Edge qualification does not automatically follow from node qualification."
        },

        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Optional beginning of the relationship's validity interval."
        },

        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Optional end of the relationship's validity interval."
        },

        "constraints": {
          "type": "array",
          "description": "Optional constraints limiting the meaning, scope, authority, or use of this Lineage relationship.",
          "items": {
            "$ref": "#/$defs/lineage_constraint"
          },
          "default": []
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },

      "additionalProperties": false
    },

    "lineage_constraint": {
      "type": "object",

      "required": [
        "constraint_type",
        "description"
      ],

      "properties": {
        "constraint_type": {
          "type": "string",
          "minLength": 1,
          "description": "Domain-specific classification of the relationship constraint."
        },

        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the constraint."
        },

        "value": {
          "description": "Optional domain-native value associated with this relationship constraint."
        }
      },

      "additionalProperties": false
    },

    "lineage_gap": {
      "type": "object",

      "required": [
        "gap_id",
        "gap_type",
        "description"
      ],

      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for the known Lineage gap."
        },

        "gap_type": {
          "type": "string",
          "enum": [
            "origin",
            "dependency",
            "transformation",
            "authority",
            "relationship",
            "temporal",
            "coverage",
            "unknown"
          ],
          "description": "Classification of the missing or unavailable Lineage structure."
        },

        "from_node_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional known node preceding the gap."
        },

        "to_node_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional known node following the gap."
        },

        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of what Lineage information is missing."
        },

        "impact": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "material",
            "blocking",
            "unknown"
          ],
          "default": "unknown",
          "description": "Known impact of this Lineage gap on qualification."
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },

      "additionalProperties": false
    },

    "decision_reason": {
      "type": "object",

      "required": [
        "code",
        "message"
      ],

      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Stable machine-readable reason code."
        },

        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation of the Lineage decision or limitation."
        },

        "evidence_references": {
          "type": "array",
          "description": "Identifiers of Lineage nodes, edges, Sources, Evidence, Claims, Truth States, or related structures supporting this reason.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },

        "regime_rule": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional governing Regime rule relevant to the Lineage assessment."
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false,

  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "gapped"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gaps": {
            "minItems": 1
          }
        },
        "required": [
          "gaps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ],

