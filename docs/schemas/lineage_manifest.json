{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lineage Manifest",
  "type": "object",
  "properties": {
    "artifact_id": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "ancestors": { "type": "array", "items": { "type": "string" } },
    "remix_history": { "type": "array", "items": { "type": "string" } },
    "attestation_refs": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["artifact_id", "authors"]
}
