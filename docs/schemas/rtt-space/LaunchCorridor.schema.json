{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-space/v1/LaunchCorridor.schema.json",
  "title": "LaunchCorridor",
  "type": "object",
  "required": ["corridor_id", "type", "volume_km", "time_window"],
  "properties": {
    "corridor_id": { "type": "string" },
    "type": { "type": "string", "enum": ["launch", "reentry"] },

    "volume_km": {
      "type": "object",
      "properties": {
        "min": { "type": "array", "items": { "type": "number" } },
        "max": { "type": "array", "items": { "type": "number" } }
      }
    },

    "time_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

