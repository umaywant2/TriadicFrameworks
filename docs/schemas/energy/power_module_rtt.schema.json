{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "RTT Power Module",
  "type": "object",
  "properties": {
    "module_id": { "type": "string" },
    "voltage": { "type": "number" },
    "current": { "type": "number" },
    "capacity_wh": { "type": "number" },
    "triadic_profile": {
      "type": "object",
      "properties": {
        "spin_field": { "type": "number" },
        "charge_field": { "type": "number" },
        "temperature_field": { "type": "number" }
      }
    }
  }
}
