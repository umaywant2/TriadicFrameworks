{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-deepsea/v1/DeepSeaNodeDescriptorExtension.schema.json",
  "title": "DeepSeaNodeDescriptorExtension",
  "type": "object",
  "properties": {
    "node_role": {
      "type": "string",
      "enum": ["submersible", "fixed-beacon", "drifting-sensor", "habitat-module"],
      "description": "Deep-sea node role (RTT node type)."
    },
    "hull_class": {
      "type": "string",
      "description": "Pressure rating or certification of the submersible hull."
    },
    "sensor_suite": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Installed sensors (pressure, sonar, salinity, etc.)."
    }
  }
}

