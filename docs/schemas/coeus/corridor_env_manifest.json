{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Corridor Environment Manifest",
  "type": "object",
  "properties": {
    "corridor": { "type": "string", "enum": ["dev", "test", "qa", "prod"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "entropy_budget": { "type": "number" },
    "promotion_rules": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["corridor", "constraints"]
}
