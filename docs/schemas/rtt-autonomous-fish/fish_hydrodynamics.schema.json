{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous-fish/v1/fish_hydrodynamics.schema.json",
  "title": "fish_hydrodynamics",
  "type": "object",
  "required": ["form_id"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "drag_coefficient": {
      "type": "number",
      "description": "Hydrodynamic drag coefficient."
    },

    "max_swim_speed_m_s": {
      "type": "number",
      "description": "Maximum sustained swim speed."
    },

    "turn_rate_deg_s": {
      "type": "number",
      "description": "Maximum turning rate in degrees per second."
    },

    "fin_efficiency": {
      "type": "number",
      "description": "Efficiency of fin actuation (0–1)."
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

