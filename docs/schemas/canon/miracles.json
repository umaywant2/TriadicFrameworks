{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Miracle Registry",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "event_id": { "type": "string", "description": "Unique identifier for the miracle event" },
      "timestamp": { "type": "string", "format": "date-time" },
      "partition": { "type": "string", "description": "Partition reference (rUPS/rQPS/rPPS)" },
      "message_type": { "type": "string", "enum": ["prayer", "miracle", "signal"] },
      "description": { "type": "string", "description": "Plain-language description of the miracle" },
      "overlap_ref": { "type": "string", "description": "Reference to overlaps.json entry" },
      "attestation_ref": { "type": ["string","null"], "description": "Optional attestation receipt" }
    },
    "required": ["event_id","timestamp","partition","message_type","description"]
  }
}
