{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/docs/schemas/rtt-atc/ATCOverlayViewModel.schema.json",
  "title": "RTT-ATC Overlay View Model",
  "description": "View model for RTT-aware ATC overlays: tracks, sectors, corridors, alerts, and resonance-time context.",
  "type": "object",
  "required": ["timestamp", "viewport", "tracks", "overlays"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Client-side render timestamp (ISO 8601)."
    },
    "rtt_tick": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional RTT tick index if bound to a simulation or replay."
    },
    "viewport": {
      "type": "object",
      "description": "Current map/corridor viewport.",
      "required": ["center", "zoom", "projection"],
      "properties": {
        "center": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "zoom": {
          "type": "number",
          "minimum": 0
        },
        "projection": {
          "type": "string",
          "enum": ["EPSG:4326", "EPSG:3857"],
          "description": "Map projection used by the client."
        }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "array",
      "description": "Aircraft tracks currently rendered in the overlay.",
      "items": {
        "type": "object",
        "required": ["id", "callsign", "position", "velocity", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique track identifier (system or RTT ID)."
          },
          "callsign": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "required": ["lat", "lon", "altitude"],
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "altitude": {
                "type": "number",
                "description": "Altitude in feet."
              }
            }
          },
          "velocity": {
            "type": "object",
            "required": ["groundspeed", "heading"],
            "properties": {
              "groundspeed": {
                "type": "number",
                "description": "Speed in knots."
              },
              "heading": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              }
            }
          },
          "sector_id": {
            "type": "string",
            "description": "Current controlling sector identifier."
          },
          "corridor_id": {
            "type": "string",
            "description": "Optional RTT corridor identifier if bound to a resonance corridor."
          },
          "status": {
            "type": "string",
            "enum": ["normal", "conflict", "handoff_pending", "restricted", "unknown"]
          },
          "resonance_score": {
            "type": "number",
            "description": "Optional RTT-derived stability/resonance score for this track."
          }
        },
        "additionalProperties": false
      }
    },
    "overlays": {
      "type": "object",
      "description": "Overlay layers toggled in the ATC view.",
      "properties": {
        "sectors": {
          "type": "array",
          "description": "Rendered ATC sectors.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "active": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "corridors": {
          "type": "array",
          "description": "RTT corridors visible in the overlay.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "active": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "weather_cells": {
          "type": "array",
          "description": "Weather overlays relevant to ATC decisions.",
          "items": {
            "type": "object",
            "required": ["id", "severity"],
            "properties": {
              "id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["light", "moderate", "severe"]
              },
              "polygon": {
                "type": "array",
                "description": "Optional polygon boundary as [lat, lon] pairs.",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "array",
      "description": "Current alerts visible in the overlay.",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity", "message"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["conflict", "loss_of_separation", "handoff", "system", "rtt_corridor"]
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "track_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tracks involved in this alert, if applicable."
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "filters": {
      "type": "object",
      "description": "Current filter state applied by the controller.",
      "properties": {
        "sector_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "show_conflicts_only": {
          "type": "boolean",
          "default": false
        },
        "min_altitude": {
          "type": "number"
        },
        "max_altitude": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "user_preferences": {
      "type": "object",
      "description": "Optional user-specific overlay preferences.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

