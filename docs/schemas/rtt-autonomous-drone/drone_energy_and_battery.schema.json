{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rtt-autonomous-drone/v1/drone_energy_and_battery.schema.json",
  "title": "drone_energy_and_battery",
  "type": "object",
  "required": ["form_id"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },

    "battery_capacity_wh": {
      "type": "number",
      "description": "Total battery capacity in watt-hours."
    },

    "battery_health_percent": {
      "type": "number",
      "description": "Remaining battery health (0–100%)."
    },

    "average_power_draw_w": {
      "type": "number",
      "description": "Typical power draw during cruise."
    },

    "peak_power_draw_w": {
      "type": "number",
      "description": "Maximum power draw during aggressive maneuvers."
    },

    "thermal_limits_c": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

