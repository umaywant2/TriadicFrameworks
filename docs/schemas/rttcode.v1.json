{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/docs/schemas/rttcode.v1.json",
  "title": "RTTcode v1.0",
  "description": "Canonical payload schema for RTT-Inside integrations.",
  "type": "object",
  "required": ["rtt_version", "tick", "entities", "environment", "intent"],
  "properties": {
    "rtt_version": {
      "type": "string",
      "const": "1.0"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "object",
            "required": ["position", "velocity", "resonance"],
            "properties": {
              "position": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "velocity": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "resonance": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "environment": {
      "type": "object",
      "required": ["field_strength", "phase_noise"],
      "properties": {
        "field_strength": { "type": "number" },
        "phase_noise": { "type": "number" },
        "coupling_radius": { "type": "number" }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "string",
      "enum": ["advance", "query", "debug"]
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for debugging, tracing, or experiment tagging.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
