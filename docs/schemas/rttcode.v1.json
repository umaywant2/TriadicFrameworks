{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/rttcode.v1.json",
  "title": "RTTcode v1.0",
  "description": "Canonical payload schema for RTT-Inside integrations.",
  "type": "object",
  "required": ["rtt_version", "tick", "entities", "environment", "intent"],
  "properties": {
    "rtt_version": {
      "type": "string",
      "const": "1.0"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "object",
            "required": ["position", "velocity", "resonance"],
            "properties": {
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "velocity": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "resonance": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "environment": {
      "type": "object",
      "required": ["field_strength", "phase_noise"],
      "properties": {
        "field_strength": {
          "type": "number"
        },
        "phase_noise": {
          "type": "number"
        },
        "coupling_radius": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "string",
      "enum": ["advance", "query", "debug"]
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for debugging, tracing, or experiment tagging.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
{
  "experiment": {
    "type": "object",
    "description": "Experiment metadata for reproducibility and lineage.",
    "required": ["experiment_id"],
    "properties": {
      "experiment_id": {
        "type": "string",
        "description": "Globally unique experiment identifier (UUID recommended)."
      },
      "seed": {
        "type": "integer",
        "description": "Deterministic seed for resonance-time evolution.",
        "minimum": 0
      },
      "trial": {
        "type": "integer",
        "description": "Optional trial index for repeated runs.",
        "minimum": 0
      },
      "tags": {
        "type": "array",
        "description": "Arbitrary labels for grouping or filtering.",
        "items": { "type": "string" }
      },
      "provenance": {
        "type": "object",
        "description": "Optional metadata describing the source of this packet.",
        "properties": {
          "engine": { "type": "string" },
          "engine_version": { "type": "string" },
          "user": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  }
}
