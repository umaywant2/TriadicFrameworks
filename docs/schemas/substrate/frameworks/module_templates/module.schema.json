{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriadicFrameworks Module Schema",
  "type": "object",

  "properties": {
    "module": { "type": "string" },
    "identity": { "type": "string" },
    "purpose": { "type": "string" },

    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "engine",
              "profile",
              "signature",
              "diagnostic",
              "map",
              "example",
              "extension",
              "index",
              "reference",
              "template"
            ]
          }
        },
        "required": ["name", "role"]
      }
    },

    "operators": {
      "type": ["array", "object"]
    },

    "dimensions": {
      "type": ["array", "object"]
    },

    "regimes": {
      "type": ["array", "object"]
    },

    "layers": {
      "type": ["array", "object"]
    },

    "maps": { "type": "array" },
    "signatures": { "type": "array" },
    "diagnostics": { "type": "array" },
    "extensions": { "type": "array" },
    "examples": { "type": "array" },
    "references": { "type": "array" },
    "templates": { "type": "array" },

    "continuity": {
      "type": "object",
      "properties": {
        "structural": { "type": "object" },
        "behavioral": { "type": "object" },
        "temporal": { "type": "object" },
        "atlas": { "type": "object" },
        "activation": { "type": "object" }
      }
    },

    "invariance": {
      "type": "object",
      "properties": {
        "structural": { "type": "object" },
        "behavioral": { "type": "object" },
        "temporal": { "type": "object" },
        "atlas": { "type": "object" },
        "activation": { "type": "object" }
      }
    },

    "epoch": {
      "type": "object",
      "properties": {
        "timeline": { "type": "object" },
        "transitions": { "type": "object" },
        "propagation": { "type": "object" },
        "resonance": { "type": "object" },
        "ignition": { "type": "object" }
      }
    },

    "ignition": {
      "type": "object",
      "properties": {
        "waves": { "type": "object" },
        "cascades": { "type": "object" },
        "harmonics": { "type": "object" },
        "triggers": { "type": "object" },
        "stabilization": { "type": "object" }
      }
    },

    "execution": {
      "type": "object",
      "properties": {
        "evaluation": { "type": "object" },
        "update_cycles": { "type": "object" },
        "runtime_hooks": { "type": "object" },
        "synchronization": { "type": "object" }
      }
    },

    "monitor": {
      "type": "object",
      "properties": {
        "telemetry": { "type": "object" },
        "anomalies": { "type": "object" },
        "cycle_reports": { "type": "object" },
        "hooks": { "type": "object" }
      }
    },

    "runtime_constellation": {
      "type": "object",
      "properties": {
        "execution": { "type": "object" },
        "synchronization": { "type": "object" },
        "continuity": { "type": "object" },
        "resonance_stabilizer": { "type": "object" },
        "propagation": { "type": "object" },
        "coupling_regulator": { "type": "object" },
        "invariance": { "type": "object" },
        "monitor": { "type": "object" }
      }
    },

    "runtime_hooks": {
      "type": "object",
      "properties": {
        "execution": { "type": "object" },
        "atlas": { "type": "object" },
        "epoch": { "type": "object" },
        "coupling": { "type": "object" },
        "invariance": { "type": "object" },
        "monitor": { "type": "object" }
      }
    },

    "output": {
      "type": "object"
    },

    "meta": {
      "type": "object"
    }
  },

  "required": ["module", "identity", "purpose"]
}

