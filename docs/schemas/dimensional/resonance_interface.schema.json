{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Resonance Interface",
  "type": "object",
  "properties": {
    "interface_id": { "type": "string" },
    "source_dimension": { "type": "string" },
    "target_dimension": { "type": "string" },
    "allowed_operators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "triadic_constraints": { "type": "object" }
  },
  "required": ["interface_id", "source_dimension", "target_dimension"]
}
