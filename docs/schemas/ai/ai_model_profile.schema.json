{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "AI Model Profile",
  "type": "object",
  "properties": {
    "model_id": { "type": "string" },
    "architecture": { "type": "string" },
    "version": { "type": "string" },
    "training_corpus": { "type": "string" },
    "triadic_anchor": {
      "type": "object",
      "properties": {
        "spin_anchor": { "type": "number" },
        "charge_anchor": { "type": "number" },
        "temperature_anchor": { "type": "number" }
      }
    }
  }
}
