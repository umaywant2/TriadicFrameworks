{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://triadicframeworks.org/schemas/rsadi/gd/v1/GDZoneState.schema.json",
  "title": "GDZoneState",
  "type": "object",
  "required": [
    "zone_id",
    "timestamp",
    "clarity_score",
    "stress_hint",
    "risk_level"
  ],
  "properties": {
    "zone_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "clarity_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stress_hint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "risk_level": {
      "$ref": "GDRiskLevel.schema.json"
    },
    "drift_vector": {
      "$ref": "GDDriftVector.schema.json"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
