{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Rotating Disk Simulation\n",
    "### SET Resonance Substrate Model\n",
    "\n",
    "This notebook simulates a rotating conducting disk inside a resonance substrate field using the baseline SET field equations.\n",
    "\n",
    "Objectives:\n",
    "- initialize a rotating Spin field\n",
    "- evolve SET fields using the substrate solver\n",
    "- visualize Charge, Temperature, and Spin evolution\n",
    "- compute an EMF‑analogous signal\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from simulations.core.substrate_solver import (\n",
    "    Grid, SubstrateParams, SubstrateState, step\n",
    ")\n",
    "from docs.resonance_substrate_model.tools.visualization.field_plotter import (\n",
    "    plot_spin, plot_charge, plot_temperature\n",
    ")\n",
    "from docs.resonance_substrate_model.tools.visualization.triadic_space_mapper import (\n",
    "    visualize_triadic_state\n",
    ")\n",
    "from docs.resonance_substrate_model.tools.visualization.envelope_viewer import (\n",
    "    visualize_envelope\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Simulation Parameters\n",
    "Define grid, time step, and substrate parameters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "nx, ny = 128, 128\n",
    "dx = dy = 1.0\n",
    "\n",
    "grid = Grid(nx=nx, ny=ny, dx=dx, dy=dy)\n",
    "\n",
    "params = SubstrateParams(\n",
    "    D_S=1.0, D_C=1.0, D_T=1.0,\n",
    "    gamma_S=0.05, gamma_C=0.05, gamma_T=0.05,\n",
    "    lambda_SC=1.0, lambda_ST=0.5,\n",
    "    beta_CS=0.8,\n",
    "    eta_S=0.1, eta_C=0.1,\n",
    "    T0=0.0\n",
    ")\n",
    "\n",
    "dt = 0.01\n",
    "steps = 2000"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Initialize Rotating Disk\n",
    "Spin field encodes solid‑body rotation.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "state = SubstrateState(grid)\n",
    "\n",
    "x = np.linspace(-1, 1, nx)\n",
    "y = np.linspace(-1, 1, ny)\n",
    "X, Y = np.meshgrid(x, y, indexing=\"ij\")\n",
    "\n",
    "omega = 5.0\n",
    "\n",
    "state.S[..., 0] = -omega * Y\n",
    "state.S[..., 1] =  omega * X\n",
    "state.S[..., 2] = 0.0\n",
    "\n",
    "state.C[:, :] = 0.0\n",
    "state.T[:, :] = 0.0\n",
    "\n",
    "plot_spin(state.S, title=\"Initial Spin Field (Rotating Disk)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Run Simulation\n",
    "Store snapshots for visualization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "snapshots = []\n",
    "snapshot_interval = 200\n",
    "\n",
    "for i in range(steps):\n",
    "    step(state, params, dt)\n",
    "    if i % snapshot_interval == 0:\n",
    "        snapshots.append((i, state.C.copy(), state.T.copy(), state.S.copy()))\n",
    "        print(f\"Step {i}/{steps}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Charge Field Evolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, len(snapshots), figsize=(4*len(snapshots), 4))\n",
    "\n",
    "for ax, (i, C, _, _) in zip(axes, snapshots):\n",
    "    im = ax.imshow(C.T, origin='lower', cmap='RdBu')\n",
    "    ax.set_title(f\"Step {i}\")\n",
    "    plt.colorbar(im, ax=ax)\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Temperature Field Evolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, len(snapshots), figsize=(4*len(snapshots), 4))\n",
    "\n",
    "for ax, (i, _, T, _) in zip(axes, snapshots):\n",
    "    im = ax.imshow(T.T, origin='lower', cmap='inferno')\n",
    "    ax.set_title(f\"Step {i}\")\n",
    "    plt.colorbar(im, ax=ax)\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Triadic Overlay Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "visualize_triadic_state(state, grid, prefix=\"Final State\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Resonance Envelope Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "visualize_envelope(state.S, state.C, state.T, alpha=1.0, theta=0.1, dx=grid.dx, dy=grid.dy)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## EMF‑Analog Signal\n",
    "Defined as:\n",
    "\

\[ \\text{EMF}(t) = \\int |\\nabla C| \\, dA \\]

"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def emf_like(C, grid):\n",
    "    grad = np.gradient(C, grid.dx, grid.dy)\n",
    "    mag = np.sqrt(grad[0]**2 + grad[1]**2)\n",
    "    return np.sum(mag)\n",
    "\n",
    "state2 = SubstrateState(grid)\n",
    "state2.S[..., 0] = -omega * Y\n",
    "state2.S[..., 1] =  omega * X\n",
    "\n",
    "emf_values = []\n",
    "\n",
    "for i in range(steps):\n",
    "    step(state2, params, dt)\n",
    "    emf_values.append(emf_like(state2.C, grid))\n",
    "\n",
    "plt.plot(emf_values)\n",
    "plt.title(\"EMF‑Analog vs Time\")\n",
    "plt.xlabel(\"Step\")\n",
    "plt.ylabel(\"EMF‑Analog\")\n",
    "plt.show()"
   ]
  }
 ],
