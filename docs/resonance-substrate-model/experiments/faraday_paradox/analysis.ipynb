"""
Faraday Paradox — Raw Data Loader
This script loads raw CSV files and metadata for analysis.
"""

import json
import pandas as pd
from pathlib import Path

# Paths
DATA_DIR = Path("raw_data")
METADATA_FILE = DATA_DIR / "metadata.json"

# Load metadata
with open(METADATA_FILE, "r") as f:
    metadata = json.load(f)

# Helper: load a single run
def load_run(run_id):
    """
    Load a single experimental run by ID.
    Returns a pandas DataFrame.
    """
    run_info = next(r for r in metadata["runs"] if r["id"] == run_id)
    csv_path = DATA_DIR / run_info["file"]
    df = pd.read_csv(csv_path)
    df["run_id"] = run_id
    return df

# Load all runs into a single DataFrame
def load_all_runs():
    frames = [load_run(r["id"]) for r in metadata["runs"]]
    return pd.concat(frames, ignore_index=True)

# Example usage
all_data = load_all_runs()
all_data.head()
