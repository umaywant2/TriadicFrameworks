{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lab Schema",
  "description": "Defines laboratory environments, equipment, safety constraints, and operational conditions for experiments within the Resonance Substrate Model (RSM). Supports physical and simulated lab contexts.",

  "type": "object",

  "properties": {
    "environment": {
      "type": "object",
      "description": "Defines the physical or simulated lab environment.",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "Ambient temperature in degrees Celsius."
        },
        "humidity": {
          "type": "number",
          "description": "Relative humidity percentage."
        },
        "pressure": {
          "type": "number",
          "description": "Ambient pressure in kPa."
        },
        "conditions": {
          "type": "object",
          "description": "Additional environmental conditions.",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },

    "equipment": {
      "type": "array",
      "description": "List of lab equipment used in the experiment.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "specs": {
            "type": "object",
            "description": "Equipment specifications.",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          },
          "calibration_required": {
            "type": "boolean",
            "description": "Whether calibration is required before use."
          }
        },
        "required": ["id", "name", "type"]
      }
    },

    "protocols": {
      "type": "array",
      "description": "Standard operating procedures or experiment-specific protocols.",
      "items": {
        "type": "string",
        "description": "A single protocol step or instruction."
      }
    },

    "safety": {
      "type": "object",
      "description": "Safety requirements and hazard classifications.",
      "properties": {
        "hazards": {
          "type": "array",
          "description": "List of potential hazards.",
          "items": { "type": "string" }
        },
        "protective_equipment": {
          "type": "array",
          "description": "Required protective equipment (PPE).",
          "items": { "type": "string" }
        },
        "emergency_procedures": {
          "type": "array",
          "description": "Steps to follow in case of emergency.",
          "items": { "type": "string" }
        }
      }
    },

    "access_control": {
      "type": "object",
      "description": "Defines who can access the lab or equipment.",
      "properties": {
        "roles_allowed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authorization_required": {
          "type": "boolean"
        }
      }
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },

  "required": ["equipment"]
}
