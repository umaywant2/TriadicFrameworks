{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coeus Schema",
  "description": "Semantic, symbolic, and cognitive-layer primitives for the Resonance Substrate Model (RSM). Defines identity constructs, semantic nodes, symbolic resonance structures, and meaning-alignment entities used across simulations, experiments, and higher-layer TriadicFrameworks modules.",

  "type": "object",

  "properties": {
    "identity": {
      "type": "object",
      "description": "Defines an entity's symbolic identity within the semantic layer.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the semantic entity."
        },
        "label": {
          "type": "string",
          "description": "Human-readable label or name."
        },
        "archetype": {
          "type": "string",
          "description": "Optional archetypal or mythic classification."
        }
      },
      "required": ["id", "label"]
    },

    "semantic_node": {
      "type": "object",
      "description": "A node representing meaning, symbolic structure, or conceptual resonance.",
      "properties": {
        "concept": {
          "type": "string",
          "description": "The core concept represented by this node."
        },
        "attributes": {
          "type": "object",
          "description": "Key-value attributes describing semantic properties.",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "links": {
          "type": "array",
          "description": "Connections to other semantic nodes.",
          "items": {
            "type": "string",
            "description": "ID of another semantic node."
          }
        }
      },
      "required": ["concept"]
    },

    "symbolic_resonance": {
      "type": "object",
      "description": "Represents resonance patterns within the semantic layer.",
      "properties": {
        "amplitude": {
          "type": "number",
          "description": "Strength of symbolic resonance."
        },
        "phase": {
          "type": "number",
          "description": "Phase alignment of the symbolic structure."
        },
        "coherence": {
          "type": "number",
          "description": "Degree of semantic coherence (0–1).",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["amplitude", "coherence"]
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version identifier."
        },
        "notes": {
          "type": "string",
          "description": "Freeform notes or comments."
        }
      }
    }
  },

  "required": ["identity", "semantic_node", "symbolic_resonance"]
}
