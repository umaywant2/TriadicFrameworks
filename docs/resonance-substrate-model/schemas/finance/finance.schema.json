{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finance Schema",
  "description": "Defines resource flow, value exchange, credit/debt structures, and ledger coherence for the Resonance Substrate Model (RSM). Supports distributed agents, substrate transactions, and resonance-aligned economic modeling.",

  "type": "object",

  "properties": {
    "resource": {
      "type": "object",
      "description": "A quantifiable resource tracked within the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the resource type."
        },
        "label": {
          "type": "string",
          "description": "Human-readable name for the resource."
        },
        "quantity": {
          "type": "number",
          "description": "Amount of the resource available."
        },
        "units": {
          "type": "string",
          "description": "Optional unit label (e.g., tokens, credits, arbitrary units)."
        }
      },
      "required": ["id", "quantity"]
    },

    "transaction": {
      "type": "object",
      "description": "Represents a transfer or transformation of resources.",
      "properties": {
        "from": {
          "type": "string",
          "description": "Source agent or entity ID."
        },
        "to": {
          "type": "string",
          "description": "Destination agent or entity ID."
        },
        "resource_id": {
          "type": "string",
          "description": "ID of the resource being transferred."
        },
        "amount": {
          "type": "number",
          "description": "Amount of resource transferred."
        },
        "timestamp": {
          "type": "string",
          "description": "Optional timestamp for ordering or replay."
        },
        "metadata": {
          "type": "object",
          "description": "Optional transaction metadata.",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      },
      "required": ["from", "to", "resource_id", "amount"]
    },

    "ledger": {
      "type": "object",
      "description": "A coherent record of transactions and resource states.",
      "properties": {
        "entries": {
          "type": "array",
          "description": "List of transaction entries.",
          "items": { "$ref": "#/properties/transaction" }
        },
        "coherence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Degree of ledger consistency and reconciliation (0–1)."
        }
      }
    },

    "credit": {
      "type": "object",
      "description": "Represents credit, debt, or obligation relationships.",
      "properties": {
        "holder": {
          "type": "string",
          "description": "Entity holding the credit."
        },
        "issuer": {
          "type": "string",
          "description": "Entity issuing the credit or debt."
        },
        "amount": {
          "type": "number",
          "description": "Value of the credit or debt."
        },
        "interest_rate": {
          "type": "number",
          "description": "Optional interest or growth factor."
        },
        "maturity": {
          "type": "string",
          "description": "Optional maturity date or condition."
        }
      },
      "required": ["holder", "issuer", "amount"]
    },

    "exchange_rate": {
      "type": "object",
      "description": "Defines conversion ratios between resource types.",
      "properties": {
        "from_resource": {
          "type": "string",
          "description": "Resource ID being converted from."
        },
        "to_resource": {
          "type": "string",
          "description": "Resource ID being converted to."
        },
        "rate": {
          "type": "number",
          "description": "Conversion rate multiplier."
        }
      },
      "required": ["from_resource", "to_resource", "rate"]
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version identifier."
        },
        "notes": {
          "type": "string",
          "description": "Freeform notes or comments."
        }
      }
    }
  },

  "required": ["resource", "transaction"]
}
