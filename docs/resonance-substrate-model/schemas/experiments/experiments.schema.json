{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiments Schema",
  "description": "Defines apparatus, measurement constructs, calibration parameters, and replication metadata for experiments validating the Resonance Substrate Model (RSM). Supports rotating-conductor tests, resonance-alignment apparatus, coherence metrics, and reproducible experimental workflows.",

  "type": "object",

  "properties": {
    "apparatus": {
      "type": "object",
      "description": "Defines the physical or simulated apparatus used in an experiment.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Apparatus identifier or descriptive name."
        },
        "components": {
          "type": "array",
          "description": "List of components making up the apparatus.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "specs": {
                "type": "object",
                "description": "Component specifications.",
                "additionalProperties": {
                  "type": ["string", "number", "boolean"]
                }
              }
            },
            "required": ["id", "type"]
          }
        },
        "configuration": {
          "type": "object",
          "description": "Configuration parameters for the apparatus.",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "object", "array"]
          }
        }
      },
      "required": ["name"]
    },

    "measurement": {
      "type": "object",
      "description": "Defines measurement types, units, and sampling behavior.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["coherence", "alignment", "rotation", "field_strength", "custom"],
          "description": "Type of measurement being recorded."
        },
        "units": {
          "type": "string",
          "description": "Measurement units (e.g., Hz, radians, arbitrary units)."
        },
        "sampling_rate": {
          "type": "number",
          "description": "Sampling rate in samples per second."
        },
        "precision": {
          "type": "number",
          "description": "Measurement precision or resolution."
        }
      },
      "required": ["type"]
    },

    "calibration": {
      "type": "object",
      "description": "Calibration parameters and reference values.",
      "properties": {
        "method": {
          "type": "string",
          "description": "Calibration method or protocol."
        },
        "reference_values": {
          "type": "object",
          "description": "Reference values used for calibration.",
          "additionalProperties": { "type": "number" }
        },
        "tolerance": {
          "type": "number",
          "description": "Allowed deviation from reference values."
        }
      }
    },

    "procedure": {
      "type": "array",
      "description": "Step-by-step experimental procedure.",
      "items": {
        "type": "string",
        "description": "A single procedural step."
      }
    },

    "data": {
      "type": "object",
      "description": "Metadata describing collected data.",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["csv", "json", "binary", "custom"],
          "description": "Data storage format."
        },
        "fields": {
          "type": "array",
          "description": "Names of data fields recorded.",
          "items": { "type": "string" }
        },
        "sampling_window": {
          "type": "number",
          "description": "Duration of data collection."
        }
      }
    },

    "replication": {
      "type": "object",
      "description": "Information required for reproducibility.",
      "properties": {
        "environment": {
          "type": "object",
          "description": "Environmental conditions (temperature, humidity, etc.).",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "initial_conditions": {
          "type": "object",
          "description": "Initial state of the system before the experiment.",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "object", "array"]
          }
        },
        "notes": {
          "type": "string",
          "description": "Freeform replication notes."
        }
      }
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version identifier."
        },
        "experiment_type": {
          "type": "string",
          "description": "Category of experiment (e.g., rotating-conductor, resonance-alignment)."
        },
        "notes": {
          "type": "string",
          "description": "Freeform notes or comments."
        }
      }
    }
  },

  "required": ["apparatus", "measurement"]
}
