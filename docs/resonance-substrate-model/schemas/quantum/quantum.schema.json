{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quantum Schema",
  "description": "Defines quantum-layer constructs for the Resonance Substrate Model (RSM), including the 0D–2D Quantum Triad Model: point-states (0D), spin/phase lines (1D), and coherence sheets (2D). Supports quantum resonance, phase evolution, entanglement, and substrate coupling.",

  "type": "object",

  "properties": {
    "point_state_0d": {
      "type": "object",
      "description": "0D quantum point-state representing a localized quantum value with no spatial extent.",
      "properties": {
        "value": {
          "type": "number",
          "description": "Quantum amplitude or probability weight."
        },
        "phase": {
          "type": "number",
          "description": "Phase angle in radians."
        },
        "spin": {
          "type": "string",
          "enum": ["up", "down", "neutral", "custom"],
          "description": "Optional spin label."
        }
      },
      "required": ["value", "phase"]
    },

    "spin_line_1d": {
      "type": "object",
      "description": "1D quantum line representing spin, phase, or amplitude variation along a single dimension.",
      "properties": {
        "samples": {
          "type": "array",
          "description": "Ordered samples along the 1D quantum line.",
          "items": {
            "type": "object",
            "properties": {
              "position": { "type": "number" },
              "amplitude": { "type": "number" },
              "phase": { "type": "number" }
            },
            "required": ["position", "amplitude"]
          }
        },
        "boundary_conditions": {
          "type": "string",
          "enum": ["open", "periodic", "reflective"],
          "description": "Boundary behavior for the 1D quantum line."
        }
      },
      "required": ["samples"]
    },

    "coherence_sheet_2d": {
      "type": "object",
      "description": "2D quantum coherence sheet representing distributed phase, amplitude, and entanglement patterns.",
      "properties": {
        "grid_size": {
          "type": "array",
          "description": "Dimensions of the 2D coherence grid.",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "amplitude_map": {
          "type": "array",
          "description": "2D array of amplitude values.",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "phase_map": {
          "type": "array",
          "description": "2D array of phase values.",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "coherence_map": {
          "type": "array",
          "description": "2D array of coherence values (0–1).",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": ["grid_size", "amplitude_map"]
    },

    "entanglement": {
      "type": "object",
      "description": "Defines entanglement relationships between quantum entities.",
      "properties": {
        "pairs": {
          "type": "array",
          "description": "List of entangled pairs.",
          "items": {
            "type": "object",
            "properties": {
              "entity_a": { "type": "string" },
              "entity_b": { "type": "string" },
              "strength": {
                "type": "number",
                "description": "Entanglement strength (0–1).",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["entity_a", "entity_b"]
          }
        }
      }
    },

    "quantum_coupling": {
      "type": "object",
      "description": "Coupling between quantum-layer constructs and substrate fields.",
      "properties": {
        "scalar_coupling": {
          "type": "number",
          "description": "Coupling strength to scalar field."
        },
        "vector_coupling": {
          "type": "number",
          "description": "Coupling strength to vector/spin field."
        },
        "resonance_coupling": {
          "type": "number",
          "description": "Coupling strength to resonance envelope."
        }
      }
    },

    "metadata": {
      "type": "object",
      "description": "Optional metadata for documentation, provenance, or schema evolution.",
      "version": "1.0.0",
      "notes": "Initial seed release",
      "properties": {
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },

  "required": ["point_state_0d", "spin_line_1d", "coherence_sheet_2d"]
}
