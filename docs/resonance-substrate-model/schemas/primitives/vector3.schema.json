{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triadicframeworks.org/schemas/primitives/vector3.schema.json",
  "title": "Vector3",
  "description": "A 3‑component vector used throughout the Resonance Substrate Model.",
  "type": "object",
  "properties": {
    "x": {
      "type": "number",
      "description": "X‑component of the vector."
    },
    "y": {
      "type": "number",
      "description": "Y‑component of the vector."
    },
    "z": {
      "type": "number",
      "description": "Z‑component of the vector."
    }
  },
  "required": ["x", "y", "z"]
}

