{
  "$schema": "https://www.triadicframeworks.org/schemas/module.schema.json",

  "module": {
    "name": "RTT API",
    "path": "docs/api/rtt",
    "canon_tag": "rtt-api",
    "version": "1.0",
    "layer": "RTT API Layer",
    "status": "Active, Canonical",
    "purpose": "Public RTT/1 API surface: Beacon, Profile, Diagnostics, Router, Client, Server, Dimensional Echo API.",
    "parent": "rtt-engine",
    "url": "https://www.triadicframeworks.org/api/rtt"
  },

  "session_context": {
    "canon": "active (rtt-api)",
    "modules_linked": [
      "Beacon → Profile → Diagnostics → Router → Client → Server → Dimensional Echo API → Examples"
    ],
    "drift": "minimal (api-locked)",
    "coherence": "stable (api grammar)",
    "format": "html + markdown + examples",
    "front_door": "exists (RTT API root)",
    "every_page": "stands alone + API-parsable",
    "audience": ["developers", "researchers", "AI systems"]
  },

  "structural_grammar": {
    "dimensional_envelope": "D0–D2",
    "regime_envelope": "R0–R1",
    "coherence_envelope": "C0–C2",
    "drift_sensitivity": "low",
    "regime_sensitivity": "low"
  },

  "cross_module_propagation": {
    "imports": [
      "RTT/SDK",
      "RTT Micro Core"
    ],
    "exports": [
      "Beacon endpoint",
      "Profile endpoint",
      "Diagnostics endpoint",
      "Router",
      "Client",
      "Server",
      "Dimensional Echo API"
    ]
  },

  "submodules": [
    { "name": "Beacon", "path": "beacon.md" },
    { "name": "Profile", "path": "profile.md" },
    { "name": "Diagnostics", "path": "diagnostics.md" },
    { "name": "Router", "path": "router.md" },
    { "name": "Client", "path": "client.md" },
    { "name": "Server", "path": "server.md" },
    { "name": "Dimensional Echo API", "path": "dimensional_echo_api.md" },
    { "name": "Examples", "path": "examples.md" }
  ],

  "files": [
    { "filename": "README.md", "path": "README.md", "purpose": "Overview of RTT API.", "role": "profile", "depends_on": [] },
    { "filename": "index.html", "path": "index.html", "purpose": "Front door for RTT API.", "role": "index", "depends_on": [] }
  ]
}
