{
  "asset_name": "BP_RTT_Primitives",
  "asset_type": "BlueprintClass",
  "parent_class": "Actor",
  "path": "/RTT/Integrations/UE6/Blueprint/BP_RTT_Primitives",

  "components": [
    {
      "name": "DefaultSceneRoot",
      "type": "SceneComponent",
      "role": "root"
    },
    {
      "name": "RTTComponent",
      "type": "URTTComponent",
      "role": "operator_binding",
      "attached_to": "DefaultSceneRoot"
    }
  ],

  "variables": [
    {
      "name": "PhiDebugColor",
      "type": "LinearColor",
      "default": [0.2, 0.8, 1.0, 1.0],
      "category": "RTT"
    },
    {
      "name": "ResonanceDebugColor",
      "type": "LinearColor",
      "default": [1.0, 0.3, 0.6, 1.0],
      "category": "RTT"
    },
    {
      "name": "EntropyDebugColor",
      "type": "LinearColor",
      "default": [1.0, 0.1, 0.1, 1.0],
      "category": "RTT"
    },
    {
      "name": "ResonanceScale",
      "type": "float",
      "default": 1.0,
      "category": "RTT"
    },
    {
      "name": "EntropyScale",
      "type": "float",
      "default": 1.0,
      "category": "RTT"
    }
  ],

  "event_graph": {
    "EventTick": {
      "sequence": [
        {
          "call": "RTT_ApplyPhiField",
          "target": "RTTComponent",
          "inputs": {
            "Target": "RootComponent"
          }
        },
        {
          "call": "RTT_ApplyVarianceStabilizer",
          "target": "RTTComponent",
          "inputs": {
            "Target": "RootComponent"
          }
        },
        {
          "call": "RTT_ProbeResonance",
          "target": "RTTComponent",
          "store_as": "ResonanceFrame"
        },
        {
          "call": "RTT_TraceEntropy",
          "target": "RTTComponent",
          "store_as": "EntropySignature"
        },
        {
          "debug_draw": "resonance_sphere",
          "inputs": {
            "location": "GetActorLocation()",
            "radius": "50 + ResonanceFrame.Amplitude * 200 * ResonanceScale",
            "color": "ResonanceDebugColor"
          }
        },
        {
          "debug_draw": "entropy_sphere",
          "inputs": {
            "location": "EntropySignature.Location",
            "radius": "EntropySignature.Radius * EntropyScale",
            "color": "EntropyDebugColor"
          }
        }
      ]
    }
  },

  "functions": [
    {
      "name": "RTT_DebugPhi",
      "type": "pure",
      "inputs": ["Location:Vector"],
      "body": "DrawDebugSphere(Location, small_radius, PhiDebugColor)"
    },
    {
      "name": "RTT_DebugResonance",
      "type": "pure",
      "inputs": ["ResonanceFrame:FRTTResonanceFrame"],
      "body": "DrawDebugSphere(actor_location, amplitude_scaled_radius, ResonanceDebugColor)"
    },
    {
      "name": "RTT_DebugEntropy",
      "type": "pure",
      "inputs": ["EntropySignature:FRTTEntropySignature"],
      "body": "DrawDebugSphere(sig.location, sig.radius, EntropyDebugColor)"
    }
  ],

  "rtt_alignment": {
    "phi": "RTT_ApplyPhiField",
    "variance": "RTT_ApplyVarianceStabilizer",
    "resonance": "RTT_ProbeResonance",
    "entropy": "RTT_TraceEntropy"
  },

  "status": "active",
  "version": "1.0",
  "description": "Blueprint exposing RTT operator primitives (phi, variance, resonance, entropy) for UE6 real-time visualization."
}
