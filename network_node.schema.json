{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Coeus Network Node",
  "type": "object",
  "properties": {
    "node_id": { "type": "string" },
    "role": { "type": "string" },
    "public_key": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "latency_profile": { "type": "string" },
    "resonance_profile": { "type": "string" }
  },
  "required": ["node_id", "role"]
}
