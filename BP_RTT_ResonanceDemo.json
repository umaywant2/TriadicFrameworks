{
  "asset_name": "BP_RTT_ResonanceDemo",
  "asset_type": "BlueprintClass",
  "parent_class": "Actor",
  "path": "/RTT/Examples/BP_RTT_ResonanceDemo",

  "components": [
    { "name": "DefaultSceneRoot", "type": "SceneComponent", "role": "root" },
    { "name": "RTTComponent", "type": "URTTComponent", "role": "operator_binding", "attached_to": "DefaultSceneRoot" },
    { "name": "Mesh", "type": "StaticMeshComponent", "role": "visual_target", "attached_to": "DefaultSceneRoot" }
  ],

  "variables": [
    { "name": "ResonanceScale", "type": "float", "default": 1.0, "category": "RTT" },
    { "name": "ResonanceColor", "type": "LinearColor", "default": [1.0, 0.3, 0.8, 1.0], "category": "RTT" }
  ],

  "event_graph": {
    "BeginPlay": [
      {
        "action": "CreateDynamicMaterialInstance",
        "target": "Mesh",
        "material": "M_RTT_ResonanceHeatmap",
        "store_as": "ResonanceMID"
      }
    ],
    "Tick": [
      {
        "call": "RTT_ProbeResonance",
        "target": "RTTComponent",
        "store_as": "ResonanceFrame"
      },
      {
        "set_material_params": {
          "material": "ResonanceMID",
          "params": {
            "ResonanceAmplitude": "ResonanceFrame.Amplitude * ResonanceScale",
            "ResonanceFrequency": "ResonanceFrame.Frequency",
            "ResonancePhase": "ResonanceFrame.Phase"
          }
        }
      }
    ]
  },

  "rtt_alignment": {
    "resonance": "RTT_ProbeResonance"
  },

  "purpose": "Visual demonstration of resonance amplitude, frequency, and phase using a heatmap material.",
  "status": "active"
}
