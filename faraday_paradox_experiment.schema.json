{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Faraday Paradox Experiment",
  "type": "object",
  "properties": {
    "experiment_id": { "type": "string" },
    "disk_material": { "type": "string" },
    "disk_radius_m": { "type": "number" },
    "rotation_rate_rpm": { "type": "number" },
    "magnet_configuration": { "type": "string" },
    "magnet_rotation_rate_rpm": { "type": "number" },
    "magnetic_field_tesla": { "type": "number" },
    "triadic_conditions": {
      "type": "object",
      "properties": {
        "spin_bias": { "type": "number" },
        "charge_gradient": { "type": "number" },
        "temperature_profile": { "type": "number" }
      }
    },
    "measured_emf_volts": { "type": "number" }
  },
  "required": ["experiment_id", "disk_material", "rotation_rate_rpm"]
}
